---
/**
 * PinCard — a paper artifact pinned to the cork.
 * variant "typed": ruled index card, Courier Prime (card content only).
 * variant "flyer": poster stock, League Gothic headlines, uppercase.
 * variant "print": clean print-out, Atkinson Hyperlegible, tabular figures.
 * One material per artifact — never mix faces inside a card.
 */
interface Props {
	variant?: "typed" | "flyer" | "print";
	/** rotation step: -1 | 0 | 1 → ±1.2deg; alternate between neighbors */
	rotate?: -1 | 0 | 1;
	/** brass pin at the top edge; disable to pin at board level */
	pin?: boolean;
	/** element to render, e.g. "article" or "li" */
	as?: string;
	class?: string;
}

const {
	variant = "typed",
	rotate = 0,
	pin = true,
	as = "div",
	class: className
} = Astro.props;
const Tag = as;
---

<Tag
	class:list={["pin-card", `pin-card--${variant}`, "pinned", className]}
	style={`--tilt:${rotate};`}
>
	{pin && <span class="brass-pin pin-card__pin" aria-hidden="true" />}
	<slot />
</Tag>

<style>
	.pin-card {
		position: relative;
		background-color: var(--paper);
		/* the lamp falls on the sheet, not only on the wall behind it */
		background-image: var(--lamp);
		box-shadow: var(--pin-shadow);
		padding: calc(var(--baseline) * 3);
	}

	.pin-card__pin {
		position: absolute;
		top: calc(var(--baseline) * -0.75);
		left: 50%;
		translate: -50% 0;
	}

	/* typed index card: aged stock, header rule, 24px ruling the type sits ON.
	   --rule-phase is the whole point. The ruling period (24px) already
	   matched the line-height, but the band was drawn at the BOTTOM of each
	   period while a 15px/24px line puts its baseline ~7px higher — so every
	   line of type floated above its rule instead of resting on it, on every
	   card, everywhere. Measured -7.0px on body lines, -6.4px on titles.
	   A ruled card whose rules ignore its own text reads as a forgery. */
	.pin-card--typed {
		--rule-phase: 7px;
		background-color: var(--paper-aged);
		font-family: var(--font-typed);
		font-size: var(--step-0);
		line-height: calc(var(--baseline) * 3);
		padding-top: calc(var(--baseline) * 6);
		/* three layers now: the lamp rides ON TOP of the printed ruling,
		   because light falls on ink as well as on stock. The third
		   background-position value is not optional — without it the ruling
		   phase, which is the whole reason --rule-phase exists, shifts. */
		background-image:
			var(--lamp),
			linear-gradient(
				180deg,
				transparent calc(var(--baseline) * 5),
				color-mix(in oklab, var(--thread) 30%, transparent) calc(var(--baseline) * 5),
				color-mix(in oklab, var(--thread) 30%, transparent) calc(var(--baseline) * 5 + 2px),
				transparent calc(var(--baseline) * 5 + 2px)
			),
			repeating-linear-gradient(
				180deg,
				transparent 0 calc(var(--baseline) * 3 - 1px),
				color-mix(in oklab, var(--ink-blue) 20%, transparent) calc(var(--baseline) * 3 - 1px)
					calc(var(--baseline) * 3)
			);
		background-position:
			0 0,
			0 0,
			0 calc(var(--rule-phase) * -1);
	}

	/* A RESERVE FOR A RULE THAT KRAFT DOES NOT PRINT. `.pin-card--typed`
	   pads 48px (--baseline * 6) at the top so type clears the header rule
	   drawn at 40px (--baseline * 5) by the second background layer above.
	   `.pin-card--kraft` in wall.css restates `background-image` as
	   `var(--lamp-kraft)` alone — deliberately, so a typed card's blue
	   ruling cannot print onto the mid-tone stock — which takes the header
	   rule with it. The reserve then holds 48px of empty stock over a line
	   that is not there, on every kraft record on the wall.
	   24px is the card's own padding on the other three sides, so a typed
	   kraft sheet is simply padded like every other sheet.
	   (0,3,0) once scoped, against `.pin-card--typed`'s (0,2,0) — the same
	   count the wall.css kraft rule uses to beat this component's
	   background. If that rule ever stops winning, the ruling comes back and
	   this padding has to go back with it: they are one decision. */
	.pin-card--typed.pin-card--kraft {
		/* `padding-top`, not `padding-block-start`: it is the same property
		   the rule above sets, so the cascade is a plain specificity
		   comparison with no logical-vs-physical mapping in it. */
		padding-top: calc(var(--baseline) * 3);
	}

	/* every line inside a ruled card sits on the ruling: one setting, and
	   margins that are whole multiples of the period so the phase holds all
	   the way down the sheet instead of drifting */
	.pin-card--typed :global(:is(p, li, h3, h4, dt, dd)) {
		font-size: var(--step-0);
		line-height: calc(var(--baseline) * 3);
	}

	.pin-card--typed :global(:is(p, li, h3, h4, dt, dd) + :is(p, li, h3, h4, dt, dd)) {
		margin-block-start: calc(var(--baseline) * 3);
	}

	/* A TYPIST SKIPS A LINE. A caller may raise a typed heading above the
	   sheet's body step (Timeline does, for its two peak rows), and the rule
	   above then held that heading in ONE ruling period: 24px of type in 24px
	   of leading, ratio 1.000, measured -3px of overlap where it wraps. A
	   typewriter cannot set 1.000 either — it advances a whole line or two.
	   So: one period while the type fits it, two the moment it does not.
	   1.05em, not 1em, because type exactly as tall as its period has no
	   descender room. 16px -> 24, 20px -> 24, 24px -> 48.
	   MEASURED, THIS CURRENTLY CHANGES NOTHING, AND THAT IS THE POINT: no
	   heading on the wall is set at 24px on a 24px ruling any more. The one
	   that was — Timeline's peak-row title — is back at --step-1 after its
	   24px turned out to be a rounding artifact of the type-ladder
	   migration rather than a rank decision, so every typed heading now
	   resolves to one period. This declaration is the component's standing
	   statement of the rule, not a fix for any current node; the moment a
	   caller sets a typed heading above 22.9px it takes two periods instead
	   of overlapping the line above. */
	.pin-card--typed :global(:is(h3, h4)) {
		line-height: round(up, 1.05em, calc(var(--baseline) * 3));
	}

	/* flyer: poster headlines, nothing else on the sheet */
	.pin-card--flyer {
		font-family: var(--font-display);
		text-transform: uppercase;
	}

	/* tracking belongs on the heading, where it computes against the real
	   size — set on the card it resolved to 0.16px and inherited as an
	   absolute value into a 72px headline, i.e. 0.002em where 0.01em was
	   intended. Display caps need more tracking small, less large. */
	/* A CALLER'S SETTING MAY NOT HAVE TO WIN A SPECIFICITY FIGHT TO EXIST.
	   `Practice.astro` declared --step-4/--lh-4 on the house-rules flyer
	   title and the sheet computed 48px/48px — the act marquee's size — so
	   38/40 was dead CSS that read as live intent, and HOUSE RULES and
	   HOW I WORK came out as twins 140px apart.
	   VERIFIED, because the reason is not the one the specificity table
	   this build emits `.pin-card[data-astro-cid-XXXX]`
	   — a plain attribute selector at (0,1,0), with NO `:where()` wrapper
	   anywhere in the built CSS (verified by grepping dist/_astro/*.css).
	   An earlier pass claimed the opposite by running @astrojs/compiler
	   standalone, which defaults to a different `scopedStyleStrategy` than
	   the one this project ships — so it measured a compiler it does not
	   use. Component selectors therefore DO carry normal specificity here,
	   and a caller override would have worked.
	   The custom-property mechanism below is kept regardless, because
	   settling a component's setting by inheritance rather than by winning a
	   specificity race is the more durable design — but it is a choice, not
	   a necessity, and the next person should not be told otherwise.
	   which contributes ZERO specificity, so component styles carry no
	   extra weight at all and the raw selectors decide. This rule is
	   (0,1,1) — a class plus an element — against a caller's bare class at
	   (0,1,0). A single class can therefore NEVER reach a flyer heading
	   from outside; `Projects`' `.g-vrbench .bench-flyer` only lands
	   because it happens to carry two.
	   The three properties below settle it by INHERITANCE instead: a caller
	   states the setting on its heading (or on the card) and the value
	   arrives here, with no dependence on how many classes either selector
	   happens to carry or on how the compiler scopes. The fallbacks are the
	   flyer's own setting, so a caller that says nothing is unchanged. */
	.pin-card--flyer :global(:is(h1, h2, h3)) {
		margin: 0;
		font-weight: 400;
		font-size: var(--flyer-step, var(--step-5));
		line-height: var(--flyer-lh, var(--lh-5));
		letter-spacing: var(--flyer-track, var(--track-display-lg));
	}

	/* REVERSED TYPE IS TYPESET, NOT RECOLOURED. Three settings on this wall
	   were byte-identical on opposite grounds — 48px/400/0.006em, 38px and
	   24px — with zero delta in size, weight, tracking or leading between
	   the dark-stock sheet and its paper twin. Light forms on a dark ground
	   irradiate: the strokes bloom, the counters fill, the letterspacing
	   closes and the setting reads bolder and smaller than the same numbers
	   on paper. A dark artifact whose type is byte-identical to its paper
	   twin has made no decision.
	   Weight is unavailable: League Gothic ships 400 ONLY on this build —
	   verified by enumerating the loaded `FontFace` entries, because
	   `document.fonts.check()` lies here and returns true for weights that
	   are not loaded. So the compensation is TRACKING: +0.012em, i.e.
	   0.006 → 0.018em, which at 48px is +0.58px per character and widens
	   "HOW I WORK" by 5.8px. The screen-print this stock imitates spreads
	   ink physically as it is pulled, so fidelity and optics agree.
	   Keyed on `.pin-card--dark`, the caller-applied opt-in — NOT on
	   `:has(h2)`, which is the heading-level accident this cycle is
	   removing from `wall.css`. */
	.pin-card--flyer.pin-card--dark {
		--flyer-track: calc(var(--track-display-lg) + 0.012em);
	}

	/* print-out: clean white, figures align */
	.pin-card--print {
		font-family: var(--font-body);
		font-variant-numeric: tabular-nums;
	}
</style>
