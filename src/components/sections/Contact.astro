---
/**
 * Contact — the finale. The corner of the board where the case is handed over.
 *
 * This section used to be the emptiest screen on the wall (measured 10.7 %
 * ink at 1440 against 46–57 % everywhere else) at the one point where the
 * page actually asks for something. It is now built as one composition on
 * ONE axis — the left rail every other section's flyer hangs off:
 *
 *   left rail   flyer "Write to me" → the amber note → the mailto CTA
 *               (heading and address are one artifact-pair, not two
 *               strangers 700px apart)
 *   right block "Right now" (the only place the wall states what he wants)
 *               → the five channel slips → the handoff facts
 *   last row    the empty pin.
 *
 * The empty pin is the ending: a detective's board means the case is open.
 * A career wall that closes on a finished arrangement says the story is
 * over; one that closes on a pin with nothing on it says the next card
 * belongs to the person reading. The loose end of the cut thread lies
 * across it.
 *
 * THREAD CONTRACT — read this before moving anything.
 * The site's one continuous line terminates here. The run is built in
 * WallPage.astro from pin centres and its knot is solved onto the mailto
 * pin. That pin is exposed as a stable target:
 *
 *   [data-thread-terminus]            → the mailto wrapper
 *   [data-thread-terminus] .brass-pin → the pin head itself (14px)
 *
 * and the empty pin, if the run ever wants to lay its tail there itself:
 *
 *   [data-thread-loose-end]            → the empty-pin wrapper
 *   [data-thread-loose-end] .brass-pin → its pin head
 *
 * Both are on the left half of the composition at every width, and the
 * terminus is always the last `.pin-btn__pin` in `#contact`. Do not remove
 * either attribute without telling whoever owns the thread.
 */
import { Icon } from "astro-icon/components";
import HandNote from "~/components/wall/HandNote.astro";
import PinButton from "~/components/wall/PinButton.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Stamp from "~/components/wall/Stamp.astro";
import { getWall, type Locale } from "~/data/i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { contact, hero, meta, sectionStrings, ui } = getWall(locale);

const primary = contact.entries.find((entry) => entry.primary);
const channels = contact.entries.filter((entry) => !entry.primary);

/* Channel icons come from the hand-inked local set in src/icons/;
   filenames match entry ids (github, linkedin, xing, indeed, wakatime). */

/**
 * Neighbors never share a tilt: 1, -1, 1, -1 …
 *
 * It alternates rather than cycling through 0, because a slip pinned dead
 * straight has a shorter bounding box than its tilted neighbours and
 * therefore hangs a couple of pixels lower than a row it is level with.
 * Two of the five channels used to do that, and the row stopped reading
 * left to right: measured centre-to-centre, the eye went 488px, 244px,
 * 488px, 732px across five slips that are 244px apart. One tilt step for
 * every slip, and the row is a row again.
 */
const tilt = (index: number) => (index % 2 === 0 ? 1 : -1);

/* UI chrome, not record: the caption on the empty pin. It states nothing
   about the owner, so it does not belong in the frozen data files — it is
   the wall talking about itself, like the skip link or the new-tab hint.
   Green is the run ink: since when, and is it still going. */
const openPinNote = locale === "de" ? "der nächste Zettel kommt hierhin." : "the next card goes here.";

const year = new Date().getFullYear();
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
	<div class="wall-max">
		<div class="wall-grid contact-grid">
			<!-- ============ the axis: marquee → note → address ============ -->
			<div class="contact-main">
				<PinCard variant="flyer" rotate={1} class="contact-title-card">
					<h2 id="contact-heading">{contact.title}</h2>
					<svg class="contact-headrule" viewBox="0 0 150 8" aria-hidden="true">
						<path
							d="M 3 6 C 40 2 70 9 146 4"
							fill="none"
							stroke="var(--thread)"
							stroke-width="2.4"
							stroke-linecap="round"></path>
					</svg>
				</PinCard>

				<!-- The Paper Slip Rule, and the arrow goes on the slip with the
				     note. Amber reads 6.27:1 on paper; on the cork's new value it
				     is 3.33:1 as a token and 2.99:1 once the board's grain layer
				     is composited, so nothing amber may sit on bare board — not
				     even a 2.5px graphic. Written on the note, the arrow is also
				     the more honest gesture: you write the line, then draw the
				     arrow to the thing you mean. -->
				<div class="contact-annotation paper-slip pinned" style="--tilt:1;">
					<HandNote ink="amber" class="contact-annotation-note">
						{sectionStrings.contact.annotation}
					</HandNote>
					<svg
						class="contact-annotation-arrow"
						viewBox="0 0 32 40"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M6 3 C 20 8, 26 18, 22 34"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"></path>
						<path
							d="M15 29 L22 35.5 L26 26.5"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>

				{
					primary && (
						<div class="contact-mailto" data-thread-terminus>
							<PinButton href={primary.href} rotate={-1} class="contact-cta">
								{/* the wall's one structural privilege: the same hand-drawn
								    headline rule the flyers carry, run across the top of the
								    note. Structure, not a second accent colour. */}
								<svg
									class="contact-cta-rule"
									viewBox="0 0 150 8"
									preserveAspectRatio="none"
									aria-hidden="true"
								>
									<path
										d="M 3 6 C 40 2 70 9 146 4"
										fill="none"
										stroke="var(--thread)"
										stroke-width="2.5"
										stroke-linecap="round"
										vector-effect="non-scaling-stroke"
									/>
								</svg>
								<span class="contact-cta-verb">{contact.title} —</span>
								<span class="contact-cta-addr">{primary.value}</span>
							</PinButton>
						</div>
					)
				}
			</div>

			<!-- ============ what he is actually after ============ -->
			<PinCard variant="typed" rotate={-1} class="contact-now">
				<h3 class="contact-now-title">{contact.rightNow.title}</h3>
				{contact.rightNow.lines.map((line) => <p>{line}</p>)}
			</PinCard>

			<!-- ============ the channel row, full width ============ -->
			<div class="contact-channel-block">
				<ul class="contact-channels" role="list">
					{
						channels.map((entry, index) => (
							<PinCard as="li" variant="print" rotate={tilt(index)}>
								<a
									class="channel-link"
									href={entry.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<Icon name={entry.id} class="channel-icon" aria-hidden="true" />
									<span class="channel-text">
										<span class="channel-label">{entry.label}</span>
										<span class="channel-value">{entry.value}</span>
									</span>
									<span class="visually-hidden">{ui.opensNewTab}</span>
								</a>
								{/* the wall signs its own last card rather than orphaning
								    the stamp in a corner of the section */}
								{index === channels.length - 1 && (
									<Stamp
										class="contact-signoff"
										sub={`© ${year}`}
										label={meta.person.name}
										rotate={-6}
									/>
								)}
							</PinCard>
						))
					}
				</ul>

				<!-- what a recruiter's next internal step needs: the forward to a
				     hiring manager carries the location and the arrangement.
				     --ink-soft is 5.0:1 on cork but only 4.0:1 where the vignette
				     bottoms out, so it too sits on paper. -->
				<p class="contact-handoff paper-slip pinned" style="--tilt:0;">{hero.location}</p>
			</div>

			<!-- ============ the last row: a pin with nothing on it ============ -->
			<div class="contact-open">
				<span class="contact-open-pin" data-thread-loose-end aria-hidden="true">
					{/* the cut end, authored so the line crosses the pin head dead
					    centre: the pin sits at (103, 17) in this viewBox and the
					    thread runs on 25px past it before the note. */}
					<svg class="contact-loose-end" viewBox="0 0 132 34" fill="none" aria-hidden="true">
						<path
							d="M 2 8 C 22 4, 34 20, 52 22 C 72 24, 86 20, 103 17 C 112 15, 120 13, 128 9"
							stroke="var(--thread)"
							stroke-width="2.5"
							stroke-linecap="round"></path>
					</svg>
					<span class="brass-pin"></span>
				</span>
				<div class="contact-open-note paper-slip pinned" style="--tilt:1;">
					<HandNote ink="green" class="contact-open-hand">{openPinNote}</HandNote>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/* The finale was 96px/64px of padding around 10.7 % ink. Tightened to
	   64/40 — a corner of a board, not a margin. */
	.contact {
		padding-block: calc(var(--baseline) * 8) calc(var(--baseline) * 5);
	}

	.contact-grid {
		position: relative;
		row-gap: calc(var(--baseline) * 5);
	}

	/* ---- the axis ------------------------------------------------ */
	/* Flyer, annotation and address are one stack on one rail. The old
	   layout put the flyer at grid-column 2 and the address centred at
	   column 3/8 — 700px of cork between a heading and the thing it names. */

	.contact-main {
		grid-column: 1 / span 6;
		display: flex;
		flex-direction: column;
		align-items: start;
		gap: calc(var(--baseline) * 4);
	}

	/* The opening band is two artifacts wide, so it has to say which one it
	   opens with. The rail hangs one step below the availability card:
	   status, then the invitation and the address it belongs to. Left to
	   its own devices the wider card wins by 3px of rotated bounding box,
	   which is not a reading order, it is a rounding error. */
	@media (min-width: 64rem) {
		.contact-main {
			margin-block-start: calc(var(--baseline) * 2);
		}
	}

	.contact-title-card {
		align-self: start;
	}

	/* the flyer takes --step-5 from PinCard — the same step as Werdegang,
	   Projects and Telemetry. It used to be hand-set at 56px, i.e. the
	   smallest display headline on a page whose peers ran to 72. */
	.contact-headrule {
		display: block;
		width: 100%;
		height: auto;
		margin-top: calc(var(--baseline) * 0.5);
		overflow: visible;
	}

	/* The slip keeps its distance from the address card below it, because
	   the thread's knot is tied ON that card's pin and stands roughly 100px
	   proud of it. The run now arrives from the right-hand column of the
	   act above, which swings the knot up under this slip; without the
	   clearance the wall's one cut end is a straight stub behind paper. */
	.contact-annotation {
		display: flex;
		flex-direction: column;
		align-items: end;
		max-width: 24rem;
		margin-left: calc(var(--baseline) * 2);
		margin-bottom: calc(var(--baseline) * 6);
		color: var(--ink-amber);
	}

	.contact-annotation-arrow {
		flex: none;
		width: 1.75rem;
		height: auto;
		margin-right: calc(var(--baseline) * 2);
	}

	/* ---- the response device ------------------------------------- */

	.contact-mailto {
		width: 100%;
	}

	.contact-main :global(.contact-cta) {
		display: block;
		width: 100%;
		padding: calc(var(--baseline) * 3.5) calc(var(--baseline) * 3)
			calc(var(--baseline) * 3);
		text-align: left;
	}

	.contact-cta-rule {
		position: absolute;
		left: calc(var(--baseline) * 1.5);
		top: calc(var(--baseline) * 1.25);
		width: calc(100% - var(--baseline) * 3);
		height: 8px;
		overflow: visible;
	}

	/* the typewriter's one band. The verb was set a step above it, which put
	   Courier into the printed record's size class on the conversion surface;
	   rank here is carried by the address below it, which is four steps up. */
	.contact-cta-verb {
		display: block;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink-soft);
	}

	/* The address must never break mid-token — `JOBS@LARS- / DEV.ORG` is a
	   named defect elsewhere on this wall. Courier advances at exactly
	   0.6em, so 17 characters need 10.2× the step: step-4 fits its column
	   at every width down to 40rem, below which the same ladder's step-3
	   does. `anywhere` stays only as the last-resort valve under ~340px. */
	.contact-cta-addr {
		display: block;
		font-size: var(--step-4);
		line-height: var(--lh-4);
		overflow-wrap: anywhere;
	}

	/* ---- Right now: the only place the wall says what he wants ---- */

	.contact-grid > :global(.contact-now) {
		grid-column: 7 / span 6;
		align-self: start;
		width: 100%;
	}

	.contact-now-title {
		font-weight: 700;
		letter-spacing: var(--track-display);
		text-transform: uppercase;
	}

	/* ---- channel notes: five small pinned slips ------------------- */
	/* Full width, one row: the eye gets a beat that spans the wall, and
	   the five slips stop floating 300px under the address in an
	   otherwise empty field. */

	.contact-channel-block {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		align-items: start;
		/* 40px, not 20: the © stamp hangs 32px below the last slip and the
		   handoff line runs the full width once the layout stacks */
		gap: calc(var(--baseline) * 5);
	}

	.contact-channels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
		gap: calc(var(--baseline) * 2.5);
		width: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* the whole slip is the link: pull the anchor over the card padding */
	.channel-link {
		display: flex;
		align-items: center;
		gap: calc(var(--baseline) * 1.5);
		margin: calc(var(--baseline) * -3);
		padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
		min-height: 44px;
		color: var(--ink);
		font-family: var(--font-typed);
		text-decoration: none;
	}

	.channel-icon {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
	}

	.channel-text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.channel-label {
		font-weight: 700;
		font-size: var(--step-0);
		line-height: calc(var(--baseline) * 2.5);
	}

	/* the handle is typed record, so it reads at the typewriter's step; it is
	   held apart from its label by weight and by --ink-soft, not by size —
	   --step--1 is the hand's band now */
	.channel-value {
		font-size: var(--step-0);
		line-height: calc(var(--baseline) * 2.5);
		color: var(--ink-soft);
		overflow-wrap: anywhere;
	}

	/* The press-in law, and it must work for everyone. These end states
	   are deliberately OUTSIDE the reduced-motion gate: a vestibular
	   visitor asked for no travel, not for no feedback, and the conversion
	   surface previously produced a computed-style delta of exactly zero
	   on hover when the OS flag was set. Only the transition is gated.
	   Same pattern as PinButton.astro. */
	.contact-channels > :global(li:hover),
	.contact-channels > :global(li:focus-within) {
		--lift: 0.55;
		translate: 1px 2px;
	}

	.contact-channels > :global(li:active) {
		--lift: 0.35;
		translate: 1px 3px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact-channels > :global(li) {
			transition:
				box-shadow var(--t-settle) var(--e-out),
				translate var(--t-settle) var(--e-out);
		}

		.contact-channels > :global(li:active) {
			transition:
				box-shadow var(--t-press) var(--e-out),
				translate var(--t-press) var(--e-out);
		}
	}

	/* ---- sign-off: pressed onto the corner of the last card ------- */

	.contact-channels :global(.contact-signoff) {
		--stamp-size: 5.25rem;
		position: absolute;
		right: calc(var(--baseline) * -2);
		bottom: calc(var(--baseline) * -4);
		z-index: 1;
		pointer-events: none;
	}

	/* room on the last slip for the stamp that lands on its corner */
	.contact-channels > :global(li:last-child) .channel-link {
		padding-right: calc(var(--baseline) * 6);
	}

	/* ---- the handoff facts --------------------------------------- */

	.contact-handoff {
		max-width: none;
		margin: 0;
		align-self: start;
		font-family: var(--font-typed);
		font-size: var(--step-0);
		line-height: calc(var(--baseline) * 2.5);
		color: var(--ink-soft);
	}

	/* ---- the empty pin ------------------------------------------- */
	/* No card, no note on it: 14px of lit brass and its shadow on bare
	   cork, with the loose end of the cut thread lying across it. The
	   green hand note beside it is on a slip — green measures 3.65:1 on
	   the cork's value and 6.8:1 on paper. */

	.contact-open {
		grid-column: 7 / span 6;
		display: flex;
		align-items: center;
		/* 32px: the loose end runs 46px past the pin head, and it must not
		   disappear behind the note beside it */
		gap: calc(var(--baseline) * 4);
	}

	.contact-open-pin {
		position: relative;
		flex: none;
		display: flex;
		width: 14px;
		height: 14px;
		line-height: 0;
	}

	.contact-open-pin .brass-pin {
		position: relative;
		z-index: 1;
	}

	.contact-loose-end {
		position: absolute;
		left: -96px;
		top: -10px;
		width: 132px;
		height: 34px;
		overflow: visible;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---- narrower walls ------------------------------------------ */
	/* Below 64rem the two blocks stack; the axis survives because every
	   artifact keeps the same left rail. */

	@media (max-width: 63.999rem) {
		.contact-main,
		.contact-grid > :global(.contact-now) {
			grid-column: 1 / -1;
		}

		.contact-open {
			grid-column: 1 / -1;
			margin-left: calc(var(--baseline) * 11);
		}
	}

	@media (max-width: 40rem) {
		.contact {
			padding-block: calc(var(--baseline) * 6) calc(var(--baseline) * 5);
		}

		.contact-channels {
			grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
		}

		/* the slip the stamp lands on runs the full width, or the stamp's
		   clearance eats the handle beside it */
		.contact-channels > :global(li:last-child) {
			grid-column: 1 / -1;
		}

		.contact-channels :global(.contact-signoff) {
			--stamp-size: 4.75rem;
			right: calc(var(--baseline) * -1.5);
			bottom: calc(var(--baseline) * -3.5);
		}

		.contact-main :global(.contact-cta) {
			padding-inline: calc(var(--baseline) * 2);
		}

		.contact-cta-addr {
			font-size: var(--step-3);
			line-height: var(--lh-3);
		}

		.contact-annotation {
			margin-left: 0;
		}
	}
</style>
