---
import { Icon } from "astro-icon/components";
import Container from "~/components/container.svelte";
import getTotalTime from "~/components/scripts/getTotalTime";
import IconContainer from "~/components/tech/container.astro";
import TechIcon from "~/components/tech/icon.astro";
import SkillsShowcase from "~/components/tech/skills-showcase.svelte";

const total = await getTotalTime();
---

<Container>
 <section aria-labelledby="technologies">
  <h2 id="technologies" class="sr-only">Technical Skills</h2>
  
  <div class="backdrop-blur-md bg-secondary/10 rounded-xl p-5 mb-6 border border-accent/20 hover:border-accent/40 transition-all duration-300">
    <SkillsShowcase client:visible {total} />
  </div>
  
  <div class="flex flex-col gap-5">
   <IconContainer title="Front-End">
    <TechIcon href="https://svelte.dev/" title="Svelte">
     <Icon name="tabler:brand-svelte" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://unocss.dev/" title="UnoCSS">
     <svg
      xmlns="http://www.w3.org/2000/svg"
      width="78"
      height="79"
      viewBox="0 0 78 79"
      fill="none"
      class="w-10 h-10 color-accent"
     >
      <path
       d="M74 16.4131V33.9131C74 34.4654 73.5523 34.9131 73 34.9131H44C43.4477 34.9131 43 34.4654 43 33.9131V16.8913C43 9.71734 50 3.5 58 3.5C66.5 3.5 74 9.23908 74 16.4131Z"
       stroke="currentColor"
       stroke-width="6"
       stroke-linecap="round"
       stroke-linejoin="round"></path>
      <path
       d="M3 63L3 45.5001C3 44.9478 3.44772 44.5001 4 44.5001L33 44.5001C33.5523 44.5001 34 44.9478 34 45.5001V62.5218C34 69.6957 27 75.9131 19 75.9131C10.5 75.9131 3 70.174 3 63Z"
       stroke="currentColor"
       stroke-width="6"
       stroke-linecap="round"
       stroke-linejoin="round"></path>
      <circle cx="59" cy="60" r="16" stroke="currentColor" stroke-width="6"
      ></circle>
     </svg>
    </TechIcon>

    <TechIcon href="https://astro.build/" title="Astro">
     <Icon name="tabler:brand-astro" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://vuejs.org/" title="VueJS">
     <Icon name="tabler:brand-vue" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://react.dev/" title="ReactJS">
     <Icon name="tabler:brand-react" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://wikipedia.org/wiki/CSS3" title="CSS3">
     <Icon name="tabler:brand-css3" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://threejs.org/" title="ThreeJS">
     <Icon name="tabler:brand-threejs" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://vite.dev/" title="Vite">
     <Icon name="tabler:brand-vite" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://lottielab.com" title="Lottie">
     <svg
      xmlns="http://www.w3.org/2000/svg"
      width="68"
      height="68"
      viewBox="0 0 68 68"
      fill="none"
      class="w-10 h-10 color-accent p-1"
     >
      <rect
       x="3"
       y="3"
       width="62"
       height="62"
       rx="3"
       stroke="currentColor"
       stroke-width="7"></rect>
      <path
       d="M16.5 49C37.5 49 31.5 18.5 52 18.5"
       stroke="currentColor"
       stroke-width="7"
       stroke-linecap="round"></path>
     </svg>
    </TechIcon>

    <TechIcon href="https://www.typescriptlang.org/" title="TypeScript">
     <Icon name="tabler:brand-typescript" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://tailwindcss.com/" title="TailwindCSS">
     <Icon name="tabler:brand-tailwind" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://wikipedia.org/wiki/JavaScript" title="JavaScript">
     <Icon name="tabler:brand-javascript" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://wikipedia.org/wiki/HTML5" title="HTML5">
     <Icon name="tabler:brand-html5" class="w-10 h-10 color-accent" />
    </TechIcon>

    <TechIcon href="https://twig.symfony.com/" title="Twig">
     <Icon name="tabler:brand-symfony" class="w-10 h-10 color-accent" />
    </TechIcon>
   </IconContainer>

