---
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="group backdrop-blur-md bg-secondary/20 rounded-xl p-5 border border-accent/10 hover:border-accent/30 transition-all duration-300 shadow-lg hover:shadow-accent/5">
  <h3 class="text-accent text-xl font-semibold mb-4 relative">
    {title}
    <span class="block h-0.5 w-0 group-hover:w-full bg-accent/70 mt-1 transition-all duration-500 ease-out"></span>
  </h3>
  
  <div class="flex flex-wrap gap-3 justify-center">
    <slot />
  </div>
</div>

<style>
  div {
    transform: translateY(0);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  
  div:hover {
    transform: translateY(-5px);
  }
</style>
