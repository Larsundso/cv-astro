---
/**
 * Contact — the contact corner of the wall.
 * jobs@lars-dev.org as the biggest pinned note (mailto PinButton),
 * then the channel notes: GitHub, LinkedIn, XING, Indeed, WakaTime —
 * each a small pinned card with a drawn icon and a full-card link.
 * Closes with the wall's own sign-off: a small © stamp.
 */
import { Icon } from "astro-icon/components";
import HandNote from "~/components/wall/HandNote.astro";
import PinButton from "~/components/wall/PinButton.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Stamp from "~/components/wall/Stamp.astro";
import { getWall, type Locale } from "~/data/i18n";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { contact, meta, sectionStrings, ui } = getWall(locale);

const primary = contact.entries.find((entry) => entry.primary);
const channels = contact.entries.filter((entry) => !entry.primary);

/* Channel icons come from the hand-inked local set in src/icons/;
   filenames match entry ids (github, linkedin, xing, indeed, wakatime). */

/** Neighbors never share a tilt: 1, 0, -1, 1, 0 … */
const tilt = (index: number) => ([1, 0, -1] as const)[index % 3];

const year = new Date().getFullYear();
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
	<div class="wall-max">
		<div class="wall-grid contact-grid">
			<div class="contact-head">
				<PinCard variant="flyer" rotate={1} class="contact-title-card">
					<h2 id="contact-heading">{contact.title}</h2>
				</PinCard>
			</div>

			<div class="contact-primary-block">
				<div class="contact-annotation">
					<HandNote ink="amber" class="contact-annotation-note">
						{sectionStrings.contact.annotation}
					</HandNote>
					<svg
						class="contact-annotation-arrow"
						viewBox="0 0 32 40"
						fill="none"
						aria-hidden="true"
					>
						<path
							d="M6 3 C 20 8, 26 18, 22 34"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"></path>
						<path
							d="M15 29 L22 35.5 L26 26.5"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
							stroke-linejoin="round"></path>
					</svg>
				</div>
				{
					primary && (
						<PinButton href={primary.href} rotate={-1}>
							<span class="contact-primary-label">{primary.value}</span>
						</PinButton>
					)
				}
			</div>

			<ul class="contact-channels" role="list">
				{
					channels.map((entry, index) => (
						<PinCard as="li" variant="print" rotate={tilt(index)}>
							<a
								class="channel-link"
								href={entry.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<Icon name={entry.id} class="channel-icon" aria-hidden="true" />
								<span class="channel-text">
									<span class="channel-label">{entry.label}</span>
									<span class="channel-value">{entry.value}</span>
								</span>
								<span class="visually-hidden">{ui.opensNewTab}</span>
							</a>
						</PinCard>
					))
				}
			</ul>

			<div class="contact-signoff">
				<Stamp sub={`© ${year}`} label={meta.person.name} rotate={-6} />
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		padding-block: calc(var(--baseline) * 12) calc(var(--baseline) * 8);
	}

	/* ---- heading: a flyer pinned above the corner ---- */

	.contact-head {
		grid-column: 2 / span 5;
		justify-self: start;
	}

	.contact-head h2 {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
	}

	/* ---- the primary note: annotation, arrow, mailto ---- */

	.contact-primary-block {
		grid-column: 3 / span 8;
		justify-self: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.contact-annotation {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: calc(var(--baseline) * 0.5);
		margin-bottom: calc(var(--baseline) * 2);
		color: var(--ink-amber);
		rotate: -1deg;
	}

	.contact-annotation :global(.contact-annotation-note) {
		font-size: 1.125rem;
	}

	.contact-annotation-arrow {
		width: 1.75rem;
		height: auto;
		margin-left: calc(var(--baseline) * 5);
	}

	.contact-primary-label {
		display: inline-block;
		padding: var(--baseline) calc(var(--baseline) * 2);
		font-size: clamp(1.125rem, 4.5vw, 1.875rem);
		line-height: 1.25;
		overflow-wrap: anywhere;
	}

	/* ---- channel notes: five small pinned slips ---- */

	.contact-channels {
		grid-column: 1 / -1;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: calc(var(--baseline) * 3) calc(var(--baseline) * 4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* the whole slip is the link: pull the anchor over the card padding */
	.channel-link {
		display: flex;
		align-items: center;
		gap: calc(var(--baseline) * 1.5);
		margin: calc(var(--baseline) * -3);
		padding: calc(var(--baseline) * 2) calc(var(--baseline) * 2.5);
		min-width: 10rem;
		min-height: 44px;
		color: var(--ink);
		font-family: var(--font-typed);
		text-decoration: none;
	}

	.channel-icon {
		flex: none;
		width: 1.75rem;
		height: 1.75rem;
	}

	.channel-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.channel-label {
		font-weight: 700;
		font-size: 0.9375rem;
		line-height: calc(var(--baseline) * 2);
	}

	.channel-value {
		font-size: 0.875rem;
		line-height: calc(var(--baseline) * 2);
		color: var(--ink-soft);
	}

	/* the slip presses into the cork like every interactive note */
	@media (prefers-reduced-motion: no-preference) {
		.contact-channels > :global(li) {
			transition:
				rotate 150ms ease-out,
				box-shadow 150ms ease-out,
				translate 150ms ease-out;
		}

		.contact-channels > :global(li:hover),
		.contact-channels > :global(li:focus-within) {
			box-shadow: 0 1px 4px oklch(25% 0.015 60 / 0.18);
			translate: 0 1px;
		}
	}

	/* ---- sign-off: the wall's own stamp in the corner ---- */

	.contact-signoff {
		--stamp-size: 5.5rem;
		grid-column: 1 / -1;
		justify-self: end;
		margin-right: calc(var(--baseline) * 3);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* ---- one column on narrow walls ---- */

	@media (max-width: 48rem) {
		.contact {
			padding-block: calc(var(--baseline) * 8) calc(var(--baseline) * 6);
		}

		.contact-head,
		.contact-primary-block {
			grid-column: 1 / -1;
			justify-self: center;
		}

		.contact-signoff {
			margin-right: 0;
		}
	}
</style>
