---
import BuildYourVision from "./BuildYourVision.astro";
import CreateExperiences from "./CreateExperiences.astro";
import Skills from "./Skills.astro";
import Header from "./Header.astro";
---

<div class="w-full relative overflow-hidden py-4 px-6 mb-8">
 <div
  class="absolute top-0 left-0 w-full h-full pointer-events-none of-hidden z-1 hidden md:block"
 >
  <CreateExperiences />
  <Skills />
  <BuildYourVision />
 </div>

 <div
  class="absolute top-0 left-0 w-full h-full pointer-events-none of-hidden z-1 md:hidden"
 >
  <div class="absolute top-50% left-50% translate-[-50%_-50%] op-20 scale-80">
   <BuildYourVision />
  </div>
 </div>

 <Header />
</div>

<style>
 .mobile-code-animation {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.2;
  scale: 0.8;
 }

 @media (max-width: 768px) {
  :global(.code-block-base) {
   position: relative !important;
   top: auto !important;
   left: auto !important;
   right: auto !important;
   bottom: auto !important;
   animation: simplePulse 5s infinite ease-in-out !important;
  }
 }

 @keyframes simplePulse {
  0%,
  100% {
   opacity: 0.2;
   transform: scale(0.8);
  }
  50% {
   opacity: 0.3;
   transform: scale(0.85);
  }
 }
</style>
