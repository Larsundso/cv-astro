---
import { Icon } from "astro-icon/components";
import Greeter from "~/components/greeter.astro";
import Container from "~/components/container.svelte";
import MeIcon from "~/components/me/icon.astro";
---

<Container>
 <section aria-labelledby="about-me" class="tilt-card">
  <Greeter />

  <h1 id="about-me" class="sr-only">About Lars Böse</h1>

  <div class="text-text text-lg max-w-prose font-500 tilt-card-content">
   <a
    class="text-accent hover:text-accent/80 transition-colors duration-300"
    href="https://www.ihk.de/schwaben/produktmarken/aus-und-weiterbildung/ausbildung/ausbildungsberufe-a-z/fachinformatiker-anwendungsentwicklung-5058194"
    target="_blank"
    rel="noopener"
   >
    Chamber of Industry and Commerce certified
   </a> IT specialist for application development and open-source full-stack developer.
  </div>

  <div
   class="my-6 h-px w-full bg-gradient-to-r from-transparent via-accent/30 to-transparent"
  >
  </div>

  <nav class="mt-5 tilt-card-content" aria-label="Social links">
   <h3 class="text-accent/80 mb-3 text-sm font-medium">Connect with me</h3>
   <div class="flex flex-row gap-5 flex-wrap">
    <MeIcon href="https://github.com/Larsundso" title="GitHub">
     <Icon name="tabler:brand-github" class="w-10 h-10 color-accent" />
    </MeIcon>

    <MeIcon href="https://wakatime.com/@Larsundso" title="WakaTime">
     <svg
      xmlns="http://www.w3.org/2000/svg"
      width="75"
      height="75"
      viewBox="0 0 75 75"
      fill="none"
      class="w-10 h-10 text-accent"
      aria-hidden="true"
     >
      <circle
       cx="37.5"
       cy="37.5"
       r="34.5"
       stroke="currentColor"
       stroke-width="6"></circle>
      <path
       d="M23.5 32L32.1956 44.3569C32.5901 44.9175 33.4189 44.924 33.8221 44.3696L36.1556 41.1611C36.5651 40.5981 37.4102 40.6153 37.7964 41.1945L40.1984 44.7976C40.586 45.379 41.4353 45.3938 41.8428 44.8261L55 26.5"
       stroke="currentColor"
       stroke-width="6"
       stroke-linecap="round"
       stroke-linejoin="round"></path>
     </svg>
    </MeIcon>

    <MeIcon href="https://www.xing.com/profile/Lars_Boese" title="XING">
     <Icon name="tabler:brand-xing" class="w-10 h-10 color-accent" />
    </MeIcon>

    <MeIcon
     href="https://www.linkedin.com/in/lars-b%C3%B6se-217272351"
     title="LinkedIn"
    >
     <Icon name="tabler:brand-linkedin" class="w-10 h-10 color-accent" />
    </MeIcon>

    <MeIcon href="https://profile.indeed.com/p/larsb-2hf1h8b" title="Indeed">
     <svg
      xmlns="http://www.w3.org/2000/svg"
      width="60"
      height="85"
      viewBox="0 0 60 85"
      fill="none"
      class="w-10 h-10 text-accent"
      aria-hidden="true"
     >
      <path
       d="M29 77.5C29.0511 77.5746 29.1021 77.6481 29.1532 77.7204M29.1532 77.7204C34.1727 84.8276 39.2543 80.8507 41.3427 77.7415C41.448 77.5846 41.5 77.3997 41.5 77.2107V45.3685C41.5 44.5698 40.5993 44.0817 39.8885 44.4458C36.3882 46.2392 32.8882 46.4375 30.7463 46.2103C30.1038 46.1421 29.4932 46.6203 29.4862 47.2664L29.1532 77.7204ZM3 42.5C9.5 20.5 28.5 -11.5 56.5 12.5"
       stroke="currentColor"
       stroke-width="6"
       stroke-linecap="round"
       stroke-linejoin="round"></path>
      <circle cx="35" cy="28" r="8" stroke="currentColor" stroke-width="6"
      ></circle>
     </svg>
    </MeIcon>
   </div>
  </nav>
 </section>
</Container>

<style>
 .tilt-card {
  transition:
   transform 0.1s ease-out,
   box-shadow 0.3s ease;
  transform-style: preserve-3d;
  position: relative;
 }

 .tilt-card-content {
  transform-style: preserve-3d;
  transition: transform 0.1s ease-out;
  position: relative;
 }
</style>
