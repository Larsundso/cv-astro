---
/**
 * Stamp — a small circular rubber stamp for dates and as-of marks.
 * Crimson stamp ink, darkened a step so small type holds 4.5:1 on cork.
 * sub sits above label: <Stamp sub="as of" label="2026-08-03" />
 */
interface Props {
	label: string;
	sub?: string;
	/** free rotation in degrees; stamps are hand-pressed */
	rotate?: number;
	class?: string;
}

const { label, sub, rotate = 0, class: className } = Astro.props;
---

<span class:list={["stamp", className]} style={`--stamp-rot:${rotate}deg;`}>
	{sub && <span class="stamp__sub">{sub}</span>}
	<span class="stamp__label">{label}</span>
</span>

<style>
	.stamp {
		/* Measured against the DARKEST PAINTED BOARD, not against --cork.
		   That distinction is the whole finding: at the 62/38 mix this ink
		   measures 4.770:1 against the median board — which is where the
		   "0 failures" audit stopped, and it is a genuine pass — but only
		   4.185:1 against the darkest pixel the wash actually paints, and
		   every stamp on bare cork sits somewhere on that gradient. The old
		   audit survived by luck of placement: all 13 bare-cork stamps
		   happen to be pinned in the top third, where the lamp is bright.
		   At 44/56 the ink holds 4.977:1 on the darkest board and 5.673:1 on
		   the median, and is still unmistakably the stamp red. A stamp
		   overhangs its card, so it has to pass on paper too — it does, by
		   a wide margin. */
		--stamp-ink: color-mix(in oklab, var(--thread) 44%, var(--ink));
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		width: var(--stamp-size, 6.5rem);
		aspect-ratio: 1;
		padding: var(--baseline);
		border: 2px solid var(--stamp-ink);
		border-radius: 50%;
		rotate: var(--stamp-rot, 0deg);
		color: var(--stamp-ink);
		font-family: var(--font-typed);
		font-weight: 700;
		text-transform: uppercase;
		text-align: center;
	}

	.stamp::before {
		content: "";
		position: absolute;
		inset: 3px;
		border: 1px solid var(--stamp-ink);
		border-radius: 50%;
	}

	/* Generous tracking at this size is characterisation, not error: it is
	   what type struck into rubber actually looks like. */
	.stamp__label {
		font-size: var(--step--2);
		letter-spacing: 0.06em;
		line-height: calc(var(--baseline) * 1.5);
		white-space: nowrap;
	}

	.stamp__sub {
		font-size: var(--step--2);
		letter-spacing: 0.14em;
		line-height: calc(var(--baseline) * 1.25);
	}
</style>
