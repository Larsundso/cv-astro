---
/**
 * Hero — the first-viewport wall cluster.
 *
 * The thread's 12/2019 origin pin, the typed record card, the handwritten
 * Lottie greeting, the hand-annotated telemetry print-out, the Ayako
 * polaroid, and the pinned contact button — stitched by the crimson
 * thread. On narrow viewports the cluster stacks into one curated column
 * and the thread keeps running.
 *
 * COMPOSITION (owner decision, 2026-08-04): the wall leads with the
 * MEASURED CLAIM, not with the artwork. Band 1 is the stamp plus the
 * typed record across the shell, whose first typed line is the bot, its
 * users, its servers and the year it went to production; band 2 is the
 * signature, the evidence print-out, the polaroid as a pinned exhibit at
 * the right, and the contact button. Reading order: claim → evidence →
 * exhibit → action.
 *
 * ONE READING ORDER, and the document holds it. The markup below is
 * written in the narrative's own sequence — origin stamp, signature,
 * CLAIM, EVIDENCE, EXHIBIT, ACTION — so the story a sighted reader walks
 * is the story a screen reader reads out and the sequence a keyboard
 * walks. Neither breakpoint re-sorts it: the stacked column is a plain
 * flex column in source order (no `order` anywhere in this file), and the
 * desktop wall reaches its two bands through explicit grid-column /
 * grid-row placement. If an artifact ever has to move on the wall, move
 * its grid placement — never the markup, and never with `order`.
 * The whole cluster closes above the fold at
 * 1440 × 900 (board 693px tall; lowest ink — the polaroid's margin note —
 * bottoms at 890px), so every one of those four lands in the first
 * viewport. The polaroid stays a first-viewport artifact at a
 * legible 15rem — this is a change of RANK, never a demotion.
 *
 * Telemetry lines render live WakaTime figures when WAKA_KEY is set at
 * build time; otherwise the checked-in snapshot copy from wall.ts stands
 * verbatim. Sentence shapes are identical in both cases (voice law:
 * every figure carries unit + as-of date).
 */
import getTotalTime from "~/components/scripts/getTotalTime";
import HandNote from "~/components/wall/HandNote.astro";
import PinButton from "~/components/wall/PinButton.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Polaroid from "~/components/wall/Polaroid.astro";
import Stamp from "~/components/wall/Stamp.astro";
import Thread from "~/components/wall/Thread.astro";
import { tautPath } from "~/components/wall/taut";
import { getWall, type Locale } from "~/data/i18n";
import Greeting from "./hero/Greeting.astro";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { hero, chartStrings } = getWall(locale);
const ht = chartStrings.heroTelemetry;

const stats = await getTotalTime();
/* Figures keep en-US grouping in every locale (wall figure style). */
const nf = (n: number) => n.toLocaleString("en-US");

const telemetryLines: string[] =
	stats.source === "live"
		? [
				ht.total(stats.total.text, stats.asOf),
				ht.activeDays({
					active: nf(stats.days.active),
					elapsed: nf(stats.days.elapsed),
					ratePercent: stats.days.ratePercent,
					start: stats.range.start,
					end: stats.range.end
				}),
				ht.dailyAverage(stats.dailyAverage.text)
			]
		: [...hero.telemetryCard.lines];

const sourceLine = ht.sourceLine(
	hero.telemetryCard.sourceNote,
	stats.source === "live" ? ht.modeLive : ht.modeSnapshot
);

/* The thread, desktop: 12/2019 origin pin → the typed record card (the
   claim, top band) → the signature → the contact button under it → the
   evidence print-out → the Ayako polaroid at the right edge → exits at
   the board's bottom edge at x ≈ 67 % (802/1200), where the next section
   picks it up. The polaroid is the last station on purpose: the join
   below runs down-LEFT, so the hero's last run has to arrive from the
   right or the seam kinks on bare cork.
   TAUT: straight runs pin to pin; direction changes only as a small
   wrap around each pin (tautPath). Coordinates live in the viewBox
   space and stretch with the board (preserveAspectRatio="none") —
   straight segments survive that stretch exactly. Every vertex is a
   measured pin centre at 1440 × 900 (board 1248 × 693), exact at every
   width where the 78rem shell is full: re-measure and retune whenever an
   artifact moves. Current registration, measured pin-centre to vertex:
   worst 2.2px (the record card's pin), everything else ≤1.3px — all well
   inside the 7px pin head the thread wraps, so the joins read closed. */
const THREAD_DESKTOP = {
	width: 1200,
	height: 880,
	path: tautPath([
		[134, 70],
		[799, 4],
		[208, 338],
		[208, 724],
		[647, 379],
		[1041, 338],
		[802, 880]
	]),
	nodes: [
		{ x: 134, y: 70 },
		{ x: 799, y: 4 },
		{ x: 208, y: 338 },
		{ x: 208, y: 724 },
		{ x: 647, y: 379 },
		{ x: 1041, y: 338 }
	]
};

/* The thread, stacked column: a taut near-vertical stitch down the
   center, from behind the 12/2019 stamp to the bottom edge — straight
   runs between the cards' pin stations, tiny wraps at each. The column's
   cards span the full width, so the thread runs BEHIND the paper
   (z-index, see styles) and surfaces in the cork gaps between artifacts.
   Stations, in the column's own order: signature → record → evidence →
   polaroid → action (measured at 390 × 844). */
const THREAD_MOBILE = {
	width: 400,
	height: 1600,
	path: tautPath(
		[
			[200, 58],
			[200, 163],
			[205, 326],
			[197, 717],
			[200, 1028],
			[201, 1495],
			[200, 1600]
		],
		6
	)
};
---

<section class="hero">
	<div class="hero__board wall-max">
		<div class="hero__thread hero__thread--desktop" aria-hidden="true">
			<Thread
				path={THREAD_DESKTOP.path}
				width={THREAD_DESKTOP.width}
				height={THREAD_DESKTOP.height}
				nodes={THREAD_DESKTOP.nodes}
			/>
		</div>
		<div class="hero__thread hero__thread--mobile" aria-hidden="true">
			<Thread
				path={THREAD_MOBILE.path}
				width={THREAD_MOBILE.width}
				height={THREAD_MOBILE.height}
			/>
		</div>

		<div class="hero__grid wall-grid">
			<!-- 12/2019 — where the thread starts -->
			<div class="hero__origin">
				<Stamp label={hero.threadStart.stamp} rotate={-8} />
				<span class="brass-pin hero__origin-pin" aria-hidden="true"></span>
				<div class="hero__origin-note">
					<HandNote ink="green">{hero.threadStart.label}</HandNote>
				</div>
			</div>

			<!-- the handwritten greeting, centerpiece -->
			<div class="hero__greeting paper pinned" style="--tilt:0">
				<span class="brass-pin hero__greeting-pin" aria-hidden="true"></span>
				<Greeting greeting={hero.greeting} subline={hero.greetingSubline} />
			</div>

			<!-- CLAIM. Typed record card: what / who / where. It leads the
			     cluster, so the MEASURED claim (intro[1]: the bot, its users,
			     its servers, the year it went to production) is typed on the
			     card's first rules and the employment record follows on the
			     next ones. Both strings stay verbatim from the data layer —
			     only which one the card opens with changed. -->
			<div class="hero__intro-slot">
				<PinCard variant="typed" rotate={1}>
					<p class="hero__intro-lead">{hero.intro[1]}</p>
					<p>{hero.intro[0]}</p>
					<p>{hero.location}</p>
					<p class="hero__intro-langs">{hero.languages}</p>
				</PinCard>
			</div>

			<!-- EVIDENCE. The hand-annotated telemetry print-out that proves
			     the claim above it. -->
			<div class="hero__telemetry-slot">
				<PinCard variant="print" rotate={-1} as="article">
					<h2 class="hero__telemetry-title">{hero.telemetryCard.title}</h2>
					<ul class="hero__telemetry-lines" role="list">
						{telemetryLines.map((line) => <li>{line}</li>)}
					</ul>
					<p class="hero__telemetry-source">{sourceLine}</p>
				</PinCard>
				<div class="hero__telemetry-note">
					<HandNote ink={hero.telemetryCard.annotation.ink}>
						{hero.telemetryCard.annotation.text}
					</HandNote>
				</div>
			</div>

			<!-- EXHIBIT. Ayako polaroid: a product artifact, labelled like
			     one — the caption names the thing on line one and measures it
			     on line two (the newline is joined here so the data keeps two
			     clean strings; see .hero__polaroid-slot styles). It is the
			     thing the claim and the evidence are ABOUT, so it follows
			     them in the document; the grid pins it to the right edge. -->
			<div class="hero__polaroid-slot">
				<Polaroid caption={`${hero.polaroid.label}\n${hero.polaroid.caption}`} rotate={0}>
					<img
						src={hero.polaroid.image}
						alt={hero.polaroid.alt}
						width="640"
						height="640"
						loading="eager"
						fetchpriority="high"
						decoding="sync"
					/>
				</Polaroid>
				<div class="hero__polaroid-note">
					<HandNote ink={hero.polaroid.annotation.ink}>{hero.polaroid.annotation.text}</HandNote>
				</div>
			</div>

			<!-- ACTION. The pinned primary action — the cluster's last beat
			     and the hero's only focusable element, so it is also the last
			     tab stop in the first viewport. -->
			<div class="hero__action">
				<PinButton href={hero.primaryAction.href} rotate={1}>
					{hero.primaryAction.label}
				</PinButton>
				<div class="hero__action-note">
					<HandNote ink={hero.primaryAction.annotation.ink}>
						{hero.primaryAction.annotation.text}
					</HandNote>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: calc(var(--baseline) * 3) 0 calc(var(--baseline) * 10);
		overflow-x: clip;
	}

	.hero__board {
		position: relative;
		/* query container for the origin row's zoom fallback further down.
		   It sits HERE, on the board, and not on the row it restyles,
		   because a container query only ever reaches its container's
		   DESCENDANTS: the row has to change axis, and the tuned thread —
		   the row's sibling, not its child — has to stop being drawn with
		   it. The board is the nearest element that contains both. */
		container: hero-wall / inline-size;
	}

	/* ---- the thread through the cluster ------------------------ */
	/* Behind the paper on every breakpoint: a pinned thread runs under
	   overlapping sheets and surfaces in the cork gaps — it must never
	   cross printed text. The tilted cards' transforms stack them above. */

	.hero__thread {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* below every card, note, and pin: the taut thread surfaces only
		   on bare cork (same layering as the section connectors) */
		z-index: -1;
	}

	.hero__thread :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hero__thread--mobile {
		display: none;
	}

	/* ---- the cluster on the hidden 12-col grid ----------------- */
	/* TWO BANDS, and the record leads (owner decision, 2026-08-04).
	   Band 1: the 12/2019 stamp, then the typed record card across the
	   rest of the shell — the measured claim is the first printed thing
	   in the viewport. Band 2: the signature, the evidence print-out,
	   and the Ayako polaroid as the pinned exhibit at the right edge,
	   with the contact button under the signature. The cluster is tuned
	   to close ABOVE the 900px fold at 1440 wide: claim → evidence →
	   exhibit → action all land in the first viewport. */

	.hero__grid {
		position: relative;
		align-items: start;
		row-gap: calc(var(--baseline) * 3);
	}

	/* origin: stamp, pin, margin note */
	.hero__origin {
		grid-column: 1 / 5;
		grid-row: 1;
		display: flex;
		align-items: flex-start;
		gap: calc(var(--baseline) * 2);
		--stamp-size: 5.75rem;
	}

	.hero__origin-pin {
		flex: none;
		margin-top: calc(var(--baseline) * 6);
	}

	/* dropped a step below the pin so the thread's first run to the
	   record card passes ABOVE the slip instead of under it */
	.hero__origin-note {
		max-width: 16rem;
		/* the slip is a flex item beside the stamp, and a flex item's
		   default min-width is its longest word: at big type sizes the
		   16rem cap stops binding and the slip pushes out of its four
		   columns onto the record card (measured: 5px into it at 1024 with
		   type at 2×). min-width: 0 lets it wrap inside its columns
		   instead. Nothing moves at normal type — 16rem is well inside the
		   track there, so the item never shrinks. */
		min-width: 0;
		/* …and this is the other half of that trade. min-width: 0 keeps the
		   slip's BOX inside its four columns, but a box is not ink: once the
		   box is narrower than the longest word, the word paints straight
		   out of it. Measured at 1024 with text at 200 %: 2.4px of hand
		   escaping the slip; at 225 % it reaches 13.7px ONTO the record card
		   (16.6px in German), which the box measurement cannot see because
		   the boxes are still 15px apart. The word breaks instead. */
		overflow-wrap: break-word;
		margin-top: calc(var(--baseline) * 7);
		rotate: -1.5deg;
		/* paper slip: these notes sit in the thread's path */
		background: var(--paper);
		box-shadow: var(--pin-shadow);
		padding: calc(var(--baseline) * 0.75) calc(var(--baseline) * 1.5);
	}

	/* ZOOM SAFETY NET, the origin row. Same idiom as the evidence slip
	   below, for the same reason: a row of three items whose gaps are fixed
	   px and whose contents grow in em eventually has no room for the third.
	   The stamp is sized in rem, so at 200 % text it is 166px of a 309px row
	   at the 1024 breakpoint and the slip is squeezed to 124px — narrower
	   than the words on it.

	   The em resolves against the wall's own type, so the condition reads
	   "the wall has become narrow FOR ITS OWN TYPE": the board is 64em at the
	   1024 breakpoint and 78em at a full shell with normal text, and only
	   crosses 36em once type has roughly doubled. Past that line the origin
	   row stops being a row and becomes the same centred column the stacked
	   breakpoint already uses — the slip returns to flow under the stamp with
	   the full track to wrap in. Nothing is shrunk to make this fit, and
	   nothing moves at or near normal type: the first break appears at 32em
	   (1024px shell, text at 200 %), so the net closes a clear step before
	   it, and the nearest passing case is 36.6em.

	   AND THE TUNED THREAD RETIRES WITH THE ROW IT WAS MEASURED AGAINST.
	   Every vertex in THREAD_DESKTOP is a pin centre measured at 1440 × 900;
	   the note above the path says to re-measure whenever an artifact moves,
	   and this is the one state where artifacts move without anyone
	   re-measuring — the stamp recentres under its own column and lands in
	   the first run's way. Measured: the yarn crossed the "12/2019" label,
	   the wall's only artifact with no paper under it, from 181 % text
	   upward. A stale thread that crosses bare ink is worse than no thread,
	   so past this line the desktop path is not drawn. The stacked column
	   keeps its own thread below 1024px, and the section connectors carry
	   the metaphor down the rest of the page; this affects only a zoomed
	   desktop wall, and only until a third path is measured for it. */
	@container hero-wall (max-width: 36em) {
		.hero__thread--desktop {
			display: none;
		}

		.hero__origin {
			flex-direction: column;
			align-items: center;
			gap: var(--baseline);
		}

		.hero__origin-pin {
			margin-top: 0;
		}

		.hero__origin-note {
			margin-top: 0;
			text-align: center;
		}
	}

	/* greeting card: band 2, left — the signature under the record */
	.hero__greeting {
		grid-column: 1 / 5;
		grid-row: 2;
		align-self: start;
		position: relative;
		padding: calc(var(--baseline) * 5) calc(var(--baseline) * 4) calc(var(--baseline) * 4);
	}

	.hero__greeting-pin {
		position: absolute;
		top: calc(var(--baseline) * -0.75);
		left: 50%;
		translate: -50% 0;
	}

	/* The dateline under the greeting is not a second hand. The card's
	   hand IS the signature (drawn ink, or the hand-set resolved state),
	   so the line beneath it drops to the cluster's annotation size —
	   at 1rem it read as its own voice next to a different handwriting,
	   which is what made the first viewport look like five families.
	   Face and material are unchanged: the sheet stays all hand.

	   Weight comes with it. The size was already matched to the margin
	   notes but the weight was not (400 against their 500), and once the
	   Lottie hands over this is the ONLY hand-set line left on the sheet —
	   a lone 400 sitting among five 500s at the same 14px. Small hand text
	   needs the extra weight to hold the same optical colour, which is
	   exactly why the notes are 500 while the 36px signature above is 400;
	   matching it here is the system, not an exception to it. */
	.hero__greeting :global(.hero-greeting__subline) {
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1.4;
	}

	/* polaroid: the product exhibit, pinned at the wall's right in band 2.
	   It is deliberately the smallest sheet in the cluster now — the
	   artwork is Ayako's avatar, an exhibit for the record above it, not
	   the hero image. 15rem is a floor as much as a size: the character
	   must stay legible in the first viewport (216px of picture at 1440,
	   never below ~200), so it shrinks no further. */
	.hero__polaroid-slot {
		grid-column: 10 / 13;
		grid-row: 2;
		/* centred in its columns, not flush to the shell edge: the pin
		   then sits at a fixed FRACTION of the board at every width, so
		   the thread's last corner keeps landing on it while the shell
		   narrows — and it still sits far enough right that the run
		   leaves the board in the direction the section join continues */
		justify-self: center;
		width: 15rem;
		max-width: 100%;
	}

	/* The caption is an exhibit label: the product's name and what it is
	   on its own first line, the measured figures beneath. Only the hero
	   copy carries the newline — the Polaroid primitive is untouched.

	   The label reading is carried by the LINE BREAK, not by a weight. A
	   ::first-line at 700 used to bold the name, which put a third weight
	   of the hand face in one viewport (signature 400, notes 500, caption
	   700) at a size where Shantell's bold clots — so the one pen looked
	   like two. The break, the em-dash construction and the caption's
	   centred position already say "name, then measurements"; the weight
	   was decoration on structure that exists without it. Line-height is
	   matched to the margin notes' 1.4 for the same reason: every
	   hand-set line in the first viewport is now literally one setting. */
	.hero__polaroid-slot :global(.polaroid__caption) {
		white-space: pre-line;
		line-height: 1.4;
	}

	.hero__polaroid-note {
		max-width: 16rem;
		margin: calc(var(--baseline) * 2) 0 0 calc(var(--baseline) * 1);
		rotate: -2deg;
		/* paper slip: these notes sit in the thread's path */
		background: var(--paper);
		box-shadow: var(--pin-shadow);
		padding: calc(var(--baseline) * 0.75) calc(var(--baseline) * 1.5);
	}

	/* typed record card: band 1, across the shell beside the stamp */
	.hero__intro-slot {
		grid-column: 5 / 13;
		grid-row: 1;
		margin-top: 0;
	}

	/* Typed on consecutive rules, the way a card actually gets typed:
	   the record is ONE block under the claim, not four floating
	   paragraphs. This is what buys the cluster the vertical room to
	   close above the fold. */
	.hero__intro-slot :global(.pin-card) p {
		margin: 0;
		font-size: 0.9375rem;
	}

	/* The claim: the card's first line, given the only blank rule on the
	   sheet and struck at the typewriter's bold — but at the CARD'S OWN
	   SIZE. It used to be 1rem against the record's 0.9375rem, and on a
	   monospace sheet a second size is a second machine: Courier's advance
	   is 0.6em, so 16px type sets a 9.6px pitch and 15px type a 9.0px one,
	   and the claim's character columns stopped lining up with the record
	   beneath it. One index card, one carriage. The 1px did nothing the
	   bold was not already doing (measured: the lead reads as emphasis
	   identically at either size), and dropping it also retires a whole
	   Courier setting from the first viewport. */
	.hero__intro-slot :global(.pin-card) p.hero__intro-lead {
		margin-bottom: calc(var(--baseline) * 3);
		font-weight: 700;
	}

	.hero__intro-langs {
		color: var(--ink-soft);
	}

	/* telemetry print-out: band 2, center — the evidence sits directly
	   under the claim it proves and is the widest sheet in its band */
	.hero__telemetry-slot {
		grid-column: 5 / 10;
		grid-row: 2;
		/* hung a step lower than its neighbours: three sheets pinned dead
		   level would be a table, and the stagger opens the cork the
		   thread crosses between them */
		margin-top: calc(var(--baseline) * 4);
		position: relative;
		/* query container for the annotation's zoom fallback below */
		container: hero-evidence / inline-size;
	}

	/* The evidence sheet is the loudest print on the wall: this is the
	   claim the reader is meant to land on, so the print face leads the
	   size ladder (flyer 2.75rem › signature ~2.25rem › THIS › typed
	   record 0.9375–1rem › hand 0.875rem). Four faces, four bands — the
	   collision was three of them sitting at the same 15–18px. */
	/* LEADING IN REM, SPACING IN PX. --baseline is a fixed 8px by design, so
	   `calc(var(--baseline) * 3)` is a leading that ignores type size. That is
	   right for margins — under text-only zoom, spacing that holds still keeps
	   the wall compact so more words fit the screen — and wrong for leading,
	   which has to grow with the words or the rows close on each other. This
	   heading measured line-height ÷ font-size = 1.091 at normal type but
	   0.873 at 125 % text and 0.545 at 200 %: below 1.0 the leading is shorter
	   than the em box and ascenders sit in the row above. 1.5rem is the same
	   24px at normal type — the third baseline, unchanged — and stays 1.091
	   at every zoom step because rem is what the user's font-size setting
	   actually moves. */
	.hero__telemetry-title {
		margin: 0 0 calc(var(--baseline) * 2);
		font-size: 1.375rem;
		font-weight: 700;
		line-height: 1.5rem;
	}

	.hero__telemetry-lines {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* the figures sit a step above card copy — and stay on the 24px
	   baseline, which 1.5 × 1.0625rem would not. 1.5rem, not 24px: same
	   third baseline at normal type, but it tracks the reader's type size
	   (see the heading above). These are the lines that showed it — they
	   wrap to two and three rows, and at 200 % text their leading ÷ size
	   was 0.706. */
	.hero__telemetry-lines li {
		margin-bottom: var(--baseline);
		font-size: 1.0625rem;
		line-height: 1.5rem;
	}

	.hero__telemetry-lines li:last-child {
		margin-bottom: 0;
	}

	.hero__telemetry-source {
		margin: calc(var(--baseline) * 2) 0 0;
		font-size: 0.8125rem;
		color: var(--ink-soft);
	}

	/* The annotation is pinned to the CORK below the print-out, never on it:
	   a note slip sits beside the sheet it annotates and no slip prints over
	   a sheet (DESIGN.md, the paper law). Two decisions hold that:

	   — HUNG BY ITS TOP EDGE, not its bottom. `top: 100%` puts the slip's
	     first line a fixed 32px under the sheet's bottom edge and lets the
	     slip grow DOWNWARD into bare cork. That 32px covers the card's ~5px
	     rotation overhang and leaves 23.8px of visible cork at 1440 with
	     normal type, against the old `bottom: -72px`'s 24.6px — and it is
	     the same 32px the stacked and container fallbacks below already put
	     between sheet and slip, so the hang distance and the in-flow margin
	     are now one number. What the swap buys is what no number could: the
	     slip's own height is no longer part of the clearance, so no type
	     size can push it back up onto the sheet. Hanging by the BOTTOM edge
	     spent the clearance in fixed px (--baseline is 8px, always) while
	     the slip's height grew in em, so growing type ate the cork from
	     below and the slip climbed onto the print — measured at 7.3px INTO
	     the sheet at a 1600px shell with text at 175 % (both locales), i.e.
	     inside WCAG 1.4.4's 200 %. Hung from the top, that failure mode does
	     not exist at any size: worst clearance across 320–1600px × 100–250 %
	     text is 17.6px of cork, and it never goes below that.
	   — hung under the card's middle rather than its right corner: this slip
	     has no paper under it, so no yarn may cross it, and the thread's
	     exit run (polaroid pin → the board's bottom edge at x ≈ 67 %) sweeps
	     leftward across exactly the band the note used to occupy. Off-centre
