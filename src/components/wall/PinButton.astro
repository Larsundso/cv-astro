---
/**
 * PinButton — an interactive pinned note. Renders <a> with href,
 * <button> without. Typed face; the pin settles when hovered,
 * the note presses into the cork when active.
 */
interface Props {
	href?: string;
	type?: "button" | "submit";
	/** rotation step: -1 | 0 | 1 → ±1.2deg */
	rotate?: -1 | 0 | 1;
	class?: string;
	"aria-label"?: string;
}

const {
	href,
	type = "button",
	rotate = 0,
	class: className,
	"aria-label": ariaLabel
} = Astro.props;
const Tag = href ? "a" : "button";
const attrs = href ? { href } : { type };
---

<Tag
	{...attrs}
	aria-label={ariaLabel}
	class:list={["pin-btn", "pinned", className]}
	style={`--tilt:${rotate};`}
>
	<span class="brass-pin pin-btn__pin" aria-hidden="true" />
	<slot />
</Tag>

<style>
	.pin-btn {
		position: relative;
		display: inline-block;
		padding: calc(var(--baseline) * 2) calc(var(--baseline) * 3);
		background: var(--paper);
		box-shadow: var(--pin-shadow);
		border: none;
		cursor: pointer;
		font-family: var(--font-typed);
		font-weight: 700;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink);
		text-align: center;
		text-decoration: none;
	}

	.pin-btn__pin {
		position: absolute;
		top: calc(var(--baseline) * -0.75);
		left: 50%;
		translate: -50% 0;
	}

	/* The press-in law: paper is pushed INTO the cork, never lifted off it.
	   Elevation drops and the sheet moves down-right along the light.
	   These end states are deliberately OUTSIDE the reduced-motion gate —
	   a vestibular visitor is asking for no travel, not for no feedback,
	   and the primary CTA previously produced a computed-style delta of
	   exactly zero on hover when the OS flag was set. Only the transition
	   (the travel between states) is gated. */
	.pin-btn:hover {
		--lift: 0.55;
		translate: 1px 2px;
	}

	.pin-btn:active {
		--lift: 0.35;
		translate: 1px 3px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.pin-btn {
			transition:
				box-shadow var(--t-settle) var(--e-out),
				translate var(--t-settle) var(--e-out);
		}

		.pin-btn:active {
			transition:
				box-shadow var(--t-press) var(--e-out),
				translate var(--t-press) var(--e-out);
		}
	}
</style>
