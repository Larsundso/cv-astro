---
/**
 * Stamp — a small circular rubber stamp for dates and as-of marks.
 * Crimson stamp ink, darkened a step so small type holds 4.5:1 on cork.
 * sub sits above label: <Stamp sub="as of" label="2026-08-03" />
 */
interface Props {
	label: string;
	sub?: string;
	/** free rotation in degrees; stamps are hand-pressed */
	rotate?: number;
	class?: string;
}

const { label, sub, rotate = 0, class: className } = Astro.props;
---

<span class:list={["stamp", className]} style={`--stamp-rot:${rotate}deg;`}>
	{sub && <span class="stamp__sub">{sub}</span>}
	<span class="stamp__label">{label}</span>
</span>

<style>
	.stamp {
		/* Darkening the cork this cycle cost the stamps their footing: at the
		   old 85/15 mix the legend measured 3.82:1 on bare board, under the
		   4.5:1 floor for type this small. Pulling the mix toward --ink keeps
		   it unmistakably the stamp red while putting it back over the line
		   on cork AND on paper — a stamp overhangs its card, so it has to
		   pass on both. */
		--stamp-ink: color-mix(in oklab, var(--thread) 62%, var(--ink));
		position: relative;
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		width: var(--stamp-size, 6.5rem);
		aspect-ratio: 1;
		padding: var(--baseline);
		border: 2px solid var(--stamp-ink);
		border-radius: 50%;
		rotate: var(--stamp-rot, 0deg);
		color: var(--stamp-ink);
		font-family: var(--font-typed);
		font-weight: 700;
		text-transform: uppercase;
		text-align: center;
	}

	.stamp::before {
		content: "";
		position: absolute;
		inset: 3px;
		border: 1px solid var(--stamp-ink);
		border-radius: 50%;
	}

	/* Generous tracking at this size is characterisation, not error: it is
	   what type struck into rubber actually looks like. */
	.stamp__label {
		font-size: var(--step--2);
		letter-spacing: 0.06em;
		line-height: calc(var(--baseline) * 1.5);
		white-space: nowrap;
	}

	.stamp__sub {
		font-size: var(--step--2);
		letter-spacing: 0.14em;
		line-height: calc(var(--baseline) * 1.25);
	}
</style>
