---
/**
 * Timeline — Der Rote Faden itself.
 * Career and education as ONE chronological wall path: the crimson thread
 * runs from pin to pin, stitching index cards from 2010 to HEUTE.
 * Career entries come from wall.ts `timeline`; education entries join the
 * same thread as smaller cards. The two 2022-09 education records
 * (apprenticeship, vocational school) are already covered verbatim by the
 * apprenticeship and final-project career cards, so they are not repeated.
 *
 * WEIGHT, not metronome. Nine cards on an even left/right beat at one size
 * emphasise nothing, and by chronology the primacy slot falls to a 2010
 * secondary school while the IHK final project — the one artifact a German
 * hiring manager reads closely — sits at position 7 of 9, the serial-position
 * trough. The chronology is not touched (forward order IS the concept);
 * the SIZES are. Four tiers, one column each: education 5 columns, career 6,
 * Raleo 7, the IHK flagship 8 and centred. Two peaks and a close.
 */
import HandNote from "~/components/wall/HandNote.astro";
import InkKey from "~/components/wall/InkKey.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Stamp from "~/components/wall/Stamp.astro";
import Sticker from "~/components/wall/Sticker.astro";
import Thread from "~/components/wall/Thread.astro";
import { getWall, type Locale } from "~/data/i18n";
import { ihk } from "~/data/snapshot";
import type { EducationEntry, TimelineEntry } from "~/data/wall";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { education, projects, timeline, sectionStrings, ui } = getWall(locale);
const ts = sectionStrings.timeline;

/* ---- merge career + education into one chronological path --------- */

const FLAGSHIP_ID = "ihk-final-project-2025";
/* the second peak: the job the whole thread arrives at */
const PEAK_ID = "raleo-2025";

/* The one sticker this section carries. The 2019 row is a RIGHT card, so
   its whole left half is bare cork — the widest empty run on the wall,
   far outside the thread's corridor and on the opposite side from that
   row's date stamp. Artwork: the pixel-art Ayako, the lowest-resolution
   version of her, against the line that reads "Ayako begins as a single
   JavaScript file". */
const STICKER_ROW_ID = "start-2019";

/**
 * Education entries whose facts already appear verbatim on the
 * apprenticeship-2022 and ihk-final-project-2025 career cards
 * (training company, vocational school, track/DQR, final project).
 * They are not repeated as cards.
 *
 * Their org logos are not repeated either: /GSR.webp, /CI.webp and
 * /EST.webp were rendered at 24px in a white chip in the brass pin's
 * optical slot. Deleted, for three reasons. (1) At 24px none of the four
 * marks is legible — CI is a black field with sub-6px knockout type, EST
 * is line art with 4px type — so they carried no information, and every
 * org is named in the typed copy directly beneath. (2) Each brings its own
 * colour system onto a wall that has one: GSR is a glossy sphere with a red
 * that is not --thread, CI is pure #000 where the ink is a warm near-black.
 * A grayscale/multiply "photocopied letterhead" treatment would kill the
 * hues but keep the photographic modelling — a shaded sphere still reads as
 * a photograph on a wall lit by exactly one lamp. (3) The section's measured
 * defect is object count (26 objects at 30.7 % ink); five decorative marks
 * were the cheapest five to lose.
 */
const MERGED_EDUCATION_IDS = new Set(["apprenticeship", "est"]);

type Row =
	| { kind: "career"; sort: string; entry: TimelineEntry; flagship: boolean; peak: boolean }
	| { kind: "education"; sort: string; entry: EducationEntry };

const rows: Row[] = [
	...timeline.map((entry) => ({
		kind: "career" as const,
		sort: entry.sort,
		entry,
		flagship: entry.id === FLAGSHIP_ID,
		peak: entry.id === PEAK_ID
	})),
	...education
		.filter((entry) => !MERGED_EDUCATION_IDS.has(entry.id))
		.map((entry) => ({
			kind: "education" as const,
			sort: entry.start,
			entry
		}))
].sort((a, b) => a.sort.localeCompare(b.sort));

/* ---- layout: alternate sides and tilt around the spine ------------ */

type Side = "left" | "right" | "wide";

/** Hand-pressed stamp angles, deterministic per row. */
const STAMP_ROTATIONS = [-5, 4, -3, 6, -4, 3, -6, 4, -3, 5];

let flip = false;
const layout = rows.map((row, i) => {
	const flagship = row.kind === "career" && row.flagship;
	const peak = row.kind === "career" && row.peak;
	const side: Side = flagship ? "wide" : flip ? "right" : "left";
	if (!flagship) flip = !flip;
	const rotate: -1 | 0 | 1 = flagship ? 0 : side === "left" ? -1 : 1;
	return {
		row,
		side,
		peak,
		rotate,
		stampRotate: STAMP_ROTATIONS[i % STAMP_ROTATIONS.length] ?? 0
	};
});

/* ---- dates ---------------------------------------------------------- */

const year = (isoish: string) => isoish.slice(0, 4);
const eduStampLabel = (e: EducationEntry) =>
	e.end && year(e.end) !== year(e.start) ? `${year(e.start)}–${year(e.end)}` : year(e.start);
const eduDates = (e: EducationEntry) => (e.end ? `${e.start} – ${e.end}` : ts.since(e.start));

/* ---- flagship extras: perf + scope from the data layer ------------- */

const dashboard = projects.find((p) => p.id === "discord-bot-dashboard");
const perf = ihk.finalProject.performance;
const perfLine = ts.perfLine(
	`${perf.initialLoad} · ${perf.serverSwitch} · ${perf.cacheHitRate} · ${perf.fps}`
);
const repoLink = dashboard?.links[0];

/* ---- thread geometry ------------------------------------------------ */
/* CARD TO CARD (owner decision, 2026-08-04): the thread runs in ONE
   straight line from each card's brass pin to the next card's pin — no
   spine, no bare corners; every direction change happens exactly at a
   pin, hidden under its head. Each row emits its OUTGOING connector: an
   absolutely positioned strip spanning the two pin x-positions
   (desktop: 50%±152px; the wide flagship uses the left pin), whose SVG
   draws a corner-to-corner line. Corner-to-corner endpoints survive the
   strip's responsive stretch exactly (preserveAspectRatio="none",
   non-scaling stroke), so the line stays registered on both pins at any
   width. Stretched SVGs cannot dash-draw reliably in Chromium, so
   connectors render fully drawn (draw={false}).
   The corridor is ±152px, not ±76: the pin must sit a stamp's width clear
   of the card corner the date stamp is now pressed onto, and the wider
   swing doubles the thread's horizontal excursion across the career.
   Mobile: every pin sits at x=64px, so connectors are plain vertical
   2.5px divs; the exit still needs an SVG to reach the wall-run spine.
   The last row exits toward the wall-run line (50% desktop / 48px
   mobile) — the single junction on the wall not covered by a pin. */

type PinX = "L" | "R";
const pinX = (side: Side): PinX => (side === "right" ? "R" : "L");

const links = layout.map(({ side }, i) => {
	const from = pinX(side);
	const next = layout[i + 1];
	return {
		from,
		to: next ? pinX(next.side) : null,
		isLast: !next
	};
});
---

<section class="rf-timeline" aria-labelledby="werdegang">
	<div class="wall-max">
		<header class="rf-head">
			<span class="rf-line rf-line--full" aria-hidden="true"></span>
			<div class="rf-headwrap">
				<PinCard variant="flyer" rotate={-1}>
					<h2 id="werdegang" lang="de">{ui.nav.werdegang}</h2>
					<svg class="rf-headrule" viewBox="0 0 150 8" aria-hidden="true">
						<path
							d="M 3 6 C 40 2 70 9 146 4"
							fill="none"
							stroke="var(--thread)"
							stroke-width="2.4"
							stroke-linecap="round"></path>
					</svg>
					<p class="rf-headdates" lang="de">2010 – heute</p>
				</PinCard>
			</div>
			<div class="rf-scrap rf-headscrap pinned" style="--tilt:1;">
				<HandNote ink="teal">{ts.headNote}</HandNote>
			</div>

			{/*
			  The key DECLARES the code here and CONFIRMS it again in Practice.
			  It used to appear only in Practice, at 85% of the page — after 21
			  of the 23 ink-coded notes it explains, four of which are in the
			  first viewport. A code whose key arrives last reads as decoration,
			  which is exactly what every blind judge called it. This is the
			  first bare cork wide enough to carry it.
			*/}
			<div class="rf-headkey">
				<InkKey id="timeline-ink-key" rotate={-1} />
			</div>
		</header>

		<ol class="rf-rows" role="list">
			{
				layout.map(({ row, side, peak, rotate, stampRotate }, i) => {
					const edu = row.kind === "education";
					const flagship = row.kind === "career" && row.flagship;
					const annotation = row.kind === "career" ? row.entry.annotation : undefined;
					const link = links[i];
					return (
						<li
							id={row.entry.id}
							class:list={[
								"rf-row",
								`rf-row--${side}`,
								edu && "rf-row--edu",
								peak && "rf-row--peak",
								flagship && "rf-row--flagship"
							]}
						>
							{/* outgoing thread: straight to the next card's pin */}
							{!link.isLast && link.from !== link.to && (
								<div class="rf-stitch rf-stitch--span" aria-hidden="true">
									<Thread
										path={link.from === "L" ? "M 0 0 L 100 100" : "M 100 0 L 0 100"}
										width={100}
										height={100}
										draw={false}
									/>
								</div>
							)}
							{!link.isLast && link.from === link.to && (
								<span
									class:list={["rf-stitch", "rf-stitch--vert", `rf-stitch--vert-${link.from.toLowerCase()}`]}
									aria-hidden="true"
								/>
							)}
							{!link.isLast && <span class="rf-stitch rf-stitch--m" aria-hidden="true" />}
							{link.isLast && (
								<>
									<div
										class:list={["rf-stitch", "rf-stitch--exit", `rf-stitch--exit-${link.from.toLowerCase()}`]}
										aria-hidden="true"
									>
										<Thread
											path={link.from === "L" ? "M 0 0 L 100 100" : "M 100 0 L 0 100"}
											width={100}
											height={100}
											draw={false}
										/>
									</div>
									<div class="rf-stitch rf-stitch--exit-m" aria-hidden="true">
										<Thread path="M 100 0 L 0 100" width={100} height={100} draw={false} />
									</div>
								</>
							)}
							<span class="brass-pin rf-pin" aria-hidden="true" />
							{row.entry.id === STICKER_ROW_ID && (
								<span class="rf-sticker" aria-hidden="true">
									<Sticker name="pixel" size={4.25} rotate={-7} />
								</span>
							)}
							<div class="rf-cardwrap">
								<span class="rf-stampwrap">
									<Stamp
										label={row.kind === "career" ? row.entry.dateLabel : eduStampLabel(row.entry)}
										sub={flagship ? "IHK" : undefined}
										rotate={stampRotate}
									/>
								</span>
								<PinCard as="article" variant="typed" rotate={rotate} pin={false}>
									{row.kind === "career" ? (
										<>
											<h3>{row.entry.title}</h3>
											{row.entry.body.map((paragraph) => (
												<p>{paragraph}</p>
											))}
											{flagship && (
												<>
													<p>{perfLine}</p>
													{dashboard && (
														<p>
															{ts.stackLabel} {dashboard.stack.join(" · ")}.
														</p>
													)}
													{repoLink && (
														<p>
															<a class="rf-link" href={repoLink.href}>
																{repoLink.label}
															</a>
														</p>
													)}
												</>
											)}
										</>
									) : (
										<>
											<h3>{row.entry.institution}</h3>
											<p class="rf-dates">{eduDates(row.entry)}</p>
											{row.entry.detail && <p>{row.entry.detail}</p>}
										</>
									)}
								</PinCard>
								{annotation && (
									<div class="rf-scrap pinned" style={`--tilt:${-rotate};`}>
										<HandNote ink={annotation.ink}>{annotation.text}</HandNote>
									</div>
								)}
							</div>
						</li>
					);
				})
			}
		</ol>
	</div>
</section>

<style>
	/* ---- the thread: straight card-to-card connectors ---------------- */
	/* Pin centers: y = 44px from row top (pin top 37px + 7px radius);
	   x = 64px on mobile, 50%∓152px on desktop. Connectors span pin to
	   pin: top: 44px into bottom: -44px reaches exactly the NEXT row's
	   pin center (rows stack without gaps).
	   z-index: -1, inside the `main { isolation: isolate }` context: a
	   thread runs BEHIND paper and surfaces only on bare cork. At z-index 3
	   it painted OVER the sheets it passes under — a thread puncturing
	   paper — on 8 of 9 rows, by 37–39px each. */

	.rf-stitch {
		position: absolute;
		top: 44px;
		bottom: -44px;
		z-index: -1;
		pointer-events: none;
	}

	.rf-stitch :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* stretched viewBoxes: Chromium mis-normalizes dasharray under
	   non-scaling-stroke, so the connectors drop the dash entirely and
	   render fully drawn (same rule as the section joins) */
	.rf-stitch :global(.thread-path) {
		stroke-dasharray: none;
	}

	/* mobile: all pins share x = 64px — plain vertical thread */
	.rf-stitch--m {
		left: calc(64px - 1.25px);
		width: 2.5px;
		border-radius: 2px;
		background: var(--thread);
	}

	/* mobile exit: diagonal from the pin (x 64) to the wall-run spine (x 48) */
	.rf-stitch--exit-m {
		left: 48px;
		right: calc(100% - 64px);
		bottom: -80px;
	}

	/* desktop variants activate at 48rem (see media block below) */
	.rf-stitch--span,
	.rf-stitch--vert,
	.rf-stitch--exit {
		display: none;
	}

	/* the header's entry line: drops vertically from the section top,
	   through the header, straight into the FIRST card's pin — the
	   stitch-join above lands on the same x, so entry has no corner */
	.rf-line {
		position: absolute;
		top: 0;
		bottom: -44px;
		left: calc(64px - 1.25px);
		width: 2.5px;
		border-radius: 2px;
		background: var(--thread);
		z-index: -1;
		pointer-events: none;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			.rf-line {
				transform-origin: top;
				animation: rf-line-grow linear both;
				animation-timeline: view();
				animation-range: cover 0% cover 40%;
			}
		}
	}

	@keyframes rf-line-grow {
		from {
			scale: 1 0;
		}

		to {
			scale: 1 1;
		}
	}

	/* ---- header ------------------------------------------------------ */

	.rf-head {
		position: relative;
		padding-block: calc(var(--baseline) * 4);
	}

	.rf-headwrap {
		position: relative;
		z-index: 1;
		width: fit-content;
		margin-left: calc(var(--baseline) * 5);
	}

	/* the flyer h2 is PinCard's --step-5; nothing to re-declare here */

	.rf-headrule {
		display: block;
		width: 9rem;
		margin-top: calc(var(--baseline) * 0.5);
	}

	/* dateline: the same step and the same display tracking as every other
	   dateline on the wall. Was 1.25rem / 0.08em, a size and a track that
	   existed nowhere else. */
	.rf-headdates {
		margin: calc(var(--baseline)) 0 0;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		letter-spacing: var(--track-display);
	}

	.rf-headscrap {
		margin-top: calc(var(--baseline) * 2);
		margin-left: calc(var(--baseline) * 8);
	}

	/* The key sits in the header's right-hand cork, opposite the flyer.
	   Absolute so it never becomes a row and never shifts the thread's
	   entry pin. Only shown where there is genuinely room for a 19rem slip
	   beside a display headline — below that it would crowd the marquee,
	   and the Practice instance still teaches the code. */
	.rf-headkey {
		display: none;
	}

	@media (min-width: 64rem) {
		.rf-headkey {
			display: block;
			position: absolute;
			top: calc(var(--baseline) * 4);
			right: 0;
			z-index: 1;
		}
	}

	/* ---- rows -------------------------------------------------------- */

	.rf-rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* --stamp-size lives on the row, not on the stamp wrapper: the card's
	   title reads it to compute its own clearance, so the stamp can never
	   grow into the type by accident. */
	.rf-row {
		--stamp-size: 6rem;
		--stamp-overhang: 16px;
		/* the ring hangs a little further off the top edge than off the
		   side: it lifts the circle's lower arc clear of the first body
		   line, which on a tilted card rises up to 7px toward it at the
		   card's right end. Horizontal clearance is bought with type
		   inset, vertical clearance is bought here. */
		--stamp-rise: 28px;
		position: relative;
		padding-block: calc(var(--baseline) * 4);
	}

	.rf-pin {
		position: absolute;
		z-index: 4;
		top: 37px;
		left: 57px;
	}

	.rf-cardwrap {
		position: relative;
		z-index: 1;
		margin-left: calc(var(--baseline) * 5);
	}

	/* ---- stamps ------------------------------------------------------ */
	/* A date stamp belongs to the card it dates. These were parked in a
	   190px strip down each flank at x 85–187 / 1251–1357, ~50px clear of
	   any paper — a caption separated from its object and the sole tenant
	   of the two dead columns. Now pressed onto the card's own top-right
	   corner with --stamp-overhang of ring hanging off the edge: rubber on
	   paper is correct for the material, rubber on glyphs is not, which is
	   what the title's padding below guarantees. */

	.rf-stampwrap {
		position: absolute;
		z-index: 2;
		top: calc(var(--stamp-rise) * -1);
		right: calc(var(--stamp-overhang) * -1);
	}

	/* The stamp's own caps are Stamp.astro's business: --step--2 exists in
	   the ladder for exactly one thing, type struck into rubber, and the
	   generous track that goes with it is characterisation. Nothing to
	   re-declare here — only the ring's size, which the title reads. */

	/* ---- cards: typed material on the 24px ruling -------------------- */

	.rf-cardwrap h3 {
		margin: 0;
		font-size: var(--step-1);
		/* every line inside a ruled card sits on the card's own 24px
		   ruling, so a title takes the 24px leading whatever its step —
		   any other value throws the whole sheet off its rules. */
		line-height: var(--lh-1);
		font-weight: 700;
		/* the flagship's title is the longest on the wall and sets two
		   lines; unbalanced it dropped »Bots« alone on the second */
		text-wrap: balance;
		/* exact clearance from the corner stamp: the part of the ring that
		   is ON the paper, plus the card's own padding, plus a baseline. */
		padding-right: calc(var(--stamp-size) - var(--stamp-overhang) - var(--baseline));
	}

	/* the two peaks — the IHK final project and the job it led to */
	.rf-row--peak .rf-cardwrap h3,
	.rf-row--flagship .rf-cardwrap h3 {
		font-size: var(--step-2);
	}

	/* Narrow cards: a 96px ring inset from a 272px card leaves a ten-
	   character measure, and Courier does not break "Apprenticeship".
	   Below 30rem the ring drops a step and rides half off the corner, so
	   its lower arc stops ABOVE the card's first ruled line — no vertical
	   overlap with type is possible at all, and the title takes the whole
	   measure back. */
	@media (max-width: 30rem) {
		.rf-row {
			--stamp-size: 5rem;
			--stamp-rise: 40px;
		}

		.rf-cardwrap h3 {
			padding-right: 0;
		}
	}

	.rf-cardwrap p {
		margin: 0;
	}

	.rf-cardwrap h3 + p,
	.rf-cardwrap p + p {
		margin-top: calc(var(--baseline) * 3);
	}

	/* education dateline: subordinate size, card leading — a step down in
	   size may never be a step off the ruling */
	.rf-cardwrap .rf-dates {
		margin-top: 0;
		font-size: var(--step--1);
		line-height: var(--lh-0);
	}

	.rf-link {
		color: var(--ink);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--thread);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
	}

	.rf-link:hover {
		text-decoration-thickness: 2.5px;
	}

	/* ---- handwritten scraps (paper, so every ink holds 4.5:1) -------- */

	.rf-scrap {
		width: fit-content;
		max-width: min(100%, 26rem);
		background: var(--paper);
		box-shadow: var(--pin-shadow);
		padding: var(--baseline) calc(var(--baseline) * 1.5);
		font-size: var(--step--1);
	}

	.rf-cardwrap .rf-scrap {
		margin-top: calc(var(--baseline) * -1);
		margin-left: calc(var(--baseline) * 3);
	}

	/* ---- sticker ----------------------------------------------------- */
	/* Below 48rem every card runs the full width beside the thread and the
	   only bare strip left is the 40px the thread itself occupies — there
	   is no cork to spare, so the sticker is desktop-only. */

	.rf-sticker {
		display: none;
	}

	/* ---- desktop: the 12-column armature ----------------------------- */
	/* The section used to run its own `minmax(0,1fr) 15rem minmax(0,1fr)` —
	   a second geometry on a wall that claims one. It produced 544/352/736
	   card widths where the column spans are 588/384/690, every card off by
	   28–46px and off the column starts by up to 28px. Same twelve tracks
	   and the same 24px gutter as .wall-grid now, spanning whole columns:
	   Projects and Telemetry sit at error 0 and this section matches them.
	   The four widths are four whole column counts — 5 / 6 / 7 / 8 — so the
	   emphasis ladder is measured in columns, not in taste. */

	@media (min-width: 48rem) {
		.rf-stitch--m,
		.rf-stitch--exit-m {
			display: none;
		}

		.rf-stitch--span {
			display: block;
			left: calc(50% - 152px);
			right: calc(50% - 152px);
		}

		.rf-stitch--vert {
			display: block;
			width: 2.5px;
			border-radius: 2px;
			background: var(--thread);
		}

		.rf-stitch--vert-l {
			left: calc(50% - 152px - 1.25px);
		}

		.rf-stitch--vert-r {
			left: calc(50% + 152px - 1.25px);
		}

		/* exit: from the last card's pin to the wall-run spine at 50% */
		.rf-stitch--exit {
			display: block;
			bottom: -80px;
		}

		.rf-stitch--exit-l {
			left: calc(50% - 152px);
			right: 50%;
		}

		.rf-stitch--exit-r {
			left: 50%;
			right: calc(50% - 152px);
		}

		/* the entry line lands on the first card's pin x (a LEFT row) */
		.rf-line {
			left: calc(50% - 152px - 1.25px);
		}

		.rf-head,
		.rf-row {
			display: grid;
			grid-template-columns: repeat(12, minmax(0, 1fr));
			column-gap: calc(var(--baseline) * 3);
		}

		.rf-row {
			--stamp-overhang: 20px;
		}

		.rf-row--flagship {
			--stamp-size: 7.5rem;
		}

		.rf-headwrap {
