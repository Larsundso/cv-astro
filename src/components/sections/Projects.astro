---
/**
 * Projects — the projects wall.
 *
 * THE MATERIAL LAW, APPLIED. The four faces each mean a physical thing, and
 * until now the section assigned them by accident: Ayako and Kiyu were typed
 * while Ayako v3 and GIFfer were printed — the same kind of content in two
 * materials, with no rule a reader could infer. The rule the law was missing:
 *
 *   a typewriter produced the RECORD, a printer produced the ESSAY.
 *
 *   variant="print"  an artifact whose body is continuous writing — Ayako's
 *                    account, the authorship proof, the v3 rewrite, Kiyu,
 *                    GIFfer, the VR bench entries.
 *   variant="typed"  an artifact that is nothing but record — Ayako's spec
 *                    sheet (figure list, stack, licence) and the "Also
 *                    pinned" index. Courier stays clipped, dated, factual.
 *   variant="flyer"  poster statements only: the section headline, the
 *                    free-forever promise, the bench heading.
 *   HandNote         the hand, in the margins, never body copy.
 *
 * One face per artifact, always — where a project needs both voices it gets
 * two sheets (Ayako: the printed account, the typed spec sheet beside it),
 * never two faces on one sheet.
 *
 * ── THE ROUTE, NOT THE BOARD ────────────────────────────────────────────
 * Ten hiring judges read the whole page for the first time and said this
 * section "sprawls", that its reading order was "a guess rather than a
 * path". It was measurable: sorted down the board, consecutive artifacts sat
 * a median of 612px apart horizontally and six of twelve hand-overs threw
 * the eye more than 600px — the section alternated left/right on EVERY
 * single card, because two equally tall columns start at the same height.
 *
 * So the collage is now a STAIRCASE. Five stops, each one a stack the eye
 * reads straight down before it crosses once:
 *
 *   1  left    the headline, then the photograph
 *   2  right   all of Ayako on paper — account, proof, spec sheet, v3
 *   3  right→  the free-forever promise closes that stack, and Kiyu opens
 *      left    the next one BESIDE it, one --stagger lower, never level
 *   4  left    GIFfer, then right the VR bench: flyer and sheet
 *   5  right   the sketch, then left the typed index
 *
 * Two mechanics carry it, and both are in the grid rules at the bottom:
 * a stop and the stop that follows it share ONE grid row, so the new stack
 * begins alongside the tail of the old one instead of below it (the section
 * keeps its density — this is not a whitespace fix); and the incoming stack
 * is pushed down by --stagger so its first sheet can never sit level with
 * the sheet it takes over from. Level means "cross here", and there are now
 * exactly four places on the whole section where that is true.
 *
 * The two lanes of any shared row are column-disjoint — that is what makes
 * the overlap safe — and no hand-over spans more than 561px at 1440, which
 * is why one lane always gives up its outermost column, alternating sides
 * down the board so no dead strip forms on either flank.
 *
 * The red thread is computed at runtime from the laid-out pin centres, so
 * it traces this order exactly: down, across, down, across.
 *
 * All copy comes from ~/data/wall — every figure carries unit + as-of date.
 * Nothing here restates a figure; it only decides where the figure sits.
 */
import HandNote from "~/components/wall/HandNote.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Polaroid from "~/components/wall/Polaroid.astro";
import Stamp from "~/components/wall/Stamp.astro";
import Sticker from "~/components/wall/Sticker.astro";
import { getWall, type Locale } from "~/data/i18n";
import { SNAPSHOT_AS_OF } from "~/data/snapshot";
import VrHeadsetSketch from "./VrHeadsetSketch.svelte";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { breadth, projects, sectionStrings, ui } = getWall(locale);
const ps = sectionStrings.projects;

const byId = (id: string) => {
	const entry = projects.find((p) => p.id === id);
	if (!entry) throw new Error(`Projects.astro: missing project "${id}" in ~/data/wall`);
	return entry;
};

const ayako = byId("ayako");
const kiyu = byId("kiyu");
const giffer = byId("giffer");
const vrTools = projects.filter((p) => p.role === "vr");

/* Ayako's fact list splits three ways, in the data's own order:
   the last line belongs to the v3 rewrite card, the one before it is the
   authorship proof that gets its own sheet, and the rest are the spec. */
const v3Fact = ayako.facts.at(-1);
const proofFact = ayako.facts.at(-2);
const specFacts = ayako.facts.slice(0, -2);
const [ayakoBody, v3Body] = ayako.body;

/* The proof sheet is titled with its own figure. Both locales open the line
   with the percentage, so the split is a cut, never a rewrite — no digit,
   date or word is changed, and an unexpected shape falls back to the whole
   line as the title. */
const proofParts = proofFact?.match(/^([\d.,]+\s*%)\s*(.*)$/s);
const proofFigure = proofParts ? proofParts[1].trim() : proofFact;
const proofRest = proofParts ? proofParts[2] : "";

/* "Also pinned" is a long tail: two entries earn the sheet, three are
   available rather than unavoidable. Every breadth line is
   "Name — description", so the folded names make the disclosure label
   out of the entries' own words. */
const nameOf = (text: string) => text.split(" — ")[0];
const KEEP = ["lars-dev.org", "vr-diag"];
const shown = breadth.filter((item) => KEEP.includes(nameOf(item.text)));
const pinnedShown = shown.length ? shown : breadth;
const pinnedFolded = shown.length ? breadth.filter((item) => !shown.includes(item)) : [];
const foldedNames = pinnedFolded.map((item) => nameOf(item.text)).join(" · ");
---

<section id="projects" class="projects wall-max" aria-labelledby="projects-title">
	<div class="wall-grid projects-grid">
		<!-- STOP 1 · left — section headline: flyer + as-of stamp -->
		<div class="g-head">
			<PinCard variant="flyer" class="head-card">
				<h2 id="projects-title"><span class="head-rule">{ui.nav.projects}</span></h2>
			</PinCard>
			<Stamp sub={sectionStrings.asOfStamp} label={SNAPSHOT_AS_OF} rotate={-7} class="head-stamp" />
		</div>

		<!-- …and the photograph, which is the tail of stop 1: the Ayako papers
		     start beside it, one --stagger lower, and run down the right. -->
		<Polaroid class="g-photo" rotate={-1} caption={`${ayako.name} — ${ayako.oneLiner}`}>
			<img
				src={ayako.logo ?? "/Ayako.webp"}
				alt={ps.ayakoAlt}
				width="800"
				height="900"
				loading="lazy"
				decoding="async"
			/>
		</Polaroid>

		<!-- STOP 2 · right — the whole of Ayako on paper, in argument order:
		     the account, the one figure that proves "solo" is not a manner of
		     speaking, the typed spec sheet, and the v3 rewrite. -->
		<div class="g-ayako col-stack">
			<PinCard variant="print" as="article" rotate={1} class="card-flow">
				<h3 class="card-title">{ayako.name}</h3>
				<p>{ayakoBody}</p>
				<ul class="links" role="list">
					{ayako.links.map((link) => (
						<li><a href={link.href}>{link.label}</a></li>
					))}
				</ul>
			</PinCard>
			{
				proofFact && (
					<PinCard variant="print" as="article" rotate={-1} class="proof-card">
						<p class="proof-figure">{proofFigure}</p>
						{proofRest && <p class="proof-rest">{proofRest}</p>}
					</PinCard>
				)
			}
			<PinCard variant="typed" as="article" rotate={1} class="spec-card card-flow">
				<ul class="facts" role="list">
					{specFacts.map((fact) => <li>{fact}</li>)}
				</ul>
				<p class="stack">{ayako.stack.join(" · ")}</p>
				{ayako.license && <p class="license">{ps.licenseLabel} {ayako.license}</p>}
			</PinCard>
			{
				ayako.annotation && (
					<HandNote ink={ayako.annotation.ink} class="note-slip pull-right">
						{ayako.annotation.text}
					</HandNote>
				)
			}
			<PinCard variant="print" as="article" rotate={-1} class="card-flow">
				<h3 class="card-title">{ps.v3Title}</h3>
				<p>{v3Body}</p>
				{v3Fact && <p class="fact-line">{v3Fact}</p>}
			</PinCard>
		</div>

		<!-- STOP 3 · right — the promise closes the Ayako stack -->
		<div class="g-promise col-stack">
			{
				ayako.promise && (
					<PinCard variant="flyer" rotate={1} class="promise-card">
						<blockquote>
							<p>“{ayako.promise}”</p>
						</blockquote>
					</PinCard>
				)
			}
			{
				ayako.promiseNote && (
					<HandNote ink="green" class="note-slip">{ayako.promiseNote}</HandNote>
				)
			}
		</div>

		<!-- STOP 3 · left — Kiyu opens the left stack beside that promise.
		     Printed like GIFfer, because it is the same kind of page. The
		     amber caveat stays exactly as written — labelling your own
		     weakest number is the point of it. -->
		<div class="g-kiyu col-stack">
			<PinCard variant="print" as="article" rotate={-1} class="card-flow">
				<h3 class="card-title">{kiyu.name}</h3>
				<p>{kiyu.oneLiner}</p>
				{kiyu.body.map((paragraph) => <p>{paragraph}</p>)}
				{kiyu.facts.map((fact) => <p class="fact-line">{fact}</p>)}
				<p class="stack">{kiyu.stack.join(" · ")}</p>
			</PinCard>
			{
				kiyu.annotation && (
					<HandNote ink={kiyu.annotation.ink} class="note-slip pull-right">
						{kiyu.annotation.text}
					</HandNote>
				)
			}
		</div>

		<!-- STOP 4 · left — GIFfer closes the left stack -->
		<PinCard variant="print" as="article" rotate={1} class="g-giffer card-flow">
			<h3 class="card-title">{giffer.name}</h3>
			<p>{giffer.oneLiner}</p>
			{giffer.body.map((paragraph) => <p>{paragraph}</p>)}
			{giffer.facts.map((fact) => <p class="fact-line">{fact}</p>)}
			<p class="stack">{giffer.stack.join(" · ")}</p>
			{giffer.license && <p class="license">{ps.licenseLabel} {giffer.license}</p>}
		</PinCard>

		<!-- STOP 4 · right — the VR bench: one sheet for four small tools.
		     Each entry shows its name and its one line; the LOC, the test
		     suites and the stacks are one click away rather than four cards
		     deep. -->
		<div class="g-vrbench col-stack">
			<PinCard variant="flyer" class="vrhead-card">
				<h3 class="bench-flyer">{ps.vrBenchTitle}</h3>
			</PinCard>
			<PinCard variant="print" as="article" rotate={-1} class="bench-card">
				<ul class="bench" role="list">
					{
						vrTools.map((tool) => (
							<li>
								<details class="fold">
									<summary>
										<b class="bench-name">{tool.name}</b> — {tool.oneLiner}
									</summary>
									<div class="fold-body">
										{tool.body.map((paragraph) => <p>{paragraph}</p>)}
										{tool.facts.map((fact) => <p class="fact-line">{fact}</p>)}
										<p class="stack">{tool.stack.join(" · ")}</p>
									</div>
								</details>
							</li>
						))
					}
				</ul>
			</PinCard>
		</div>

		<!-- STOP 5 · right — the one object on the wall that answers a hand:
		     given the room to be picked up, and captioned with what it
		     actually is. It closes the right-hand stack. -->
		<div class="g-vrsketch col-stack">
			<Polaroid class="vr-polaroid" rotate={1} caption={ps.vrSketchCaption}>
				<VrHeadsetSketch ariaLabel={ps.vrSketchAria} client:visible />
			</Polaroid>
			<HandNote ink="teal" class="note-slip">{ps.vrBenchNote}</HandNote>
		</div>

		<!-- STOP 5 · left — breadth: the typed index, with its tail folded -->
		<PinCard variant="typed" as="aside" rotate={1} class="g-breadth card-flow">
			<h3 class="card-title">{ps.breadthTitle}</h3>
			<ul class="facts" role="list">
				{
					pinnedShown.map((item) => (
						<li>
							{item.text}
							{item.link && <> <a href={item.link.href}>{item.link.label}</a></>}
						</li>
					))
				}
			</ul>
			{
				pinnedFolded.length > 0 && (
					<details class="fold fold--tail">
						<summary>{foldedNames}</summary>
						<ul class="facts" role="list">
							{pinnedFolded.map((item) => (
								<li>
									{item.text}
									{item.link && <> <a href={item.link.href}>{item.link.label}</a></>}
								</li>
							))}
						</ul>
					</details>
				)
			}
			<Sticker name="peek" size={4.5} rotate={-7} class="tail-sticker" />
		</PinCard>
	</div>
</section>

<style>
	/* NOTE on scoping: Astro's attribute scoping never reaches classes
	   passed to child components (PinCard/Polaroid/Stamp/HandNote roots),
	   so those rules run through `.projects :global(...)` — still fenced
	   by the section root. Slot content is authored here and stays scoped. */

	/* collage: cards keep their natural height, the hidden grid organizes */
	.projects-grid {
		/* the drop that keeps a hand-over from ever being level. An incoming
		   stack starts this far below the tail sheet it takes over from, so
		   the board is read down-then-across and never across-then-down. */
		--stagger: calc(var(--baseline) * 12);
		align-items: start;
	}

	/* ---- the staircase ------------------------------------------------ */
	/* Five stops, five grid rows, and each stop shares its FIRST row with
	   the tail of the stop before it — that shared row is the whole reason
	   the section stays as dense as a two-column collage while reading as
	   one line. The two lanes of a shared row never share a column, so the
	   overlap can never become a collision; and the lane that would reach
	   the board's edge gives up its outermost column, alternating sides, so
	   every hand-over stays under 600px and no flank goes dead. */

	.g-head {
		grid-row: 1;
		grid-column: 1 / 7;
		position: relative;
	}
	.projects :global(.g-photo) {
		grid-row: 2;
		grid-column: 1 / 6;
	}
	.g-ayako {
		grid-row: 2;
		grid-column: 6 / 12;
		margin-top: var(--stagger);
	}
	.g-promise {
		grid-row: 3;
		grid-column: 7 / 12;
	}
	.g-kiyu {
		grid-row: 3;
		grid-column: 1 / 7;
		margin-top: var(--stagger);
	}
	.projects :global(.g-giffer) {
		grid-row: 4;
		grid-column: 2 / 7;
	}
	.g-vrbench {
		grid-row: 4;
		grid-column: 7 / 13;
		margin-top: var(--stagger);
	}
	.g-vrsketch {
		grid-row: 5;
		grid-column: 7 / 13;
	}
	.projects :global(.g-breadth) {
		grid-row: 5;
		grid-column: 2 / 7;
		margin-top: var(--stagger);
	}

	/* every column that stacks more than one artifact does it the same way:
	   one gap, set from the baseline, no per-artifact margins */
	.col-stack {
		display: grid;
		row-gap: calc(var(--baseline) * 3);
		align-content: start;
	}

	/* inside a stack the sheets are not a ruled column of identical slabs:
	   the proof sheet is filed a little in from the left of the account
	   above it and the spec sheet a little in from the right, which is how
	   paper actually stacks. Both stay inside the stack's own lane, so the
	   eye never leaves the route — the widest of these steps is 56px. */
	.projects :global(.proof-card) {
		margin-inline-start: calc(var(--baseline) * 8);
	}
	.projects :global(.spec-card) {
		margin-inline-end: calc(var(--baseline) * 6);
	}
	.projects :global(.vrhead-card) {
		margin-inline-end: calc(var(--baseline) * 10);
	}

	@media (max-width: 48rem) {
		/* one column, and the staircase collapses into the source order it
		   was written in — which is already the reading order */
		.projects-grid {
			--stagger: 0px;
		}

		.g-head,
		.g-ayako,
		.g-promise,
		.g-kiyu,
		.g-vrbench,
		.g-vrsketch,
		.projects :global(.g-photo),
		.projects :global(.g-giffer),
		.projects :global(.g-breadth) {
			grid-row: auto;
			grid-column: 1 / -1;
		}

		.projects :global(.proof-card),
		.projects :global(.spec-card),
		.projects :global(.vrhead-card) {
			margin-inline: 0;
		}
	}

	/* headline flyer + stamp: the flyer takes --step-5 from PinCard */
	.head-rule {
		border-bottom: 4px solid var(--thread);
	}
	.projects :global(.head-stamp) {
		--stamp-size: 5.5rem;
		position: absolute;
		right: calc(var(--baseline) * -2);
		top: calc(var(--baseline) * -3);
	}
	@media (max-width: 48rem) {
		.projects :global(.head-stamp) {
			right: 0;
		}
	}

	/* card interiors: spacing between slotted children; the brass pin is
	   PinCard's first child, so its follower resets to no extra margin */
	.projects :global(.card-flow > * + *) {
		margin-top: calc(var(--baseline) * 3);
	}
	.projects :global(.card-flow > .brass-pin + *) {
		margin-top: 0;
	}

	/* the print-out reads on the ladder too — without this it inherits the
	   document's 1rem and drifts off the scale at small widths */
	.projects :global(.pin-card--print) {
		font-size: var(--step-0);
		line-height: var(--lh-0);
	}

	.card-title {
		font-size: var(--step-1);
		line-height: var(--lh-1);
		font-weight: 700;
	}

	.facts {
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: var(--step-0);
		line-height: var(--lh-0);
	}
	.facts > li {
		padding-left: 1.4ch;
		text-indent: -1.4ch;
	}
	.facts > li::before {
		content: "— ";
		color: var(--ink-soft);
	}
	/* a whole ruling period, so a typed sheet stays registered to its lines */
	.facts > li + li {
		margin-top: calc(var(--baseline) * 3);
	}

	.stack,
	.license {
		color: var(--ink-soft);
		font-size: var(--step--1);
		line-height: var(--lh--1);
	}
	.fact-line {
		font-size: var(--step--1);
		line-height: var(--lh--1);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--baseline) calc(var(--baseline) * 3);
		list-style: none;
		margin: 0;
		padding: 0;
		font-weight: 700;
	}
	.links a,
	.facts a {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-color: var(--thread);
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}
	.links a:hover,
	.facts a:hover {
		color: var(--thread);
	}

	/* the authorship proof: the figure IS the title. Atkinson bold at
	   --step-3 outranks every card title on the wall and still cannot be
	   confused with League Gothic at --step-4 above it — different cap
	   height, different material, no optical tie. */
	.proof-figure {
		margin: 0;
		font-size: var(--step-3);
		line-height: var(--lh-3);
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}
	.proof-rest {
		margin: calc(var(--baseline) * 1) 0 0;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink-soft);
	}

	/* the free-forever promise: poster stock, headline type only */
	.g-promise blockquote {
		margin: 0;
	}
	.g-promise blockquote p {
		margin: 0;
		font-size: var(--step-4);
		line-height: var(--lh-4);
		letter-spacing: var(--track-display-lg);
	}

	/* handwritten margin notes ride on small paper slips so every pride
	   ink keeps >=4.5:1 (green/violet/blue do not clear raw cork) */
	.projects :global(.note-slip) {
		width: fit-content;
		max-width: 38ch;
		padding: calc(var(--baseline) * 1.5) calc(var(--baseline) * 2);
		background: var(--paper);
		box-shadow: var(--pin-shadow);
		font-size: var(--step-0);
		line-height: var(--lh-0);
	}
	.projects :global(.pull-right) {
		justify-self: end;
	}

	/* the bench heading is a poster, but a smaller one than the section
	   flyer — one step down, same face, so rank is never in question */
	.g-vrbench .bench-flyer {
		font-size: var(--step-4);
		line-height: var(--lh-4);
		letter-spacing: var(--track-display-lg);
	}

	/* four tools, one sheet. The name and its one line are the affordance;
	   LOC, tests and stack open underneath — nothing is deleted, it is
	   simply no longer unavoidable. */
	.bench {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.bench > li + li {
		margin-top: calc(var(--baseline) * 2);
		border-top: 1px solid color-mix(in oklab, var(--ink) 15%, transparent);
		padding-top: calc(var(--baseline) * 2);
	}
	.bench-name {
		font-weight: 700;
	}

	/* the disclosure triangle hangs in the margin like the "— " of a fact
	   list, so a wrapped entry aligns under its own first word */
	.fold {
		margin-inline-start: 1.5em;
	}
	.fold > summary {
		cursor: pointer;
		list-style-position: outside;
	}
	.fold > summary:hover {
		color: var(--thread);
	}
	.fold-body > * {
		margin: var(--baseline) 0 0;
	}

	/* the folded tail of the typed index: the entries' own names label it,
	   hung on the same 1.4ch margin the fact bullets use */
	.fold--tail {
		margin-inline-start: 1.4ch;
	}
	.fold--tail > summary {
		color: var(--ink-soft);
		font-weight: 700;
	}
	.fold--tail > summary:hover {
		color: var(--thread);
	}
	.fold--tail[open] > summary {
		margin-bottom: calc(var(--baseline) * 3);
	}

	/* the sketch polaroid: aged paper ground under ink wireframe lines —
	   a pencil sketch on the wall, not a screen; landscape frame. It is the
	   only object on this page that answers a hand, so it gets the room and
	   a caption large enough to be read as an invitation. */
	.projects :global(.vr-polaroid .polaroid__frame) {
		background: var(--paper-aged);
		aspect-ratio: 4 / 3;
	}
	/* both photo captions read at one setting on the ladder: the hand writes
	   under a picture at the same size everywhere in this section */
	.projects :global(.polaroid__caption) {
		font-size: var(--step-0);
		line-height: var(--lh-0);
	}

	/* Ayako peeking out of the cork beside the last sheet. The typed index
	   is the one stop that starts a column in, so the bare board is now on
	   its LEFT — which is where she goes. Below 64rem that indent column is
	   thinner than she is and she would reach past the section's padding,
	   so she simply is not stuck on: measured clearance at 64rem is 23px
	   and it only grows, which is the whole reason for the floor. */
	.projects :global(.tail-sticker) {
		display: none;
	}

	@media (min-width: 64rem) {
		.projects :global(.tail-sticker) {
			display: block;
			position: absolute;
			right: calc(100% + var(--baseline) * 0.5);
			bottom: calc(var(--baseline) * 2);
		}
	}
</style>
