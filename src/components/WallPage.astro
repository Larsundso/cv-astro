---
/**
 * WallPage — the pinboard wall, assembled once for every locale.
 * Rendered by src/pages/index.astro (en, "/") and src/pages/de/index.astro
 * (de, "/de/"); copy resolves through getWall(Astro.currentLocale).
 *
 * Hero → Werdegang → Projects → Telemetry → Practice → Contact in one
 * column, stitched by the crimson thread: it starts at the hero's 12/2019
 * pin, hands over to the timeline spine, and — from the timeline's last
 * pin to the contact address — runs PIN TO PIN through every artifact on
 * the lower half of the wall, behind the paper, surfacing only on bare
 * cork. It is cut in a knot on the mailto pin.
 *
 * THE LOWER RUN IS MEASURED, NOT DRAWN BY HAND. Until 2026-08-04 this
 * half of the page was `.wall-run__line`: a 2.5px <span> at left: 50%,
 * 6,282px long — 55 % of the document — passing through exactly one of
 * the nineteen brass pins in its range, and that one by 8px of accident.
 * A rule is not a route. The run is now built at runtime from the pins
 * themselves: the script below reads every waypoint pin's centre with
 * getBoundingClientRect, feeds the centres to taut.ts, and emits ONE 1:1
 * SVG per leg. Every direction change lands on a pin head, which is the
 * convention the hero and the timeline already taught.
 *
 * Thread handoffs (fixed by the section contracts):
 * — the hero exits its board's bottom edge at x = 802/1200 of the 78rem
 *   shell (≥64rem) resp. at 50 % of it (stacked column);
 * — the timeline spine sits at `--spine-x`, the ONE place on this wall
 *   that says where the thread stands when it runs straight down: 152px
 *   left of the shell's centre at ≥48rem, 64px in from the wall's text
 *   edge below that. It enters at the section's top edge and exits at
 *   the bottom of its last row;
 * — the lower run picks the timeline's LAST PIN up directly (the
 *   timeline's own exit stub is deleted, not merely hidden), so the one
 *   junction on the wall that was not covered by a pin head is gone.
 *
 * Draw machinery: stretched connector SVGs disable stroke-dasharray and
 * reveal via a scroll-driven clip wipe instead of the dash draw —
 * Chromium does not pathLength-normalize dasharray under
 * vector-effect: non-scaling-stroke, so dash-drawn threads are only safe
 * at 1:1 scale (see Timeline.astro). The lower run's legs are sized in
 * PIXELS from the measurement that produced them, so they are 1:1 by
 * construction and keep the native dash draw; they are re-measured on
 * resize so they never enter the stretched state. Reduced motion and
 * engines without animation-timeline get the fully drawn resolved state.
 */
import Contact from "~/components/sections/Contact.astro";
import Hero from "~/components/sections/Hero.astro";
import Practice from "~/components/sections/Practice.astro";
import Projects from "~/components/sections/Projects.astro";
import Telemetry from "~/components/sections/Telemetry.astro";
import Timeline from "~/components/sections/Timeline.astro";
import LangTab from "~/components/wall/LangTab.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Thread from "~/components/wall/Thread.astro";
import { getWall, type Locale } from "~/data/i18n";
import Layout from "~/layouts/main.astro";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { contact, meta, ui } = getWall(locale);

/* one index, two appearances: the title card's list and the progress
   rail's ticks. Same order, same labels, same destinations — a directory
   that renames itself between the top of the page and the margin is the
   fastest way to lose a reader. */
/* AND THE FIRST ENTRY IS THE WAYFINDING LABEL, NOT THE DISTRICT'S SIGN.
   `ui.nav.werdegang` still stands over the district itself (Timeline.astro),
   where the content directly below explains the word and it works as a
   landmark. Both places THIS array feeds are read BEFORE the section and
   exist to predict it — and on a page served `lang="en"` a German word
   predicts nothing: four of five entries named their destination and this
   one was opaque, in the first viewport, in front of the section a recruiter
   most wants. So the directory and the rail take
   `ui.nav.werdegangWayfinding` ("Career" / "Werdegang") and the sign keeps
   the German. `lang="de"` goes with the word: the English label is English,
   and mis-declaring it would hand a screen reader a German pronunciation of
   "Career". */
const NAV = [
	{ href: "#werdegang", label: ui.nav.werdegangWayfinding },
	{ href: "#projects", label: ui.nav.projects },
	{ href: "#telemetry", label: ui.nav.telemetry },
	{ href: "#practice", label: ui.nav.practice },
	{ href: "#contact", label: ui.nav.contact }
];

/* THE RAIL CARRIES A SIXTH MARK AND THE TITLE CARD DOES NOT.
   District boundaries measured at 390: 277 / 2,555 / 7,030 / 13,498 /
   17,255 / 20,201. The rail's ticks began at Werdegang, so from the moment
   the strip appeared until y 7,200 it read `Werdegang` CONTINUOUSLY —
   including the whole 2,278px identity district, which ends at 2,555. A
   2,055px lead, 2.4 phone viewports, and it is the reader's FIRST encounter
   with the orientation device: the device opened on a false statement.
   The state machine was never the fault. The other four flips lag their
   boundaries by 170 / 102 / 145 / ≈0px, all inside half a viewport. The
   fault was that the opening act had no graduation at all, so `aria-current`
   had nowhere truthful to land and fell to the next door down the corridor.
   The origin mark is the wall's own name — identical in both locales,
   because the site's title is already German — and it points at `#main`,
   the one id in the layout that cannot be renamed out from under it because
   the skip link lands there. It is deliberately NOT added to the title
   card: the card's flyer already carries `Der Rote Faden` as its heading,
   and a directory whose first line links to the sheet it is printed on is a
   loop, not a door. That is the one licensed difference between the two
   appearances, and it is a mark the card has no use for rather than a
   destination it renames. */
const RAIL_NAV: { href: string; label: string; lang?: string }[] = [
	{ href: "#main", label: "Der Rote Faden", lang: "de" },
	...NAV
];

/* THE TWO LANDMARKS MAY NOT SHARE A NAME. Both `nav` elements carried
   `ui.navAria` — "Sections" / "Abschnitte" — so a screen reader's landmark
   list offered two identically named navigations and no way to tell the
   title card's directory from the rail. A previous cycle recorded this as
   fixed; it was not. The rail is not a second table of contents: it reports
   POSITION and it is the only element on the wall that does, so it is named
   for that. Written here rather than in `ui` because the copy modules are
   another owner's file this cycle; if it earns a home it belongs beside
   `navAria`. */
const railAria = locale === "de" ? "Fortschritt" : "Progress";

/* hero → timeline connectors, one per breakpoint state (see <style>).
   Both stretch between two responsive anchors: the box's corners ARE the
   endpoints, so any width keeps the junctions registered.
   TAUT: a connector spans two pins with nothing between, so under
   tension it is one dead-straight run — no curvature at all. The
   direction changes at its ends belong to the pins in the neighboring
   sections (the hero's last pin above, the spine's relay pin below).

   THERE USED TO BE THREE OF THESE AND ALL THREE MISSED. Measured under
   `reduce` at eight widths, join-end x minus spine-centre x:
     1440 +76 · 1024 +76 (wide, bottom end in mid-air)
      900 +76 ·  768 +76 (mid, BOTH ends in mid-air: −76 at the top too)
      640 −24 ·  390 −24 (narrow, bottom end in mid-air)
   The wide box was placed at `50% − 76px` against a spine at
   `50% − 152px`: half the offset, written into a code comment that
   claimed it "lands on the first timeline card's pin". The mid box
   repeated the same 76 and, being a plain vertical, missed the hero's
   exit by 76 in the other direction — it split the error rather than
   crossing the gap. The narrow box used a literal 64px measured against
   the viewport while the spine uses 64px INSIDE `.wall-max`, which
   carries 24px of inline padding. Three numbers, none of them the
   build's, and DESIGN.md quoted a fourth (48px).
   The mid box is gone: below 64rem the hero always exits at the shell's
   centre and the spine always stands to its left, so ONE diagonal
   crosses that gap at every narrow width. And the offset is no longer
   written anywhere in this file — it is `--spine-x`, declared once. */
const JOIN_WIDE = {
	width: 202,
	height: 224,
	path: "M 202 0 L 0 224"
};
const JOIN_STACK = {
	width: 200,
	height: 224,
	path: "M 200 0 L 0 224"
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
	<!-- the wall's title card: flyer poster, top right, doubling as the index;
	     the language tab hangs beside it, pinned with its own mini-pin -->
	<div class="wall-head wall-max" slot="header">
		<div class="wall-head__card">
			<PinCard variant="flyer" rotate={1}>
				<p class="wall-head__title" lang="de">Der Rote Faden</p>
				<svg class="wall-head__rule" viewBox="0 0 150 8" aria-hidden="true">
					<path
						d="M 3 6 C 40 2 70 9 146 4"
						fill="none"
						stroke="var(--thread)"
						stroke-width="2.4"
						stroke-linecap="round"></path>
				</svg>
				<nav aria-label={ui.navAria}>
					<ul role="list">
						{
							NAV.map((item) => (
								<li>
									<a href={item.href} lang={item.lang}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</PinCard>
		</div>
		<LangTab
			class="wall-head__tab"
			rotate={-1}
			label={ui.langSwitch.label}
			href={ui.langSwitch.href}
			hreflang={ui.langSwitch.hreflang}
			ariaLabel={ui.langSwitch.aria}
			currentLang={locale}
		/>
	</div>

	<!-- the lower run lives here: one absolutely positioned layer over the
	     whole wall, filled at runtime with one SVG per pin-to-pin leg.
	     z-index -1 inside main's stacking context = behind every sheet,
	     above the cork. -->
	<div class="wall-stitch" aria-hidden="true"></div>

	<!-- and the last stretch of every leg, lifted ABOVE the paper: see
	     `.wall-tips`. Same legs, same boxes, same draw — clipped to a ring
	     around each pin, so the thread climbs onto the sheet, wraps the
	     head and drops back behind. -->
	<div class="wall-tips" aria-hidden="true"></div>

	<Hero />

	<!-- hero board → timeline spine. The inner box exists so these
	     connectors and the timeline's spine share ONE origin: it reproduces
	     `.wall-max`'s content box, which is what `.rf-line` is positioned
	     against, so `--spine-x` means the same x in both places. -->
	<div class="stitch-join" aria-hidden="true">
		<div class="stitch-join__box">
			<div class="stitch-join__wide">
				<Thread
					path={JOIN_WIDE.path}
					width={JOIN_WIDE.width}
					height={JOIN_WIDE.height}
					draw={false}
				/>
			</div>
			<div class="stitch-join__stack">
				<Thread
					path={JOIN_STACK.path}
					width={JOIN_STACK.width}
					height={JOIN_STACK.height}
					draw={false}
				/>
			</div>
		</div>
	</div>

	<Timeline />

	<!-- past HEUTE the thread keeps running pin to pin behind the paper.
	     Each act now opens on a band of bare cork with nothing on it but
	     the thread crossing — the rest between dense zones, and the only
	     emptiness on this wall that is allowed to read as emptiness. -->
	<div class="wall-run">
		<div class="act-break" aria-hidden="true"></div>
		<Projects />
		<div class="act-break" aria-hidden="true"></div>
		<Telemetry />
		<div class="act-break" aria-hidden="true"></div>
		<Practice />
	</div>

	<div class="act-break act-break--final" aria-hidden="true"></div>

	<Contact />

	<!-- the wall's only persistent chrome: the thread itself, with the
	     brass pin riding it at scroll progress and the six acts as ticks
	     (five districts plus the wall's own name at the origin — see
	     `RAIL_NAV`). Signage made of the wall's own material.

	     IT USED TO EXIST ON DESKTOP ONLY. Below 64rem `.rail__line` and
	     `.rail__ticks` were both `display: none`, so all five ticks
	     computed 0 × 0 at 390 and the rail collapsed to a single 44 × 44
	     back-to-top pin: on a 20,000px page whose only conversion event is
	     at the bottom, the one persistent control pointed BACKWARDS, and
	     the longest run with no landmark of any kind measured 6,528px —
	     7.7 phone screens. The rail now exists at every width; what
	     changes below 64rem is its AXIS and one added element. See the
	     style block for why.

	     The address chip is narrow-only and it is the point of the
	     exercise: on the phone the first mailto on the page sits past
	     80 % depth, so the strip carries the address itself. -->
	<nav class="rail" id="rail" aria-label={railAria} data-visible="false">
		<span class="rail__line" aria-hidden="true"></span>
		<ul class="rail__ticks" role="list">
			{
				RAIL_NAV.map((item) => (
					<li>
						<a class="rail__tick" href={item.href} data-tick>
							<span class="rail__label" lang={item.lang}>
								{item.label}
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<button class="rail__pin" type="button" id="to-top-pin" aria-label={ui.backToTop}>
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path
					d="M4 12.5 L10 6.5 L16 12.5"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
		{/* ONE ANCHOR, TWO LABELS, AND THE WIDTH DECIDES WHICH. The chit was
		    `display: none` above 64rem, so it measured 144 × 60 at 320–768
		    and 0 × 0 at 1024, 1200, 1440 and 2560: on desktop — where a
		    hiring manager opens the link out of an ATS — the wall's one
		    conversion event had no persistent sign anywhere on the route,
		    and an address became visible only at 81.9 % depth.
		    Seventeen Courier characters do not fit the desktop rail's
		    column, so the desktop chit is a DIRECTION sign in the wall's
		    display face and the phone chip stays the address itself. The
		    words are `contact.title`, so the sign matches its destination's
		    marquee verbatim rather than inventing a sixth name. */}
		<a class="rail__mail" href="mailto:jobs@lars-dev.org">
			<span class="rail__mail-say">{contact.title}</span>
			<span class="rail__mail-addr">jobs@lars-dev.org</span>
		</a>
	</nav>

	<!-- the contact section signs the wall (© stamp); keep the footer quiet -->
	<Fragment slot="footer" />
</Layout>

<style is:global>
	/* anchor targets breathe below the viewport edge when navigated to.
	   `#main` joins the list because the rail's origin tick now points at it
	   (see `RAIL_NAV`) — and the skip link lands there too, so the same 32px
	   now keeps the wall's first sheet off the viewport's top edge for both. */
	#main,
	#werdegang,
	#projects,
	#telemetry,
	#practice,
	#contact {
		scroll-margin-top: calc(var(--baseline) * 4);
	}

	#werdegang {
		scroll-margin-top: calc(var(--baseline) * 6);
	}

	/* ---- ONE SPINE, ONE NUMBER ------------------------------------- */
	/* Where the thread stands when it is running straight down the wall.
	   Consumed by `.rf-line` (the timeline's entry line), the timeline's
	   own card-to-card stitches, and both hero→timeline connectors — so
	   the seam between two sections cannot drift again by editing one of
	   them. Every consumer positions against a box whose left edge is
	   `.wall-max`'s CONTENT edge (`.rf-head`, `.rf-row`, and the
	   `.stitch-join__box` built for exactly this reason), which is what
	   makes one declaration legal in all of them.
	   ≥48rem the spine is 152px left of the shell's centre — the pin
	   column of the timeline's LEFT cards. Below that the wall is one
	   column and every pin stands 64px in from the wall's text edge.
	   Mirror value: the timeline's RIGHT card column. */

	:root {
		--spine-x: 64px;
		--spine-x-r: 64px;
		/* the thread's own weight — 4px on a 1,425px plane is 0.28 % of
		   width, where real red twine on a 1m board is 0.3–0.4 %. At 2.5px
		   (0.18 %) the wall's central metaphor was a hairline. */
		--thread-w: 4px;
	}

	/* 48.0625rem = 769px, NOT 48rem. `wall.css` and `Projects.astro` gate
	   their narrow branches on `max-width: 48rem`, and `max-width: 48rem`
	   and `min-width: 48rem` are BOTH TRUE at exactly 768 CSS px — iPad
	   portrait, a width people hold in their hands. Measured document
	   heights before this rule: 767 → 17,692 · 768 → 18,772 · 769 → 18,473.
	   768 was 1,080px taller than the width one pixel narrower and 299px
	   taller than the width one pixel wider, because the timeline took its
	   wide shape while Projects kept its narrow one and `.act-break` jumped
	   128 → 200px: a hybrid layout that existed at exactly one width.
	   The 64rem pair on this wall is already disjoint (63.9375 / 64); this
	   copies that convention on the other side, so 768 resolves NARROW
	   everywhere — which is what the files that own `max-width: 48rem`
	   already say it is. Every `min-width: 48rem` on the wall moves
	   together: this one, `.act-break` below, and Timeline.astro's
	   armature. */
	@media (min-width: 48.0625rem) {
		:root {
			--spine-x: calc(50% - 152px);
			--spine-x-r: calc(50% + 152px);
		}
	}

	/* ---- the lower run: one measured layer ------------------------ */
	/* main already isolates (wall.css) so that z-index: -1 paints above
	   the cork and below the paper; it needs to be a containing block
	   too, so the layer can span exactly the wall and nothing else. */

	main {
		position: relative;
	}

	/* THE THREAD'S WEIGHT, DECLARED ONCE, FOR EVERY THREAD ON THE WALL.
	   It was 2.5px: 0.18 % of a 1,425px plane, where real red twine on a
	   1m board is 0.3–0.4 %. Every `.thread-path` reads the token — the
	   hero's two runs, this connector, the timeline's card-to-card
	   stitches and the 26 runtime legs — so the wall cannot end up with
	   two thread weights in one frame. It is set in CSS rather than on
	   each <path>, because a custom property inside an SVG PRESENTATION
	   attribute is the one place `var()` is not reliably resolved, and the
	   failure mode there is a 1px hairline. */
	.thread-path {
		stroke-width: var(--thread-w);
	}

	.wall-stitch {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	/* THE TIPS LAYER — the thread's only licence to be on top of paper.
	   Behind every sheet without exception, 63 % of the lower run never
	   reached the eye (measured: 8,352px of 13,309px hidden at 1440), and
	   at every pin the thread simply stopped at the card's edge: 25 brass
	   pins joined to nothing. Lifting the whole layer is not the fix —
	   37 of 68 cards have thread crossing their interior, some diagonally
	   over body copy.
	   So only the LAST STRETCH is lifted, and only in a ring around the
	   pin it is arriving at: same leg, same box, same 1:1 viewBox, same
	   draw timing, clipped to an annulus of r 34px with the 8px pin head
	   punched out of the middle. The thread climbs onto the sheet, runs
	   under the head that is holding it, and drops back behind the paper.
	   That is what a wrapped pin looks like, and it is the only reading
	   under which a thread that vanishes at a card edge is not a cut.

	   AND THE RING'S OUTER EDGE IS A DISSOLVE, NOT A CUT. It used to be an
	   even-odd `clipPath` at r = 34: a hard boundary, so at 24 of the 25
	   leg starts the thread ended in a round cap on blank paper, 27–30px
	   out from the pin, with paper continuing for another 90px+ past it.
	   Measured by walking the real path geometry outward from every
	   endpoint and reading the RENDERED PIXEL at 1.5px steps: 30 of 49
	   endpoints ended mid-sheet. A thread that vanishes at a card's EDGE
	   reads as running behind the card — an edge is a licensed occluder. A
	   thread that stops 34px from a pin in the middle of a sheet has no
	   occluder at all: it is physically impossible, and an impossible
	   rendering reads as a bug.
	   So the outer boundary is now a luminance mask that fades the thread
	   into the paper over the last 13px (solid to r = 21, gone by r = 34),
	   with the pin head still punched out hard at r = 8 because a pin head
	   IS a real occluder. See the builder below for why the mask is white
	   with a ramped ALPHA rather than white-to-black. */
	/* Z-INDEX 5, NOT 1: THE LIFT WAS OUT-RANKED BY THE TIMELINE. At
	   z-index 1 this layer lost the tie to `.rf-cardwrap`/`.rf-slot`
	   (z-index 1, later in the DOM) and lost outright to `.rf-pin`
	   (z-index 4) — so the one waypoint that stands inside the timeline,
	   the spine's last pin at page y 4,052, had its whole lifted stretch
	   painted over: measured 0 red pixels for 132px along the path, and
	   removing the clip changed nothing, which is what proved it was
	   stacking and not geometry. 5 clears every artefact on the wall (the
	   highest is `.rf-pin`'s 4) and stays under the rail's 50 and the skip
	   link's 60. The pin head is still on top of the thread where it must
	   be — that is the r = 8 punch's job, not the stack's. */
	.wall-tips {
		position: absolute;
		inset: 0;
		z-index: 5;
		pointer-events: none;
	}

	/* Each leg is an HTML box sized in the pixels it was measured in,
	   holding an SVG whose viewBox is in PAGE coordinates — so the
	   mapping is exactly 1:1 and the native dash draw is safe here
	   (unlike the stretched section joins, which must clip-wipe). */
	.wall-stitch .ws-leg,
	.wall-stitch .ws-knot,
	.wall-tips .ws-leg {
		position: absolute;
	}

	.wall-stitch svg,
	.wall-tips svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* the loose end hangs along the thread: authored entry-at-top, then
	   rotated about that entry so the cut node lands on the mailto pin */
	.wall-stitch .ws-knot {
		transform-origin: 80px 0;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			/* THE TIMELINE MUST HANG ON THE HTML BOX, NOT ON THE PATH.
			   Chromium resolves `animation-timeline: view()` for an SVG
			   child against the element's position in the SVG's own
			   coordinate system and ignores where the <svg> sits in the
			   document — measured here: a leg at document y 4,326 reported
			   its view progress as 122 % while the viewport was at y 400,
			   because its path box starts 8 units down its own viewBox.
			   Naming the timeline on the wrapper and referencing it from
			   the path fixes the subject without giving up the dash draw. */
			/* `.wall-tips .ws-knot` used to be listed here and matched ZERO
			   elements at every width: the knot is emitted into
			   `.wall-stitch` only — it hangs on bare cork, so it has no
			   paper to be lifted above. A selector that names a thing the
			   builder never makes is how a wrong belief about the DOM
			   survives a review. */
			.wall-stitch .ws-leg,
			.wall-stitch .ws-knot,
			.wall-tips .ws-leg {
				view-timeline-name: --ws;
				view-timeline-axis: block;
			}

			/* THE THREAD HAS TO POINT FORWARD, AND THIS IS THE WHOLE OF IT.
			   The old rule computed a `cover` range per leg from the leg's
			   own height and a lead of 0.45, which finishes a leg when its
			   destination pin stands at 55 % of the viewport. Measured
			   consequence at eleven scroll offsets: the lowest drawn ink sat
			   at a mean of 69.6 % of viewport height at 1440 and 68.4 % at
			   390, and NEVER below 80.3 % — the bottom fifth of every screen
			   had no thread in it, ever. The drawing tip was behind a card
			   at 8 of 11 offsets. A reader does not read that as "not yet
			   drawn"; they read it as "this thread ends here", on a wall
			   whose one idea is that it doesn't.
			   `entry` is the range from the leg's top edge touching the
			   viewport's bottom edge to the leg being contained by it, and
			   its length is min(legHeight, viewportHeight). Finish at 85 %
			   of it and the arithmetic guarantees what the old constant only
			   approximated: at scroll travel s past the leg's appearance the
			   drawn fraction is s/(0.85·min(h,vh)) and the leg's top sits at
			   vh − s, so the tip is at vh + s·(h/(0.85·min(h,vh)) − 1) —
			   never above the fold, for any leg height, at any viewport
			   height. The reveal itself is untouched: what changed is where
			   its edge is, not that it has one.
			   It also drops the last consumer of `window.innerHeight` from
			   the builder below, so the layer stops re-solving every time a
			   mobile URL bar slides. */
			.wall-stitch .thread-path--draw,
			.wall-tips .thread-path--draw {
				animation-timeline: --ws;
				animation-range: entry 0% entry 85%;
			}
		}
	}

	/* the layout's fixed back-to-top pin is re-staged as the rail below.
	   Addressed by id: the layout's own rule is scoped, so a bare class
	   selector loses the specificity contest and the pin stays on screen
	   twice. */
