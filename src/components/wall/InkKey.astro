---
/**
 * InkKey — the wall's colour key: six pen strokes against six jobs.
 *
 * A coded system carries its key, or it reads as decoration. This is that
 * key for The Annotation Ink Rule (DESIGN.md): each row pairs one pride
 * ink with the job it does, in the rule's own words and the rule's own
 * order. Rows never name a hue — the stroke shows it, the words say what
 * it MEANS.
 *
 * Two text channels, not one. `job` names the category from inside the
 * system ("the provenance"); `q` states the reader's own question that the
 * ink answers ("how do you know?"). The question is the channel that
 * teaches, and it is also the channel that has to survive colour-vision
 * deficiency: in flag order the two weakest adjacent pairs sit together
 * (teal/green ΔE 9.3 normal but 3.1 tritan; green/amber 4.0 protan), and
 * flag order is the flag. So the hue channel here is constrained for
 * non-data reasons and the words carry the load — deliberately redundant
 * coding, not decoration.
 *
 * REUSABLE — stateless and unpositioned. It reads `inkKey` from the locale
 * module and holds no state; every instance renders identically. Nothing
 * inside sets a margin, so the caller owns placement entirely (`class` for
 * position, `rotate` for the tilt step). Heading ids are unique per
 * instance, so it is safe to pin the same key in two places on one page —
 * which is the intent: declare the code near the top of the wall, confirm
 * it beside the artifact that has just used four of its six inks.
 *
 * Material: a note slip, the same paper a freestanding HandNote rides on
 * (paper ground, one pin shadow, a brass pin, a ±1.2° tilt step) — not a
 * PinCard variant, because the whole slip is hand material and no variant
 * face may sit on it. The heading is the wall's one handwritten line in
 * plain --ink: it labels the code, so it may not wear it.
 *
 * The marks are pen strokes, not swatches: six wavering paths at the
 * thread's own 2.5px weight, each drawn slightly differently, the way six
 * pens test out on a scrap. Decorative — the meaning is in the words,
 * which are themselves set in the ink.
 */
import HandNote from "~/components/wall/HandNote.astro";
import { getWall, type Locale } from "~/data/i18n";

interface Props {
	/** rotation step: -1 | 0 | 1 → ±1.2deg; never share a neighbour's */
	rotate?: -1 | 0 | 1;
	/**
	 * Heading id. Omit and one is generated — every instance must carry a
	 * different id or a second key on the page would duplicate the first.
	 */
	id?: string;
	class?: string;
}

const { rotate = 1, id, class: className } = Astro.props;

const locale = (Astro.currentLocale ?? "en") as Locale;
const { inkKey } = getWall(locale);

/* Six pen strokes, one per row — same gesture, never the same line. */
const STROKES = [
	"M 1.6 7.5 C 7 3.1 13.4 8.7 26.4 3.2",
	"M 1.6 6.4 C 8.2 8.6 14.1 2.5 26.4 4.4",
	"M 1.6 4.1 C 6.4 8.3 15.2 3.3 26.4 6.9",
	"M 1.6 7.9 C 9.1 4.3 13.6 7.3 26.4 3.5",
	"M 1.6 3.4 C 7.6 7.7 14.6 4.3 26.4 7.5",
	"M 1.6 6.1 C 8.6 2.7 14.2 7.9 26.4 4.7"
];

/* unique per instance, so two keys on one page never collide */
const headingId = id ?? `ink-key-${locale}-${Math.random().toString(36).slice(2, 8)}`;
---

<aside
	class:list={["ink-key", "paper", "pinned", className]}
	style={`--tilt:${rotate};`}
	aria-labelledby={headingId}
>
	<span class="brass-pin ink-key__pin" aria-hidden="true"></span>
	<p class="ink-key__head" id={headingId}>{inkKey.title}</p>
	<ul class="ink-key__rows" role="list">
		{
			inkKey.rows.map((row, i) => (
				<li class="ink-key__row">
					<svg
						class="ink-key__mark"
						viewBox="0 0 28 11"
						style={`color:var(--ink-${row.ink});`}
						aria-hidden="true"
					>
						<path
							d={STROKES[i]}
							fill="none"
							stroke="currentColor"
							stroke-width="2.5"
							stroke-linecap="round"
						/>
					</svg>
					<span class="ink-key__pair">
						<HandNote ink={row.ink} as="span" class="ink-key__job">
							{row.job}
						</HandNote>
						<span class="ink-key__q">{row.q}</span>
					</span>
				</li>
			))
		}
	</ul>
</aside>

<style>
	.ink-key {
		position: relative;
		/* two text channels per row need the width the one-word labels did
		   not: at 15rem the questions wrapped to three lines each */
		inline-size: 19rem;
		max-inline-size: 100%;
		/* one material per artifact: the whole slip is the pen, so nothing
		   inside it can fall back to the body face */
		font-family: var(--font-hand);
		/* clears the pin bridging the top edge */
		padding: calc(var(--baseline) * 2.25) calc(var(--baseline) * 2)
			calc(var(--baseline) * 1.5);
	}

	.ink-key__pin {
		position: absolute;
		top: calc(var(--baseline) * -0.75);
		left: 50%;
		translate: -50% 0;
	}

	/* the one hand line on the wall that carries no code */
	.ink-key__head {
		margin: 0 0 var(--baseline);
		font-family: var(--font-hand);
		font-weight: 500;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		color: var(--ink);
		rotate: -0.7deg;
		/* German runs two lines here; a hand writes them evenly, not with
		   one word stranded on the second */
		text-wrap: balance;
	}

	.ink-key__rows {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		row-gap: var(--baseline);
	}

	.ink-key__row {
		display: flex;
		align-items: start;
		column-gap: var(--baseline);
	}

	.ink-key__mark {
		flex: none;
		inline-size: 28px;
		block-size: 11px;
		overflow: visible;
		/* the stroke sits on the job line's own centre, not the row's */
		margin-block-start: calc(var(--baseline) * 1.25);
	}

	.ink-key__pair {
		display: block;
		min-inline-size: 0;
	}

	/* the job line is the hand's own band, like every other pen stroke on the
	   wall: it used to sit at --step-0, which put six lines of handwriting
	   into the printed record's size class */
	.ink-key :global(.ink-key__job) {
		display: block;
		/* the key's two channels are already measured by the slip */
		max-inline-size: none;
	}

	/* the question is the channel that teaches; it is quieter than the job
	   it belongs to, and it never wears the ink — a reader must be able to
	   tell the code from the caption */
	.ink-key__q {
		display: block;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		color: var(--ink-soft);
		text-wrap: pretty;
	}

	/* every row a hair off the last, the way a hand writes a list */
	.ink-key__row:nth-child(odd) :global(.ink-key__job) {
		rotate: -0.9deg;
	}

	.ink-key__row:nth-child(even) :global(.ink-key__job) {
		rotate: 0.6deg;
	}
</style>
