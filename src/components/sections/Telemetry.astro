---
/**
 * Telemetry — hand-annotated chart print-outs pinned to the cork.
 *
 * SSR ECharts SVGs from getCharts (paper ground, pride-ink series,
 * snapshot-safe) pinned as PinCard print-outs, each with a unit + as-of
 * line, a handwritten margin note quoting the headline figure, and a
 * <details> data table for assistive tech. The habit field renders
 * 1,700+ day cells as four pattern-filled SVG rects, stamped with its
 * as-of date. A typed provenance card closes the run and states where the
 * figures come from.
 *
 * Reading order is a path, not a guess: flyer → print-out → print-out →
 * habit field → source. See the ROUTE note above the wide breakpoint.
 */
import getCharts from "~/components/scripts/getCharts";
import HandNote from "~/components/wall/HandNote.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Stamp from "~/components/wall/Stamp.astro";
import { getWall, type Locale } from "~/data/i18n";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const locale = (Astro.currentLocale ?? "en") as Locale;
const { chartStrings, sectionStrings, ui } = getWall(locale);
const tf = chartStrings.telemetrySection;

const { charts, habit, provenance, trackingStart } = await getCharts(locale);
---

<section class:list={["telemetry", "wall-max", className]} id="telemetry" aria-labelledby="telemetry-title">
	<div class="wall-grid telemetry__grid">
		<PinCard as="div" variant="flyer" rotate={-1} class="telemetry__headline">
			<h2 class="telemetry__h" id="telemetry-title">{ui.nav.telemetry}</h2>
			<div class="telemetry__rule" aria-hidden="true"></div>
			<p class="telemetry__since">{tf.trackedSince(trackingStart)}</p>
		</PinCard>

		{
			charts.map((chart, i) => (
				<div
					class:list={[
						"telemetry__slot",
						i % 2 === 0 ? "telemetry__slot--left" : "telemetry__slot--right"
					]}
				>
					<PinCard as="figure" variant="print" rotate={i % 2 === 0 ? 1 : -1} class="telemetry__card">
						<h3 class="telemetry__title">{chart.title}</h3>
						<p class="telemetry__unit">{chart.unit}</p>
						<div
						class:list={[
							"telemetry__chart",
							chart.id.startsWith("recent-") && "telemetry__chart--wide"
						]}
						role="img"
						aria-label={chart.alt}
						tabindex={chart.id.startsWith("recent-") ? 0 : undefined}
						set:html={chart.svg}
					/>
						<HandNote as="p" ink={chart.annotation.ink} class="telemetry__note">
							{chart.annotation.text}
						</HandNote>
						{
							/* a starred figure explains itself on the card face,
							   not only inside the folded table */
							chart.table.note && (
								<p class="telemetry__facenote">{chart.table.note}</p>
							)
						}
						<details class="telemetry__details">
							<summary>{tf.dataAsTable}</summary>
							{
								/* A SCROLL CONTAINER A KEYBOARD CAN REACH. This div
								   panned but took no focus: no `tabindex`, no role, no
								   name. Measured at a 320px viewport it overflows by 64
								   and 68px — and Chrome 127+ hands scrollers a tab stop
								   automatically while Firefox and Safari do not, so
								   exactly where the table matters most (the narrow
								   widths where the chart's own SVG type collapses toward
								   7px) two of three engines could not reach the far
								   column. `role="group"`, not `region`: a region is a
								   landmark, and this wall has just spent a finding on
								   two landmarks sharing one name — five more would be
								   worse than the defect. The tab stop costs nothing when
								   it is not wanted, because it lives inside a
								   `<details>` that ships shut and is therefore out of
								   the tab order until a reader opens the table. */
							}
							<div
								class="telemetry__scroll"
								tabindex="0"
								role="group"
								aria-label={`${chart.title} — ${tf.dataAsTable}`}
							>
								<table>
									<caption class="sr-only">
										{chart.title} — {chart.unit}
									</caption>
									<thead>
										<tr>
											{chart.table.head.map((head) => (
												<th scope="col">{head}</th>
											))}
										</tr>
									</thead>
									<tbody>
										{chart.table.rows.map((row) => (
											<tr>
												{row.map((cell, j) =>
													j === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>
												)}
											</tr>
										))}
									</tbody>
								</table>
							</div>
							{chart.table.note && <p class="telemetry__tablenote">{chart.table.note}</p>}
						</details>
					</PinCard>
				</div>
			))
		}

		<div class="telemetry__slot telemetry__slot--habit">
			<PinCard as="figure" variant="print" rotate={1} class="telemetry__card telemetry__habit">
				<h3 class="telemetry__title">{habit.title}</h3>
				<p class="telemetry__unit">{habit.unit}</p>
				{
					/* Two blocks, not one grid. The empty days are a second
					   quantity with a label of its own, so the tail of the
					   graphic can never be mistaken for the recent past. */
				}
				<div class="telemetry__field" role="img" aria-label={habit.alt}>
					<div class="telemetry__block" set:html={habit.svg} />
					{
						habit.idle && (
							<>
								<p class="telemetry__idle">{habit.idle.label}</p>
								<div class="telemetry__block" set:html={habit.idle.svg} />
							</>
						)
					}
				</div>
				<p class="telemetry__figure">{habit.line}</p>
				<p class="telemetry__smallprint">{habit.smallPrint}</p>
				<HandNote as="p" ink={habit.annotation.ink} class="telemetry__note telemetry__note--flow">
					{habit.annotation.text}
				</HandNote>
				<Stamp sub={sectionStrings.asOfStamp} label={habit.asOf} rotate={7} class="telemetry__stamp" />
			</PinCard>
		</div>

		{
			/* The source card closes the run it covers. It used to be pinned
			   opposite the section flyer — the two artifacts furthest apart
			   in the section were the first two the eye met, and the reading
			   order started with a 663px sideways throw. A footnote belongs
			   under the figures it answers for, and stepping back toward the
			   left rail here hands the eye to the next act's marquee. */
		}
		<PinCard as="div" variant="typed" rotate={1} class="telemetry__prov">
			<h3 class="telemetry__prov-title">{tf.sourceHeading}</h3>
			{provenance.map((line) => <p class="telemetry__prov-line">{line}</p>)}
		</PinCard>
	</div>
</section>

<style>
	.telemetry {
		padding-block: calc(var(--baseline) * 8);
		scroll-margin-top: calc(var(--baseline) * 4);
		/* one measure for the corner margin notes; the printed header
		   reserves exactly this much room, so the two can never meet */
		--note-width: 15rem;
	}

	.telemetry__grid {
		align-items: start;
	}

	/* every artifact spans the full wall until it is wide enough to collage */
	.telemetry :global(.telemetry__headline),
	.telemetry :global(.telemetry__prov),
	.telemetry__slot {
		grid-column: 1 / -1;
	}

	.telemetry__slot {
		position: relative;
	}

	/* ---- the flyer headline ------------------------------------ */

	.telemetry :global(.telemetry__headline) {
		max-width: 26rem;
	}

	.telemetry__h {
		margin: 0;
		font-size: var(--step-5);
		line-height: var(--lh-5);
	}

	.telemetry__rule {
		width: 44%;
		max-width: 9rem;
		height: 4px;
		margin-block-start: var(--baseline);
		background: var(--thread);
		rotate: -0.6deg;
	}

	/* League Gothic below 24px was reading at the printed body's size — a
	   display face borrowing the record's band. The subline of a poster is
	   still poster. */
	.telemetry__since {
		margin: calc(var(--baseline) * 2) 0 0;
		font-size: var(--step-2);
		line-height: var(--lh-2);
		color: var(--ink-soft);
	}

	/* ---- the typed provenance card ------------------------------ */

	.telemetry :global(.telemetry__prov) {
		max-width: 34rem;
		font-size: var(--step-0);
		line-height: var(--lh-0);
	}

	/* one line tall, lifted into the header band onto the red rule */
	.telemetry__prov-title {
		margin: calc(var(--baseline) * -4) 0 var(--baseline);
		font-size: var(--step-0);
		line-height: var(--lh-0);
		font-weight: 700;
	}

	/* THE SOURCE LINE CARRIES A URL, AND A URL IS ONE UNBREAKABLE WORD.
	   `https://wakatime.com/api/v1/users/Larsundso/stats/all_time` is 57
	   Courier characters with no break opportunity in it, so it set this
	   card's min-content width — and the card, whose `max-width: 34rem` was
	   never the binding constraint, ran off the phone: measured at the
	   DEFAULT root size, +178.4px past a 390px viewport, +208.4 at 360,
	   +247.9 at 320, in both locales, with `scrollWidth - clientWidth = 0`
	   because `overflow-x: clip` swallows the scrollbar. The address the
	   card exists to hand over was the one string a phone could not read.
	   `anywhere` rather than `break-word` because only `anywhere` also
	   lowers the min-content contribution, which is what lets the card
	   shrink; and it inserts no hyphen, so it is not the hyphenation the
	   handwriting on this wall forbids. */
	.telemetry__prov-line {
		margin: 0;
		overflow-wrap: anywhere;
	}

	/* ---- print-out cards ---------------------------------------- */

	.telemetry :global(.telemetry__card) {
		display: block;
		width: 100%;
		margin: 0;
	}

	/* the printed voice, on its own step. These sheets used to inherit the
	   document's 1rem, which is the typewriter's step and the hand's step. */
	.telemetry :global(.pin-card--print) {
		font-size: var(--step-1);
		line-height: var(--lh-2);
	}

	.telemetry__title {
		margin: 0;
		font-size: var(--step-2);
		line-height: var(--lh-2);
		text-wrap: balance;
	}

	/* subordinate register: one step under the printed body, never at the
	   hand's step — the hand's own note sits on this same sheet */
	.telemetry__unit {
		margin: calc(var(--baseline) / 2) 0 0;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink-soft);
	}

	.telemetry__chart,
	.telemetry__field {
		margin-block-start: calc(var(--baseline) * 2);
	}

	.telemetry__chart :global(svg),
	.telemetry__field :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	/* THE HOLLOW CELL IS A MARK, AND A SCALED HAIRLINE IS NOT A MARK.
	   `width: 100%` above scales the habit field to its card: 1.2215x at
	   1440, but 0.4827x at 390 — and a 1px stroke drawn at 0.4827x is half a
	   device pixel, which the rasteriser resolves by mixing it into the
	   paper. Sampled from the render at 390x844, dpr 1: darkest painted
	   pixel [199,197,190] against paper [249,248,242] = 1.623:1, APCA
	   Lc 26.9 — the declared ink is 3.12:1 and the floor for a graphical
	   object is 3:1. This is the same antialiasing trap that took the old
	   "safety hairline" from a declared 14.989:1 down to 1.281:1: the
	   contrast of a sub-pixel line is not the contrast of its colour.
	   `non-scaling-stroke` takes the stroke out of the SVG's scale so it is
	   drawn at its own width in device space (390: 1.623 -> 2.843:1), and
	   1.25px guarantees one fully-inked pixel wherever the geometry lands
	   off the grid (390: 3.101:1, 1440: 3.150:1, unchanged). Geometry,
	   colour and the two-block split are untouched — hollow still means a
	   day with nothing tracked, it is now merely visible on a phone. */
	.telemetry__field :global(rect[stroke]) {
		vector-effect: non-scaling-stroke;
		stroke-width: 1.25;
	}

	/* the break between the run and the days outside it: a rule, a line of
	   air, and a label that carries full ink weight at body size */
	.telemetry__idle {
		margin: var(--baseline) 0 var(--baseline);
		padding-block-start: var(--baseline);
		border-block-start: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
		font-size: var(--step-1);
		line-height: var(--lh-2);
		font-weight: 700;
	}

	/* the dense seven-day sheets pan on narrow screens instead of
	   shrinking their type; tabindex keeps the pan keyboard-reachable */
	.telemetry__chart--wide {
		overflow-x: auto;
	}

	.telemetry__chart--wide :global(svg) {
		min-width: 34rem;
	}

	/* ---- handwritten margin notes -------------------------------- */

	.telemetry :global(.telemetry__note) {
		margin: var(--baseline) 0 0;
		text-align: right;
		text-wrap: pretty;
		rotate: -2deg;
	}

	/* ---- the data tables ----------------------------------------- */

	.telemetry__details {
		margin-block-start: calc(var(--baseline) * 2);
		border-block-start: 1px solid color-mix(in oklab, var(--ink) 15%, transparent);
		padding-block-start: var(--baseline);
	}

	.telemetry__details summary {
		cursor: pointer;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		font-weight: 700;
		color: var(--ink-soft);
	}

	.telemetry__details summary:hover {
		color: var(--ink);
	}

	.telemetry__details[open] summary {
		margin-block-end: var(--baseline);
	}

	.telemetry__scroll {
		overflow-x: auto;
	}

	.telemetry__details table {
		width: 100%;
		border-collapse: collapse;
		font-size: var(--step--1);
		line-height: var(--lh--1);
	}

	.telemetry__details :is(th, td) {
		padding: calc(var(--baseline) * 0.75) var(--baseline);
		border-block-end: 1px solid color-mix(in oklab, var(--ink) 12%, transparent);
		text-align: left;
		vertical-align: top;
	}

	.telemetry__details th[scope="col"] {
		font-size: var(--step--1);
		line-height: var(--lh--1);
		text-transform: uppercase;
		letter-spacing: var(--track-display);
		color: var(--ink-soft);
	}

	.telemetry__details :is(th, td):not(:first-child) {
		text-align: right;
		white-space: nowrap;
	}

	.telemetry__tablenote {
		margin: var(--baseline) 0 0;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		color: var(--ink-soft);
	}

	.telemetry__facenote {
		margin: var(--baseline) 0 0;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink-soft);
	}

	/* ---- the habit field ------------------------------------------ */

	.telemetry__figure {
		margin: calc(var(--baseline) * 2) 0 0;
		font-size: var(--step-1);
		line-height: var(--lh-2);
		font-weight: 700;
	}

	.telemetry__smallprint {
		margin: calc(var(--baseline) / 2) 0 0;
		font-size: var(--step-0);
		line-height: var(--lh-0);
		color: var(--ink-soft);
	}

	.telemetry :global(.telemetry__stamp) {
		position: absolute;
		top: calc(var(--baseline) * -2);
		right: calc(var(--baseline) * -1.5);
		--stamp-size: 6rem;
	}

	/* Stacked, the habit sheet runs the full width of the wall's padding
	   box, and its overhang has nowhere to go: a 96px ring rotated 7deg is
	   107px wide, and the card's own 1.2deg tilt pushes its right edge out
	   by half its height x sin(1.2deg) — which grew with the type. Measured
	   at 768: 2px of the ring past the viewport, clipped silently by
	   `overflow-x: clip`. The lap moves to the top edge only. */
	@media (max-width: 63.999rem) {
		.telemetry :global(.telemetry__stamp) {
			right: 0;
		}
	}

	/* keep the printed header clear of the stamp */
	.telemetry :global(.telemetry__habit) .telemetry__title,
	.telemetry :global(.telemetry__habit) .telemetry__unit {
		padding-inline-end: 5.5rem;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
		border: 0;
	}

	/* ---- the collage once the wall is wide ------------------------ */

	/* ROUTE. Five artifacts, one line of travel: flyer and first print-out
	   share the left rail, the two print-outs are a pair read across once,
	   and the habit field and the source card step back down the middle.
	   Measured centre-to-centre throw between artifacts in reading order:
	   51 → 612 → 204 → 204 (was 663 → 51 → 612 → 306). Exactly one
	   crossing, and it is the one the material asks for: two sheets off the
	   same run, pinned side by side. */

	@media (min-width: 64rem) {
		.telemetry :global(.telemetry__headline) {
			grid-column: 1 / span 5;
			max-width: none;
		}

		.telemetry :global(.telemetry__prov) {
			grid-column: 2 / span 8;
			max-width: none;
		}

		.telemetry__slot--left {
			grid-column: 1 / span 6;
		}

		.telemetry__slot--right {
			grid-column: 7 / span 6;
			margin-block-start: calc(var(--baseline) * 5);
		}

		.telemetry__slot--habit {
			grid-column: 4 / span 8;
		}

		/* margin notes ride the top-right corner of the sheet */
		.telemetry :global(.telemetry__note:not(.telemetry__note--flow)) {
			position: absolute;
			top: calc(var(--baseline) * 1.5);
			right: calc(var(--baseline) * 3);
			max-width: var(--note-width);
			margin: 0;
		}

		/* the header keeps clear of the note's whole footprint, not a
		   percentage that happened to work at one title length */
		.telemetry__slot:not(.telemetry__slot--habit) .telemetry__title,
		.telemetry__slot:not(.telemetry__slot--habit) .telemetry__unit {
			padding-inline-end: calc(var(--note-width) + var(--baseline) * 5);
		}
	}
</style>
