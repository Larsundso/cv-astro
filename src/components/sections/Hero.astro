---
/**
 * Hero — the first-viewport wall cluster.
 *
 * The typed record card, the handwritten signature, the Ayako polaroid,
 * the hand-annotated telemetry print-out and the 12/2019 stamp that dates
 * the thread — stitched by the crimson thread. On narrow viewports the
 * cluster stacks into one curated column and the thread keeps running.
 *
 * COMPOSITION. Five artifacts, one sequence, and the sequence answers a
 * recruiter's questions in the order they ask them:
 *
 *   CLAIM      who this is and what he does now, in three ranks on one
 *              card: the name and the 2.4M-user claim one step up at the
 *              typewriter's bold, then the level statement AND THE PAID
 *              POST bold at the card's own size, and the record —
 *              technology, the offer, whatever else the copy module has
 *              appended, then credential, qualification, geography,
 *              languages — under a blank rule.
 *              It sits in the fold's primary optical area (top-left)
 *              because job title and current employer are the top two
 *              fixation points in recruiter eye-tracking and are the
 *              German stage-1 filter. The CREDENTIAL keeps that position
 *              and yields only its weight; the POST — job title and
 *              employer — carries weight and gives up its position in the
 *              record's first sentence. Two facts, two axes, and they are
 *              spent separately on purpose.
 *   SIGNATURE  the name, the wall's brand asset and now its FOCAL MASS:
 *              the largest sheet in the fold, the largest setting on the
 *              page — 89px at weight 700, filling 85 % of its own sheet
 *              where it filled 58 % — and the only object that carries
 *              all six pride inks.
 *   EXHIBIT    the Ayako polaroid — the product the claim is about. It
 *              keeps its full chroma and its full size; what changed is
 *              WHERE. It used to sit at the board's far right, which put
 *              58 % of the fold's ink in columns 10–11 and made the eye
 *              enter at 82 % and travel right-to-left against reading
 *              gravity. It now anchors the lower left.
 *   EVIDENCE  the hand-annotated telemetry print-out that proves the run.
 *   STAMP      12/2019, the date the thread starts, pinned last — it is
 *              the hand-off to the Timeline below, whose first entry is
 *              that same month.
 *
 * ONE READING ORDER, and the document holds it. The markup below is
 * written in that sequence, and BOTH breakpoints follow it: the stacked
 * column is a plain flex column in source order (no `order` anywhere in
 * this file), and the desktop wall places the same five artifacts left to
 * right, top to bottom, through explicit grid-column / grid-row
 * placement. A screen-reader user, a keyboard user and a sighted reader
 * walk the same five beats in the same sequence at every width. If an
 * artifact ever has to move on the wall, move its grid placement — never
 * the markup, and never with `order`.
 *
 * NO CTA HERE. The mailto used to be station four of six inside the first
 * viewport — the reader was asked before they were convinced — and the
 * same address then closed the page 10,000px later with weaker staging.
 * The hero now makes the case and Act V asks. The address still reaches
 * the reader from the nav at every scroll position.
 *
 * Telemetry lines render live WakaTime figures when WAKA_KEY is set at
 * build time; otherwise the checked-in snapshot copy from wall.ts stands
 * verbatim. Sentence shapes are identical in both cases (voice law:
 * every figure carries unit + as-of date), and every figure is formatted
 * FOR THE PAGE'S LOCALE at the numeric source — never retyped, never
 * string-swapped.
 */
import getTotalTime from "~/components/scripts/getTotalTime";
import HandNote from "~/components/wall/HandNote.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Polaroid from "~/components/wall/Polaroid.astro";
import Stamp from "~/components/wall/Stamp.astro";
import Thread from "~/components/wall/Thread.astro";
import { tautPath } from "~/components/wall/taut";
import { getWall, type Locale } from "~/data/i18n";
import { figure, formatHM } from "~/data/telemetry";
import { properNouns, splitLangRuns } from "~/data/wall";
import Greeting from "./hero/Greeting.astro";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { hero, chartStrings, germanRuns } = getWall(locale);
const ht = chartStrings.heroTelemetry;

/* The record card's first line opens "Fachinformatiker für
   Anwendungsentwicklung" — a German credential inside English prose, and the
   first string a screen reader meets inside `main`. It reads as gibberish in
   an English voice unless the run is marked, which the wall's DECORATIVE
   German ("Der Rote Faden", "Werdegang") already is. `runs()` marks the
   content runs too, from the list in the data layer; on /de/ that list is
   empty and this is one pass-through. */
const runs = (text: string) => splitLangRuns(text, germanRuns);

/* THE SENIORITY ANCHOR IS TWO SENTENCES DOING TWO JOBS, and the card has to
   rank them separately. `intro[2]` reads
     "I have built and operated it for 6 years 8 months — 12/2019 to
      2026-08-03. Qualified 2025, after three years of in-company training."
   The first sentence is the LEVEL statement — the only sentence on the wall
   whose subject is the person and whose predicate is a duration. The second
   pre-empts the objection that level raises. Set as one paragraph they were
   a fourth equal-weight body run, which is the one thing a level statement
   must not be; the fact was landing and its rank was not.
   So the level statement joins the card's bold band and the qualification
   clause falls to the record below it, where its referent — the credential —
   now sits one rule above it instead of three rules away.
   The split is a RANK decision and belongs here, not in the data layer: the
   sentence is one owner-approved fact and stays one string. If the copy ever
   loses its sentence boundary the whole run is set as the anchor, so no
   unreviewed text can be promoted by accident. */
const CLAIM_LINE = 1;
const SENIORITY_LINE = 2;

const [seniorityAnchor, ...seniorityRest] = hero.intro[SENIORITY_LINE].split(/(?<=\.)\s+/);
const seniorityQualifier = seniorityRest.join(" ");

/* THE PAID POST REJOINS THE CARD'S BOLD BAND. Three hiring reviews in a row
   returned the same verdict — "a person who has documented his hobby to a
   professional standard and his profession not at all" — and the third
   measured the mechanism. On the previous build at 1440 × 900, EVERY string
   this card set at ≥ 600 weight inside the first viewport was about the
   unpaid side project:
     y=232  20px/700  "Lars Böse"
     y=256  20px/700  "I run a Discord bot with 2.4M+ users on 8,357 servers"
     y=304  16px/700  "I have built and operated it for 6 years 8 months"
   while the employer printed at 16px/400 at y=451 — 219px below the band,
   in a subordinate clause after the credential's own gloss. The commit that
   put it there called that band "the top two fixation points in recruiter
   eye-tracking and the German stage-1 filter" in its own docstring, and
   then demoted job title and employer out of it. Under anchoring the first
   level a screener assigns is the box the remaining 14,000px are read
   inside, and the card was assigning "hobbyist".

   SO THE POST TAKES ITS OWN BOLD RULE AT THE END OF THE HEAD, and it goes
   AFTER the level statement, not before it: "I have built and operated IT"
   needs the bot as its nearest antecedent, and the employer standing
   between them hands the pronoun to Raleo Digital GmbH. That ordering was
   argued and rejected once already; it stays rejected.
   The credential does NOT come with it. At 700 it was four to six rendered
   lines of bold pointing at a vocational certificate rather than at the
   2.4M-user product, which is why it was set to 400 while keeping the
   record's first rule. Position is one axis and weight is another. The post
   is the fact that gives up POSITION (it leaves the record's first
   sentence) and takes WEIGHT; the credential keeps position and stays at
   400. Do not fix either of them back.

   KEYED ON THE CARD'S STRUCTURE, NOT ON AN ARRAY INDEX, because the copy
   module is another owner's file and gains lines between builds. The post
   is found as "the intro entry that names the employer" — the employer
   being whichever legal name from `properNouns` this wall prints, the same
   list the no-break scanner keys on. If that entry ALSO carries the
   credential (both locales' current copy does) the entry is split at the
   structural boundary the employer's clause opens on — an em dash, a
   closing bracket, a semicolon or a colon — and the head half stays as the
   record's first rule. If the entry does NOT carry the credential, it is
   already a standalone post line and is promoted whole, unsplit.

   THIS IS THE ONE PLACE IN THIS FILE THAT RE-PUNCTUATES OWNER-APPROVED
   PROSE, and that is over the line this cycle otherwise holds: four
   mutations — drop the leading conjunction, capitalise the first letter,
   drop the trailing dash, restore the terminal stop. No guard makes that
   not-a-copy-edit, so the two strings it currently emits are written out
   here for the copy owner to veto:
     en  head "Fachinformatiker für Anwendungsentwicklung (IHK) — the German
              state-recognised vocational qualification in application
              development."
         post "Full-stack developer at Raleo Digital GmbH, remote."
     de  head "Fachinformatiker für Anwendungsentwicklung (IHK)."
         post "Full-Stack-Entwickler bei der Raleo Digital GmbH, remote."
   Every guard below fails CLOSED: if the shape is not the one described,
   nothing is promoted, nothing is re-punctuated, and the card renders the
   entry exactly as the data layer wrote it — the defect returns, but no
   unreviewed sentence is ever printed. */
const CREDENTIAL_RUN = "Fachinformatiker für Anwendungsentwicklung";
/* boundary characters a clause may open on, in either locale — structural
   punctuation only, never a word */
const CLAUSE_OPENERS = ["—", "–", ")", ";", ":"];

/* A SENTENCE BOUNDARY IS AN OPENER TOO, AND LEAVING IT OUT FAILED OPEN.
   The split takes the LAST opener before the employer. On today's English
   entry — "…(IHK) — the German state-recognised … — and full-stack developer
   at Raleo Digital GmbH, remote." — that is the second em dash, the gloss
   stays in the record, and the promotion is correct. Write the same fact
   with the gloss as its own sentence, which is ordinary copy editing —
   "…(IHK) — the German … in application development. Full-stack developer at
   Raleo Digital GmbH, remote, since 07/2025." — and the last CHARACTER
   opener before the employer is the FIRST dash: the head still holds the
   credential, the tail still holds the employer, both assertions below pass,
   and 22 words of gloss are promoted into the card's bold band. Silent, and
   fails OPEN, which is the one thing every other guard here refuses to do.
   IT IS NOT `lastIndexOf(".")`, BECAUSE `.` IS NOT ALWAYS A FULL STOP. The
   copy on this wall already prints "discord.js" and "raleo.de", and an ISO
   date is next door. A full stop counts only where whitespace follows it,
   which no domain or package name on this wall does.
   Measured no-op on the copy as it stands: neither locale has a full stop
   before the employer's name, so today's render is byte-identical. */
const lastSentenceEnd = (line: string, before: number) => {
	for (let i = before - 1; i > 0; i--) {
		if (line[i] === "." && /\s/.test(line[i + 1] ?? "")) return i;
	}
	return -1;
};
/* stripped only where the split already succeeded, so a miss cannot leave a
   sentence beginning with a conjunction */
const LEADING_CONJUNCTION = /^(?:and|und|sowie|&)\s+/i;

const derivePost = () => {
	/* ONE SEARCH, NOT TWO. Finding the name first and then the line that
	   holds it lets the two disagree: `properNouns` opens with the company
	   that ran the apprenticeship, so the moment any hero line names
	   Columbus Interactive GmbH — plausible copy — the name search would
	   return Columbus, the line search would return THAT line, and the
	   apprenticeship would be promoted into the bold band while the paid
	   post stayed at 400. The line is the subject of the question; the name
	   is read off whichever line answered it. The claim and the level
	   statement are excluded here rather than after the fact: both have
	   their own rank and their own reasons, and an employer named inside
	   either is not a post line. */
	const at = hero.intro.findIndex(
		(line, i) =>
			i !== CLAIM_LINE && i !== SENIORITY_LINE && properNouns.some((name) => line.includes(name))
	);
	if (at < 0) return null;

	const line = hero.intro[at]!;
	const employer = properNouns.find((name) => line.includes(name))!;
	/* already a standalone post line — promote it whole, touch nothing */
	if (!line.includes(CREDENTIAL_RUN)) return { at, post: line, record: null };

	const employerAt = line.indexOf(employer);
	const opener = Math.max(
		...CLAUSE_OPENERS.map((c) => line.lastIndexOf(c, employerAt)),
		lastSentenceEnd(line, employerAt)
	);
	if (opener < 0) return null;
	/* a bracket closes the head it belongs to; a dash is spent on the seam */
	const keep = line[opener] === ")" ? opener + 1 : opener;
	const head = line.slice(0, keep).trim();
	/* trimmed BEFORE the conjunction is stripped: the boundary is followed by
	   a space, and an anchored pattern does not match past one */
	const tail = line.slice(opener + 1).trim().replace(LEADING_CONJUNCTION, "").trim();
	/* the whole point of the split, asserted rather than assumed: the
	   credential lands in the RECORD half and the employer in the POST
	   half. Either miss and nothing is promoted at all. */
	if (!head.includes(CREDENTIAL_RUN) || !tail.includes(employer)) return null;

	return {
		at,
		post: tail.charAt(0).toLocaleUpperCase(locale) + tail.slice(1),
		record: /[.!?]$/.test(head) ? head : `${head}.`
	};
};

const post = derivePost();

/* EVERY ENTRY IN `hero.intro` IS PRINTED EXACTLY ONCE, and this is where
   that is enforced rather than hoped for. The claim and the level statement
   are set above by index because the data module documents those two
   positions as load-bearing; everything else is taken by structure, so a
   line APPENDED to the array (the module's stated contract) lands in the
   record on its own instead of being silently dropped — which is how the
   card once lost text.

   THE APPENDED ENTRIES NOW OPEN THE RECORD, AND THE CREDENTIAL FOLLOWS THEM.
   The two lines added last cycle to put a technology in the first viewport
   landed on DESKTOP ONLY. Measured on the served build at 390 × 844, root 16,
   both locales: "TypeScript, day to day — 55.59 % …" began at y 850 English
   and y 826 German, and "Open to TypeScript/Node product work …" at y 922 in
   both, against a fold at 844. On the surface a screener actually uses, a
   candidate selling TypeScript/Node showed neither: the only technical noun
   above the English fold was "Discord bot". Desktop had them at y 597 and 616
   and the check stopped there — the same one-surface verification error this
   file has now paid for four times.
   The displacement was measured, not guessed. Between the head's last rule
   and those two lines stood the credential with its English gloss (5 printed
   rules, 120px at 390), the qualification clause (2 rules, 48px) and the
   geography (3 rules, 72px) — 240px, against the 236px by which the ask
   overran the fold. No arrangement keeps the credential in the record's first
   position AND the ask above 844: the gloss alone is half the deficit. So the
   axis the credential yields this time is POSITION, the same trade the paid
   post made in the other direction one cycle ago — and it keeps everything
   else: its own rule, the qualification clause directly beneath it, and its
   place on the card a reader reaches in one flick.
   Re-measured with the same probe after the change, at 390 × 844 root 16,
   with this cycle's copy in place and the post's start month modelled at its
   longest ("— since July 2025."): English technology 596→674, ask 668→746;
   German 644→746 and 740→818. Both clear 844 in both locales, the German ask
   by 26px, which is the binding case. At root 20 and 24 nothing past the
   head fits on any arrangement — the head alone is 842px at root 20 — but
   both lines move up by the same 240px there too, so the enlarged case is
   improved and not traded.
   Order in the record, therefore: whatever the copy module has appended
   (currently the technology, the ask and the merged-upstream line), then the
   credential, then the qualification clause one rule below the referent it
   qualifies, then geography, then languages. */
const recordOpen = post && post.at === 0 ? post.record : hero.intro[0];
const recordRest = hero.intro.filter((_, i) => i > SENIORITY_LINE && i !== post?.at);

const stats = await getTotalTime();

/* Figures are formatted from the NUMERIC source for this page's locale —
   8,357 on /, 8.357 on /de/. The snapshot branch needs no conversion: the
   German wall module already carries German-formatted strings. */
const telemetryLines: string[] =
	stats.source === "live"
		? [
				ht.total(formatHM(stats.total.seconds, locale), stats.asOf),
				ht.activeDays({
					active: figure(stats.days.active, locale),
					elapsed: figure(stats.days.elapsed, locale),
					/* the rate is a figure like every other on this wall: a raw
					   number would print "90.6" on the German page */
					ratePercent: figure(stats.days.ratePercent, locale),
					start: stats.range.start,
					end: stats.range.end
				}),
				ht.dailyAverage(formatHM(stats.dailyAverage.seconds, locale))
			]
		: [...hero.telemetryCard.lines];

const sourceLine = ht.sourceLine(
	hero.telemetryCard.sourceNote,
	stats.source === "live" ? ht.modeLive : ht.modeSnapshot
);

/* The thread, desktop: it enters at the record card's pin (top left, where
   reading starts), crosses to the signature, drops to the polaroid at the
   lower left, runs right through the evidence print-out to the 12/2019
   stamp, and leaves the board's bottom edge at x ≈ 67 % (802/1200), where
   the next section picks it up. The last station is on purpose the one
   furthest right: the join below runs down-LEFT, so the hero's last run
   has to arrive from the right or the seam kinks on bare cork.

   TAUT: straight runs pin to pin; direction changes only as a small
   wrap around each pin (tautPath). Coordinates live in the viewBox
   space and stretch with the board (preserveAspectRatio="none") —
   straight segments survive that stretch exactly.

   ONE MEASUREMENT PER LOCALE, because the two locales are not the same
   wall. German runs longer: the record card sets three rules where the
   English one sets two, so band 2 starts 28px lower and the board is
   727px tall against 699. Read as a FRACTION of the board — which is what
   a stretched viewBox does — the polaroid's pin sits at 41.4 % on /
   and 46.4 % on /de/. A single averaged path leaves the thread ending in
   bare cork ~35px off three of its five pins, which is exactly the defect
   the taut geometry exists to avoid, so each locale carries its own
   measured vertices. Every vertex below is a pin centre measured at
   1440 × 900 (identical at 1280 — the shell is capped at 78rem, so one
   measurement covers every width where the board is full). Re-measure
   and retune whenever an artifact moves.

   THE ONE STATION THAT IS NOT A PIN. The run from the signature to the
   polaroid is the wall's highest-value junction — its focal mass to its
   strongest image — and as a straight line it was 758px long and 11.3 %
   visible, in two disconnected fragments (measured at 1440, both locales:
   11.3 % en / 10.5 % de, occluded by `.hero__greeting` and the typed
   record card). From the name the thread simply disappeared, and the next
   red ink the eye found was a stub emerging from under a card 300px away.
   A straight line between two pins is right when there is cork between
   them; here there is a 590px sheet and a 490px sheet edge to edge, so
   the taut run had nowhere to surface.
   So it now leaves the signature pin DOWNWARD, clears the two band-1
   sheets by their bottom edge, and crosses the open cork of the band gap
   on its way west. That is one extra vertex, and it is a BEND, not a pin:
   it takes no thread dot, because a dot with no pin under it is the wall
   telling a lie about its own material. Every other vertex here is a pin
   centre, and `nodes` is built from exactly those. */
type Station = { x: number; y: number; pin: boolean };
const P = (x: number, y: number): Station => ({ x, y, pin: true });
const BEND = (x: number, y: number): Station => ({ x, y, pin: false });

/* RE-MEASURED 2026-08-06, after the record card was re-ranked (the claim and
   the name one step up, the level statement split off as its own bold rule)
   and the signature was set at 89px instead of 64px. Band 1 grew 24px in
   both locales — the card 420 → 444 px and the greeting sheet 237 → 263 —
   which moved every band-2 pin down AND stretched the board, so every vertex
   below changed even though nothing moved sideways.
   Boards: 1248 × 867 en, 1248 × 847 de (were 843 / 823).
   Every P below is a pin centre read off the rendered page at 1440 × 900 and
   converted into this viewBox (`scratchpad/fix3/hero/pins.mjs`), rounded to
   the unit — well inside the 7px head the thread wraps.

   AND THE BOX IS NOW 1500 × 1100, NOT 1200 × 880 — for the reason the
   stacked column already carries in its own note, which the desktop box was
   wrongly assumed to be clear of. `stroke-dasharray: 1` against
   `pathLength="1"` under `vector-effect: non-scaling-stroke` makes the dash
   as long as the path's USER-space length but measures it in SCREEN space,
   so wherever the board stretches the path the tail never paints. The board
   is 1248px wide against a 1200-unit box: x stretches by 1.04, and that
   stretch fell on the long horizontal runs. MEASURED on the served build,
   both before and after this cycle's edits: rendered 2,910.8px against an
   authored 2,831.1 — the desktop thread stopped 79.7px short of the board's
   bottom edge, i.e. it never reached the hand-off to the Timeline that cycle
   1 fixed, in both locales, at every width. The old note's "the desktop box
   is safe (0.903 en / 0.935 de)" was measuring something else.
   Scaling the box and every coordinate by 1.25 leaves the picture identical
   and multiplies only the authored length: rendered/authored is now 0.821 en
   / 0.817 de, and both scales are below 1 at every desktop width the shell
   allows (the board is at most 1248 × 939, at the 1024 breakpoint).

   The BEND is the one vertex whose job is VISIBILITY rather than
   registration, so it is not measured off a pin. It used to sit at 330/370
   of the old box — ABOVE the record card's bottom edge, so the leg west
   dived under the card and surfaced twice. Dropped just below that edge
   (the card bottoms out at 556 en / 569 de in this box) the whole leg runs
   in the open cork of the band gap, and the measured visible fraction of the
   desktop thread rises from 63.7 % to 69.7 % English and 61.5 % to 69.3 %
   German (`scratchpad/fix3/hero/thread.mjs`, pixel diff against the same
   board with the thread hidden).

   RE-MEASURED 2026-08-10, and the note it replaces was right that it had to
   be: the previous vertices had gone stale by 83 viewBox units — 77px, or 11
   pin heads — at the polaroid's pin, which is a thread ending in bare cork
   beside the sheet it is supposed to be tied to. Two cycles of copy did it:
   the technology line and the offer (+96px, never re-measured) and this
   cycle's merged-upstream line and the post's start month. Board 867 → 1059
   en and 847 → 1015 de at 1440 × 900.
   Every P below is a brass pin's centre read off the rendered page and
   converted into this viewBox by the same fraction the SVG uses
   (`(x − boardLeft) / boardWidth × 1500`, `(y − boardTop) / boardHeight ×
   1100`). Measured on a private copy of the build with this cycle's copy
   injected into the DOM — the merged-upstream line in both locales, the ask
   in its `Produktentwicklung` form, and the post's start month modelled at
   its longest ("— since July 2025." / "— seit Juli 2025."). If that month
   does not ship the band-2 vertices are 26 units high, which is 24px, inside
   the 7px head only for x; re-measure against the built page when the copy
   is frozen. It is a strictly smaller error than the 83 it replaces.
   THE BEND IS THE ONE VERTEX A 1440 MEASUREMENT NO LONGER SETTLES, and this
   is the cycle that stopped being true. Its whole job is that the leg west
   runs in the open cork BELOW the record card instead of diving under it, so
   it has to sit under that card's bottom edge at every width the desktop
   path is drawn at — and the desktop path starts at 1024, where the shell is
   viewport-limited, the card is narrower and wraps to more rules, and its
   bottom edge sits LOWER as a fraction of the board. Measured, this cycle's
   copy, both locales:
     1280 and 1440 are identical (shell capped at 78rem, board 1248 × 1059 en
       / 1015 de): card bottom 654.5 en, 656.8 de; polaroid pin 674.2 / 677.4.
     1024 (board 1009 × 1148 en / 1148 de): card bottom 673.0 / 671.5;
       polaroid pin 693.0 / 690.9.
   The band gap is 20 units wide and the whole band drifts 19 units between
   those widths, so the two windows barely intersect: 673.0 < y < 677.4 is
   everything both locales allow, and 675 is inside it — 2.0 units below the
   1024 card in English, 3.5 in German, and within a unit of the polaroid's
   pin at the tuned width, where the leg simply arrives level. Tuned at 1440
   alone it would have been 663, which is 10 units INSIDE the card at 1024 —
   the leg hidden for more than half its length, which is the defect the bend
   exists to remove. Both locales therefore carry the same number here, for
   the first time, because that is where the two windows overlap.
   AND THE RECORD CARD HAS NOW SPENT THIS MECHANISM. Four more units of card
   and the windows stop intersecting at all; at that point the bend needs a
   different resolution, not another nudge.
   THE DASH DEFECT DOES NOT COME BACK. Measured on the render by walking the
   path and mapping every sample through the element's own screen CTM:
   rendered/authored is 0.863 en and 0.854 de against a 1500 × 1100 box. That
   reading was taken on the PRE-TUNE vertices at the post-copy board height —
   the re-tune moves rendered and authored together, so the conclusion holds,
   but re-verify it on the built page rather than quoting these two figures
   for the path below. */
const DESKTOP_STATIONS: Record<Locale, Station[]> = {
	en: [
		P(390, 1),
		P(1115, 1),
		BEND(1131, 675),
		P(264, 674),
		P(807, 699),
		P(1302, 801),
		P(1002, 1100)
	],
	de: [
		P(390, 1),
		P(1115, 1),
		BEND(1131, 675),
		P(264, 677),
		P(807, 703),
		P(1302, 810),
		P(1002, 1100)
	]
};

const stations = DESKTOP_STATIONS[locale];
const THREAD_DESKTOP = {
	width: 1500,
	height: 1100,
	path: tautPath(stations.map((s): [number, number] => [s.x, s.y])),
	/* a thread dot on every pin it wraps — never on the exit vertex, and
	   never on the bend, which has no pin under it */
	nodes: stations.slice(0, -1).filter((s) => s.pin)
};

/* The thread, stacked column: a taut near-vertical stitch down the
   center, from behind the record card to the bottom edge — straight
   runs between the cards' pin stations, tiny wraps at each. The column's
   cards span the full width, so the thread runs BEHIND the paper
   (z-index, see styles) and surfaces in the cork gaps between artifacts.
   Stations, in the column's own order: record → signature → exhibit →
   evidence → stamp (measured at 390 × 844).

   ONE path serves both locales here, where the desktop wall needs two:
   this run is a straight vertical stitch, so a vertex's y is a position
   ALONG the line rather than an offset FROM it, and only x can miss a
   pin. Measured across both locales the pins sit within 9 viewBox units
   — 2.2px — of the x values below, well inside the 7px pin head the
   thread wraps.

   THE ONE DETOUR IS THE STAMP. The 12/2019 stamp is the only artifact in
   this column with no paper under it, and it is centred on exactly the
   line the stitch runs down — so the straight run crossed its ring and
   its "12/2019", which is the one thing no run on this wall may do. The
   path leaves the centre line after the evidence sheet, passes the stamp
   on its left with 17.2px of clearance (measured, identical in both
   locales), clears its lowest point by 6.5px on the hook back, and lands
   on the pin below it — 2 viewBox units, 2px, from the measured pin
   centre in either locale, inside the 7px head it wraps. A thread
   going around an obstacle is the metaphor working, not an exception to
   it.

   THE viewBox IS 2400 TALL, NOT 2000, AND THAT IS LOAD-BEARING. Every
   thread on this wall is dashed with `stroke-dasharray: 1` against
   `pathLength="1"`, i.e. one dash exactly as long as the path — and it is
   stroked with `vector-effect: non-scaling-stroke`, which makes the
   browser measure the dash in SCREEN space while `pathLength` normalised
   it in viewBox space. Under `preserveAspectRatio="none"` those two
   spaces have different scales, so wherever the box is stretched
   VERTICALLY the rendered path is longer than its own dash and the tail
   simply never paints. At 1600 the stacked board (1,699px English,
   1,859px German over a 390px-wide viewport) stretched y by 1.16 and the
   thread died 14 % short — it stopped between the evidence sheet and the
   stamp and never reached the board's bottom edge to hand over.

   AND 2000 STOPPED BEING ENOUGH THE MOMENT THE RECORD CARD GREW. The name
   rule and the seniority anchor put the German stacked board at 2,035px
   against a 2,000-unit box: ratio 1.0175, the defect back on the one wall
   that had the least headroom, with no symptom at any other width. Raised
   to 2400 the measured rendered/authored ratio is 0.785 English and 0.848
   German — the rendered path is SHORTER than its dash at both, with room
   for the card to grow another ~360px before the question is live again.
   The desktop box is safe for the same reason (0.903 en / 0.935 de). Any
   future edit that shortens this viewBox, OR that lengthens this column,
   has to be measured against that ratio.

   RE-MEASURED 2026-08-06 at 2400 units, after the re-ranked record card and
   the 89px signature. The stacked board grew 2,011 → 2,029 px English and
   2,003 → 2,021 German, so the ratio the paragraph above makes load-bearing
   moves from 0.785 / 0.848 to 0.792 / 0.855 — still well under 1, with room
   for the column to grow another ~340px before the question is live again.
   The x values did not move — the x scale did not change and the column's
   pins stand where they stood — and the y values are the two locales'
   measurements averaged, which is legitimate here for the reason the
   paragraph above gives: on a vertical run a y error slides ALONG the line
   instead of off it. The one y that is not an average is the stamp detour,
   whose whole job is clearance, and it is set against the LATER of the two
   stamps: re-measured, both stamp boxes still bottom out at 2,333 and both
   still start at x = 153.7, so the detour's two vertices are unchanged and
   the left clearance is still 17.7 units.

   RE-MEASURED 2026-08-10, AND THE BOX IS NOW 3000 TALL, NOT 2400, WITH EVERY
   COORDINATE SCALED BY THE SAME 1.25. Two things had gone wrong and only one
   of them was visible.
   THE DASH RATIO HAD WALKED UP TO 0.988. Measured on the rendered page rather
   than inferred — sampling the path 4,000 times and mapping every sample
   through the element's own screen CTM, then dividing the summed screen
   length by `getTotalLength()`: 2,425px rendered against 2,454 authored units
   on the German wall at 390 × 844, with this cycle's copy in the card. That
   is 1.2 % from the tail not painting at all, which is the exact defect the
   two paragraphs above exist to prevent, and it arrived through the data
   layer rather than through this file — the stacked board went 2,231 → 2,375
   px on the merged-upstream line and the post's start month. One more rule of
   German copy crosses it. Scaling the box AND every coordinate by k leaves
   the picture identical and multiplies only the authored length, so at
   k = 1.25 the ratio is 0.79 and the column has ~600px of growth in hand.
   THE STATIONS HAD GONE STALE BY UP TO 228 UNITS of the old box at the
   signature's pin. It matters less here than on the desktop wall — this run
   is a vertical stitch, so a y error slides ALONG the line rather than off it,
   which is why nothing looked wrong — but the STAMP DETOUR is the exception,
   and it had inverted: its hook back sat at 2,334 of the old box while the
   stamp's own box now bottoms out at 2,341 en / 2,343 de, i.e. the run that
   exists to pass the stamp had climbed INTO it. Every value below is measured
   off the rendered page (pin centres, and the stamp's own box for the
   detour), averaged across the two locales for the reason the paragraph above
   gives, and then scaled: signature 976, exhibit 1193, evidence 1716, pin
   2352 in 400 × 2400 units; the detour leaves the line 61 units above the
   stamp's top edge, as it did before, and hooks back 1 unit under its bottom.
   The detour's x is derived rather than kept: the stamp's left edge reads
   189.75 in the new box, and 167 leaves it 22.75 units — 17.1px at a 375px
   board, the same clearance the note above records.
   Same caveat as the desktop stations: the post's start month is modelled at
   its longest, so if it does not ship these sit ~30 units low. */
const THREAD_MOBILE = {
	width: 500,
	height: 3000,
	path: tautPath(
		[
			[258, 0],
			[248, 1220],
			[255, 1491],
			[245, 2145],
			[167, 2735],
			[167, 2929],
			[250, 2940],
			[250, 3000]
		],
		7.5
	)
};

/* THE PHONE'S ENTRANCE, on the site called after the thread.
   A pixel census of the crimson family over the first phone viewport found
   342 crimson pixels in the English phone frame, ALL of them between y 79
   and 260 — the title card's rule and the language tab's underline, i.e.
   two typographic rules. The THREAD contributed zero. The desktop
   comparison frame at the same moment holds 11,727 crimson pixels spanning
   y 41–899, the thread crossing the whole frame and leaving the bottom
   edge. A 34× difference, in the device where the corridor is 26 screens
   long and the reader most needs a stated route.
   The mechanism is not the path, it is the paper: the stacked column's
   thread is correct and RUNS THE WHOLE HEIGHT — it simply runs behind
   sheets that span the full width. `.hero__thread--mobile`'s box begins at
   the board's top edge (document y 301 at 390 × 844, root 16), and from
   there to the fold the identity card covers x 17.5–357.5 of a 375px
   layout. Nothing painted, because there was no bare cork left to paint on.
   The bare cork is ABOVE the board, in the shell's own 24px side padding,
   and it costs no vertical space at all.

   ITS OWN BOX, AND ITS OWN BOX ON PURPOSE. Folding this into
   THREAD_MOBILE was the first design and it is wrong: that box stretches y
   (a 2,027px board against 2,400 units, so 1 unit = 0.845px) and every
   station in it is measured in that stretched space. A header offset is a
   PX distance from a fixed anchor — the gap between the language tab's
   bottom edge and the board's top edge is the hero's own padding, measured
   22.4–23.0px at every width and root size in the matrix — and expressing a
   px distance in a box that stretches with the board's height makes it vary
   with the board's height. Worse, it would shift all eight measured
   stations. So the entrance is a SEPARATE box, anchored `bottom: 100%` to
   the board's top edge with a FIXED px height, which is the only way to say
   "17px above the board's top edge" and mean it. It ends exactly where
   THREAD_MOBILE begins (x 206/400 of the board, y at the board's top edge),
   so the two paths are one thread with one seam on a pin.

   THE ROUTE, and one thing it cannot do. It cannot start ON the title
   card's pin: `main` carries `isolation: isolate` (wall.css), so every
   descendant of the hero paints as one atomic unit AFTER the `<header>`,
   at any z-index — probe-verified on the served build, a z-index:-1 layer
   inside the board painted straight across the title card's face. A run
   behind that card is not expressible from this file. The thread therefore
   enters at the wall's top edge, passes the title card and the language tab
   ON THEIR LEFT over bare cork only, and ties to the identity card's pin —
   the same shape as the desktop wall, whose first station is also on the
   board's top edge.

   EVERY NUMBER BELOW IS A MEASURED CLEARANCE, taken off the served build at
   320 / 390 / 768 / 1023 CSS px and root 16 / 20 / 24 / 32, both locales:
     x = 24/1200 of the box.  The corridor it runs in is `.wall-max`'s
       padding — 24 FIXED px at every width — while this coordinate SCALES
       with the board, so it is chosen for the WIDEST stacked board, not the
       narrowest. Rendered: 6.1px at a 305px board, 7.5px at 375, 15.1px at
       753. The narrowest measured title card sits at x 20.3 (320 px, root
       32) and 21.9 (768 px, root 32); worst clearance is 5.6px with the
       2.5px stroke counted. The leftmost language tab measured 76.
     y = 1509/1560, i.e. 17px above the board's top edge, for the bend.
       The smallest gap between the lowest header element and the board's
       top edge across the whole matrix is 17.7px (1023 px, root 24), so the
       bend and the whole leg after it run under nothing. That leg is
       shallow — 185 × 17px at 390 — and it is the same move the desktop
       wall makes along its own top edge between the record card's pin and
       the signature's.
     height 520px. It has to reach past the tallest header the matrix
       produces (457.5px at 320 px, root 32, both locales) so the thread
       always enters from OFF the page rather than starting abruptly on
       cork. Anything above the page's top edge is simply not painted.
   Expected visible run at 390 × 844, root 16: 284px down the corridor plus
   186px on the leg = 470px of path at a 2.5px stroke, against an acceptance
   floor of 400 crimson pixels above the fold.
   THE CORRIDOR IS 38px SHORTER SINCE 2026-08-10, because the head above it
   is: the narrow `.wall-head` block in WallPage.astro went 277.3 → 239.3px,
   so the board's top edge rose from y 301.3 to 263.3 and the visible run
   from 284 to 246px — 432px of path in total. Two things keep that inside
   the floor rather than near it. The stroke is `--thread-w`, 4px and not the
   2.5 this note was written against, so the run is ~1,730 crimson pixels
   where the floor is 400. And the geometry is untouched: the bend is
   measured from the BOARD's top edge, not from the page's, and the gap
   between the language chit and that edge is the hero's own padding —
   re-measured at 23.0px after the compression, exactly what it was before,
   against the 17px the bend sits at.

   COORDINATES ×3 AGAINST A ×3 BOX, for the dash reason this file records
   twice already: `stroke-dasharray: 1` against `pathLength="1"` under
   `vector-effect: non-scaling-stroke` measures the dash in SCREEN space and
   normalises it in viewBox space, so wherever the rendered path is longer
   than the authored one the tail never paints. Scaling the box and every
   coordinate by k leaves the picture identical and multiplies ONLY the
   authored length: rendered is 1,002px at the worst case (a 1,008px board),
   authored is 2,105 units at k = 3 — ratio 0.48, and it cannot rise,
   because the y scale is pinned at 1:1 by the fixed height.
   DRAWN, NOT SCROLL-DRAWN. `animation-range: cover 0% cover 100%` puts this
   box at 77.9 % of its own range at scroll 0, which lays the corridor but
   leaves the leg to the pin 22 % painted — a thread stopping in mid-cork
   for the one reader this entrance exists for. The entrance is the wall's
   opening statement; it is already laid when the reader arrives. */
const THREAD_ENTRANCE = {
	width: 1200,
	height: 1560,
	path: tautPath(
		[
			[24, 0],
			[24, 1509],
			[618, 1560]
		],
		21
	)
};
---

<section class="hero">
	<div class="hero__board wall-max">
		<div class="hero__thread hero__thread--desktop" aria-hidden="true">
			<Thread
				path={THREAD_DESKTOP.path}
				width={THREAD_DESKTOP.width}
				height={THREAD_DESKTOP.height}
				nodes={THREAD_DESKTOP.nodes}
			/>
		</div>
		<div class="hero__thread hero__thread--mobile" aria-hidden="true">
			<Thread
				path={THREAD_MOBILE.path}
				width={THREAD_MOBILE.width}
				height={THREAD_MOBILE.height}
			/>
		</div>
		<!-- the phone's entrance: the run above the board, in the shell's own
		     side padding. See THREAD_ENTRANCE for the census that forced it
		     and for every clearance below. -->
		<div class="hero__thread hero__thread--entrance" aria-hidden="true">
			<Thread
				path={THREAD_ENTRANCE.path}
				width={THREAD_ENTRANCE.width}
				height={THREAD_ENTRANCE.height}
				draw={false}
			/>
		</div>

		<div class="hero__grid wall-grid">
			<!-- CLAIM. Typed record card: what / who / where.
			     THREE RANKS, NOT TWO. The card used to have exactly one weight
			     contrast and it pointed at the credential: name and credential
			     bold, everything else regular, all six paragraphs at the card's
			     16px. Five instruments measured the same consequence — the
			     name and the credential were set at the smallest reading size
			     on the wall while the telemetry bullets beside them were 20px;
			     every fact about the person on a phone was exactly 15.0px; the
			     claim was line three of a six-line block with no salience
			     handle at all; and the level statement was installed as a
			     fourth equal-weight paragraph.
			     The card is a head and a record. The HEAD is the name, the
			     claim, the level statement and the paid post; the RECORD is
			     whatever the copy module has appended (the technology, the
			     ask), then the credential, the qualification, the geography
			     and the languages.
			     The claim keeps the strongest slot on the card and the level
			     statement stays directly beneath it, because "I have built and
			     operated IT" needs the bot as its nearest antecedent — putting
			     the employer between them, as one reading of the finding asked,
			     would hand the pronoun to "Raleo Digital GmbH". The post
			     therefore closes the head rather than opening it. -->
			<div class="hero__intro-slot">
				<PinCard variant="typed" rotate={1}>
					{/* THE NAME IN ITS LEGAL FORM, ON THE RECORD CARD. The drawn
					    signature beside this card reads "Lars Boese" and stays that
					    way: a signature may legitimately be ASCII, and the Lottie
					    swash is measured against that exact string. But the title,
					    the footer stamp and the schema.org record all say *Böse*, so
					    a wall that never typed the umlaut anywhere a recruiter could
					    copy it offered three spellings and no canonical one. A typed
					    record card is where a name belongs; it opens the head. */}
					<p class="hero__intro-name">{hero.name}</p>
					{/* the claim, and now the largest typed setting in the fold */}
					<p class="hero__intro-claim">
						{runs(hero.intro[CLAIM_LINE]).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}
					</p>
					{/* the level statement — the duration a screener would otherwise
					    compute from the apprenticeship letterhead alone, and compute
					    wrongly. Bold, on the card's own size, directly under the
					    sentence it quantifies. */}
					<p class:list={["hero__intro-anchor", !post && "hero__intro-head-end"]}>
						{runs(seniorityAnchor).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}
					</p>
					{/* THE PAID POST, and the last rule of the head. Same weight and
					    same size as the level statement above it: it is the second
					    half of one answer to "what is he now", not a louder one. See
					    `derivePost` for why it is here and why the credential is
					    not. */}
					{post && (
						<p class="hero__intro-post hero__intro-head-end">
							{runs(post.post).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}
						</p>
					)}
					{/* THE RECORD OPENS ON WHAT THE COPY MODULE APPENDED — currently
					    the technology, the ask and the merged-upstream line. They are
					    here rather than at the foot of the card because at 390 × 844
					    the credential, the qualification clause and the geography cost
					    240px between the head and them, and the ask overran the fold
					    by 236 (measured, both locales; see `recordRest` above for the
					    whole census). Body rank is unchanged and deliberate: the ask's
					    value is that it is in the first viewport at all, and a fifth
					    bold rule would spend the band the last cycle repaired.
					    ARRAY ORDER IS PRESERVED INSIDE THIS BLOCK, which is what the
					    data module's "append; never insert" contract buys — a line
					    appended after the ask still prints after the ask. */}
					{recordRest.map((line) => (
						<p>{runs(line).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}</p>
					))}
					{/* the credential, at the card's own size and weight */}
					{recordOpen && (
						<p class="hero__intro-role">
							{runs(recordOpen).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}
						</p>
					)}
					{seniorityQualifier && (
						<p>{runs(seniorityQualifier).map((part) => (part.de ? <span lang="de">{part.text}</span> : part.proper ? <span class="proper">{part.text}</span> : part.nowrap ? <span class="nowrap">{part.text}</span> : part.text))}</p>
					)}
					<p>{hero.location}</p>
					<p class="hero__intro-langs">{hero.languages}</p>
				</PinCard>
			</div>

			<!-- SIGNATURE. The handwritten centrepiece and the fold's focal
			     mass: the widest sheet in the cluster, carrying the largest
			     setting on the page. -->
			<div class="hero__greeting paper pinned" style="--tilt:-1">
				<span class="brass-pin hero__greeting-pin" aria-hidden="true"></span>
				{/* `name` is what the signature DRAWS (ASCII, matched to the
				    Lottie's strokes); `spoken` is what the `<h1>` SAYS. They
				    differ by one glyph and that glyph is the point: the sr-only
				    sentence was the only string on the wall that gave a screen
				    reader "Boese" while the title, this card, both stamps and the
				    LinkedIn card all read "Böse". Nothing visual changes. */}
				<Greeting
					greeting={hero.greeting}
					subline={hero.greetingSubline}
					name={hero.signature}
					spoken={hero.name}
				/>
			</div>

			<!-- EXHIBIT. Ayako polaroid: a product artifact, labelled like
			     one — the caption names the thing on line one and measures it
			     on line two (the newline is joined here so the data keeps two
			     clean strings; see .hero__polaroid-slot styles). Full chroma,
			     full size, never presented as a portrait. -->
			<div class="hero__polaroid-slot">
				<Polaroid caption={`${hero.polaroid.label}\n${hero.polaroid.caption}`} rotate={1}>
					<img
						src={hero.polaroid.image}
						alt={hero.polaroid.alt}
						width="640"
						height="640"
						loading="eager"
						fetchpriority="high"
						decoding="sync"
					/>
				</Polaroid>
				<div class="hero__polaroid-note paper-slip">
					<HandNote ink={hero.polaroid.annotation.ink}>{hero.polaroid.annotation.text}</HandNote>
				</div>
			</div>

			<!-- EVIDENCE. The hand-annotated telemetry print-out that proves
			     the claim above it. -->
			<div class="hero__telemetry-slot">
				<PinCard variant="print" rotate={-1} as="article">
					<h2 class="hero__telemetry-title">{hero.telemetryCard.title}</h2>
					<ul class="hero__telemetry-lines" role="list">
						{telemetryLines.map((line) => <li>{line}</li>)}
					</ul>
					<p class="hero__telemetry-source">{sourceLine}</p>
				</PinCard>
				<div class="hero__telemetry-note paper-slip">
					<HandNote ink={hero.telemetryCard.annotation.ink}>
						{hero.telemetryCard.annotation.text}
					</HandNote>
				</div>
			</div>

			<!-- STAMP. 12/2019 — where the thread starts in time, and the
			     hand-off to the Timeline below. -->
			<div class="hero__origin">
				<Stamp label={hero.threadStart.stamp} rotate={-8} />
				<span class="brass-pin hero__origin-pin" aria-hidden="true"></span>
				<div class="hero__origin-note paper-slip">
					<HandNote ink="green">{hero.threadStart.label}</HandNote>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: calc(var(--baseline) * 3) 0 calc(var(--baseline) * 10);
		overflow-x: clip;
	}

	.hero__board {
		position: relative;
		/* query container for the origin row's zoom fallback further down.
		   It sits HERE, on the board, and not on the row it restyles,
		   because a container query only ever reaches its container's
		   DESCENDANTS: the row has to change axis, and the tuned thread —
		   the row's sibling, not its child — has to stop being drawn with
		   it. The board is the nearest element that contains both. */
		container: hero-wall / inline-size;
	}

	/* ---- the thread through the cluster ------------------------ */
	/* Behind the paper on every breakpoint: a pinned thread runs under
	   overlapping sheets and surfaces in the cork gaps — it must never
	   cross printed text. The tilted cards' transforms stack them above. */

	.hero__thread {
		position: absolute;
		inset: 0;
		pointer-events: none;
		/* below every card, note, and pin: the taut thread surfaces only
		   on bare cork (same layering as the section connectors) */
		z-index: -1;
	}

	.hero__thread :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hero__thread--mobile {
		display: none;
	}

	/* THE ENTRANCE BOX HANGS ABOVE THE BOARD, and `top` has to be released
	   by hand for that to happen: `.hero__thread` above sets `inset: 0`, and
	   with `top`, `height` and `bottom` all non-auto the browser DROPS
	   `bottom` (CSS 2.1 §10.6.4) — the box would land at the board's top
	   edge and hang 520px DOWN, across the identity card's face. Correct in
	   the stylesheet, wrong on screen, which is the failure mode this
	   project has shipped four of. `left`/`right` stay at 0, so the box is
	   the board's width and the path's x fractions mean what they say.
	   `pointer-events: none` is inherited from `.hero__thread` and is
	   load-bearing here rather than tidy: this box overlays the title card's
	   whole index and the language tab, which are the only links in the
	   first phone viewport. Restated so it cannot be lost by refactor.
	   z-index stays at `.hero__thread`'s -1 — NOT the `--mobile` rule's
	   `auto` further down, which is scoped to that class — so the last few
	   pixels at the pin tuck under the identity card's rotated top corner
	   instead of printing on it. */
	.hero__thread--entrance {
		display: none;
		top: auto;
		bottom: 100%;
		height: 520px;
		pointer-events: none;
	}

	/* ---- the cluster on the hidden 12-col grid ----------------- */
	/* TWO BANDS, read left to right, top to bottom, in document order.
	   Band 1: the typed record (the claim) at the left, where reading
	   starts, and the signature across the rest of the shell as the
	   fold's largest sheet. Band 2: the Ayako polaroid at the left, the
	   evidence print-out beside it, and the 12/2019 stamp at the right
	   where the thread leaves the board. */

	.hero__grid {
		position: relative;
		align-items: start;
		row-gap: calc(var(--baseline) * 3);
	}

	/* typed record card: band 1, left — the primary optical area. Six
	   columns, not five: the record's first line is its longest, and at
	   five columns it broke to three rules and pushed the whole second
	   band 72px down, past the 900px fold. */
	.hero__intro-slot {
		grid-column: 1 / 7;
		grid-row: 1;
		margin-top: 0;
	}

	/* Typed on consecutive rules, the way a card actually gets typed: the
	   record is ONE block, not seven floating paragraphs. The single blank
	   rule is set below, at the end of the head. Leading comes from the card
	   itself (pin-card--typed) at every rank — one card, one carriage. */
	.hero__intro-slot :global(.pin-card) p {
		margin: 0;
	}

	/* THE HEAD, one step up. "On a monospace sheet a second size is a second
	   machine" was the reasoning that held the name and the claim at the
	   card's own 16px, and it is wrong about a typewriter: a typist has one
	   size, but a TYPED CARD is not a typewriter — it is a filled-in form,
	   and forms have head fields. The wall already contains this exact move,
	   with its reasoning written out, at `Timeline.astro:950-955`, where the
	   first row of an employment span takes --step-1 against the letterhead's
	   --step-0.
	   --lh-1 IS THE SAME 24px AS --lh-0, so the pitch is untouched: one line
	   per printed rule. Pitch is not the whole of the Ruled Card Rule though
	   — REGISTRATION is the other half, and a 20px baseline does not sit
	   where a 16px one does inside a shared 24px line box. Measured rather
	   than assumed, against the ruling read out of the rendered pixels
	   (`scratchpad/fix3/hero/rules.mjs`, ruling phase 16 mod 24): every one
	   of the card's seven paragraphs, head and body, lands 0.00px off its
	   rule at 1440 in both locales, and 1.00px at 390 — where the 1px is the
	   phone's fractional 15.04px body, not the head, and predates this
	   change. `--rule-phase` therefore stays at PinCard's 7px. */
	.hero__intro-slot :global(.pin-card) p.hero__intro-name,
	.hero__intro-slot :global(.pin-card) p.hero__intro-claim {
		font-size: var(--step-1);
		line-height: var(--lh-1);
		font-weight: 700;
	}

	/* The level statement and the paid post: the card's bold, at the card's
	   own size. Both are a RANK below the claim on purpose — one quantifies
	   the sentence above it, the other answers the same question from the
	   other side, and neither may compete with the claim or with the 20px
	   name. They are a rank ABOVE the record because a bold band is a
	   scanned object and a body paragraph is not: the post spent six years
	   as sentence-half four of a six-line regular block and was measured
	   219px below the band, at 1.6 % of the page.
	   NOT SET AT --step-1. A typographer verified that the earlier
	   correction landed AND did not overshoot — the name and the claim at
	   20px/700 sit a clear rank above the record at 16px and a clear rank
	   below the 24px band — and putting a third string at 20px would spend
	   exactly that. Weight is the axis with room left on this card. */
	.hero__intro-slot :global(.pin-card) p.hero__intro-anchor,
	.hero__intro-slot :global(.pin-card) p.hero__intro-post {
		font-weight: 700;
	}

	/* The blank rule falls at the END of the head, wherever the head ends:
	   the post is conditional (see `derivePost` — every guard fails closed),
	   so the rule is carried by whichever paragraph is last rather than by a
	   fixed one. A card that loses the post must not also lose its blank
	   rule and read as one undifferentiated block. */
	.hero__intro-slot :global(.pin-card) p.hero__intro-head-end {
		margin-bottom: calc(var(--baseline) * 3);
	}

	/* THE CREDENTIAL YIELDED ITS WEIGHT ONE CYCLE AND ITS POSITION THE NEXT,
	   and both were paid for a measurement rather than a preference.
	   WEIGHT, and this half must not be undone: at 700 it was four to six
	   rendered lines of bold, the card's only weight signal, pointing at a
	   vocational certificate rather than at the product the wall exists to
	   evidence. It stays at 400. DO NOT LET ANYONE FIX THIS BACK — including
	   by way of the post, which is why the split asserts the credential lands
	   on the record's side of it before it will run at all.
	   POSITION: it no longer opens the record. At 390 × 844 the credential,
	   its qualification clause and the geography stood 240px between the
	   head's last rule and the two lines that name a technology and state the
	   ask, and those two overran the fold by 236px — with the English gloss
	   alone accounting for 120px of it. There is no ordering that keeps this
	   line first AND puts the ask on the phone's first screen; see
	   `recordRest` for the full census. It still carries the record's own
	   rule, the qualification clause still sits one rule below it so its
	   referent stays directly above, and on the German wall — where it is the
	   stage-1 filter — it is 2 printed rules rather than 5. */
	.hero__intro-slot :global(.pin-card) p.hero__intro-role {
		font-weight: 400;
	}

	.hero__intro-langs {
		color: var(--ink-soft);
	}

	/* signature: band 1, right — the widest sheet in the fold. It is the
	   fold's focal mass by area, by setting and by ink: the only object on
	   the wall carrying all six pride inks. */
	.hero__greeting {
		grid-column: 7 / 13;
		grid-row: 1;
		align-self: start;
		position: relative;
		padding: calc(var(--baseline) * 6) calc(var(--baseline) * 4) calc(var(--baseline) * 5);
	}

	.hero__greeting-pin {
		position: absolute;
		top: calc(var(--baseline) * -0.75);
		left: 50%;
		translate: -50% 0;
	}

	/* exhibit: band 2, left. Full chroma and full size — this is a change
	   of POSITION, never a demotion. 15rem is a floor as much as a size:
	   the character must stay legible in the first viewport (216px of
	   picture at 1440, never below ~200), so it shrinks no further. */
	.hero__polaroid-slot {
		grid-column: 1 / 5;
		grid-row: 2;
		/* centred in its columns, not flush to the shell edge: the pin then
		   sits at a fixed FRACTION of the board at every width, so the
		   thread's corner keeps landing on it while the shell narrows */
		justify-self: center;
		width: 15rem;
		max-width: 100%;
	}

	/* The caption is an exhibit label: the product's name and what it is
	   on its own first line, the measured figures beneath. Only the hero
	   copy carries the newline — the Polaroid primitive is untouched. The
	   label reading is carried by the LINE BREAK, not by a weight: the
	   break, the em-dash construction and the caption's centred position
	   already say "name, then measurements". Leading is the hand's own
	   baseline step, shared with every margin note in the viewport. */
	.hero__polaroid-slot :global(.polaroid__caption) {
		white-space: pre-line;
		line-height: var(--lh--1);
	}

	.hero__polaroid-note {
		margin: calc(var(--baseline) * 2) 0 0 calc(var(--baseline) * 1);
		rotate: -2deg;
	}

	/* evidence print-out: band 2, centre — it sits beside the exhibit it
	   measures and is the widest sheet in its band */
	.hero__telemetry-slot {
		grid-column: 5 / 10;
		grid-row: 2;
		/* hung a step lower than its neighbours: three sheets pinned dead
		   level would be a table, and the stagger opens the cork the
		   thread crosses between them */
		margin-top: calc(var(--baseline) * 3);
		position: relative;
		/* query container for the annotation's zoom fallback below */
		container: hero-evidence / inline-size;
	}

	/* The evidence sheet is the loudest print on the wall — the claim the
	   reader is meant to land on. Size and leading are steps off the one
	   ladder; the leading is a baseline multiple, never a bare ratio, so
	   it tracks the reader's own type size instead of ignoring it. */
	.hero__telemetry-title {
		margin: 0 0 calc(var(--baseline) * 2);
		font-size: var(--step-2);
		font-weight: 700;
		line-height: var(--lh-2);
	}

	.hero__telemetry-lines {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The figures sit a step above card copy. They are the only lines in
	   the fold that routinely wrap to two and three rows, so they take the
	   NEXT baseline step's leading (--lh-2, four baselines) rather than
	   their own (--lh-1, three): at --step-1's top end that is 1.6, where
	   --lh-1 would be 1.2 — too tight for wrapped body text. Still a
	   baseline multiple; still no bare ratio. */
	.hero__telemetry-lines li {
		margin-bottom: var(--baseline);
		font-size: var(--step-1);
		line-height: var(--lh-2);
	}

	.hero__telemetry-lines li:last-child {
		margin-bottom: 0;
	}

	.hero__telemetry-source {
		margin: calc(var(--baseline) * 2) 0 0;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		color: var(--ink-soft);
	}

	/* The annotation is pinned to the CORK below the print-out, never on it:
	   a note slip sits beside the sheet it annotates and no slip prints over
	   a sheet (DESIGN.md, the paper law).

	   HUNG BY ITS TOP EDGE, not its bottom. `top: 100%` puts the slip's
	   first line a fixed 32px under the sheet's bottom edge and lets the
	   slip grow DOWNWARD into bare cork — the same 32px the stacked and
	   container fallbacks below put between sheet and slip, so the hang
	   distance and the in-flow margin are one number. What the swap buys is
	   what no number could: the slip's own height is no longer part of the
	   clearance, so no type size can push it back up onto the sheet.
	   Hanging by the BOTTOM edge spent the clearance in fixed px
	   (--baseline is 8px, always) while the slip's height grew in em, so
	   growing type ate the cork from below and the slip climbed onto the
	   print — measured at 7.3px INTO the sheet at a 1600px shell with text
	   at 175 % (both locales), i.e. inside WCAG 1.4.4's 200 %.
	   Off-centre by 16px so the slip reads pinned, not typeset. */
	.hero__telemetry-note {
		position: absolute;
		left: 50%;
		translate: calc(-50% - var(--baseline) * 2) 0;
		top: 100%;
		margin-top: calc(var(--baseline) * 4);
		rotate: 1.5deg;
	}

	/* ZOOM SAFETY NET. The hang above is the only absolute position left in
	   the hero, and it is the one thing here that cannot survive type
	   growing on its own: the clearance is spent in fixed px while the
	   slip's height is set in em, so a big enough type size eats the cork
	   and the slip climbs back onto the print.

	   The em in this container query is resolved against the print-out
	   itself, so the condition reads "the sheet has become narrow FOR ITS
	   OWN TYPE". Past that line the slip stops hanging and drops into flow
	   under the sheet, exactly as it does in the stacked column: a note in
	   flow can never print over the sheet it annotates, whatever the type
	   size. Nothing is shrunk to make this fit. */
	@container hero-evidence (max-width: 22em) {
		.hero__telemetry-note {
			position: static;
			translate: none;
			margin: calc(var(--baseline) * 4) 0 0 calc(var(--baseline) * 2);
		}
	}

	/* origin stamp: band 2, right — the last station before the thread
	   leaves the board, and the date the Timeline below opens on */
	.hero__origin {
		grid-column: 10 / 13;
		grid-row: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--baseline);
		margin-top: calc(var(--baseline) * 2);
		--stamp-size: 5.75rem;
	}

	.hero__origin-pin {
		flex: none;
	}

	.hero__origin-note {
		rotate: -1.5deg;
		text-align: center;
	}

	/* ZOOM SAFETY NET, the tuned thread. Every vertex in THREAD_DESKTOP is
	   a pin centre measured at 1440 × 900, and the note above the path says
	   to re-measure whenever an artifact moves. Text-only zoom is the one
	   state where artifacts move without anyone re-measuring: the em
	   resolves against the wall's own type, so this condition reads "the
	   wall has become narrow FOR ITS OWN TYPE" — the board is 64em at the
	   1024 breakpoint and 78em at a full shell with normal text, and only
	   crosses 36em once type has roughly doubled. A stale thread that
	   crosses bare ink is worse than no thread, so past that line the
	   desktop path is not drawn. The stacked column keeps its own thread
	   below 1024px and the section connectors carry the metaphor down the
	   rest of the page; this affects only a zoomed desktop wall, and only
	   until a third path is measured for it. */
	@container hero-wall (max-width: 36em) {
		.hero__thread--desktop {
			display: none;
		}
	}

	/* Handwritten margin notes: ONE hand at ONE SETTING across the cluster
	   — --step--1 / 500 — shared verbatim by the polaroid's caption and the
	   signature's dateline, so every hand-set line in the first viewport is
	   the same pen held the same way. Marginalia sits below the printed
	   record, never level with it. */
	.hero__origin-note :global(.hand-note),
	.hero__polaroid-note :global(.hand-note),
	.hero__telemetry-note :global(.hand-note) {
		font-size: var(--step--1);
		line-height: var(--lh--1);
	}

	/* ---- stacked column ---------------------------------------- */

	@media (max-width: 63.9375rem) {
		.hero {
			padding-top: calc(var(--baseline) * 3);
		}

		.hero__thread--desktop {
			display: none;
		}

		/* behind the paper: the full-width cards cover the thread, which
		   surfaces in the cork gaps between artifacts */
		.hero__thread--mobile {
			display: block;
			z-index: auto;
		}

		/* the entrance is a stacked-column artifact only: above 1024 the
		   desktop wall's own thread already enters at the board's top edge
		   and crosses the whole frame (11,727 crimson pixels, y 41–899) */
		.hero__thread--entrance {
			display: block;
		}

		.hero__grid {
			display: flex;
			flex-direction: column;
			align-items: stretch;
			gap: calc(var(--baseline) * 5);
		}

		/* ONE order in this document, not two. The stacked column reads
		   claim → signature → exhibit → evidence → stamp, and that is
		   exactly the DOM order the markup above is written in, so this
		   block carries no `order` at all: the flex column just falls in
		   source order. The record card lands immediately under the nav,
		   which is the whole point of the sequence — on a phone the first
		   screen used to hold no role, no employer and no evidence at all:
		   "full-stack developer" / "Raleo" / "Fachinformatiker" first
		   appeared at y = 840 of an 844px viewport, four pixels of a 24px
		   line. The 12/2019 stamp and its note are PAY-OFF artifacts —
		   they mean something only once the reader knows what the thread
		   is — so they now close the column instead of opening it. */

		.hero__intro-slot {
			margin-top: 0;
			align-self: center;
			width: min(100%, 26rem);
		}

		/* Horizontal padding matches the desktop sheet's 32px rather than the
		   24px it used to carry. The signature is now sized as a fraction of
		   this sheet's own content box, and at 768px the stacked card is the
		   WIDEST it ever gets (34rem against six grid columns) — with 24px
		   margins the swash came within 2.3px of running off the paper. */
		.hero__greeting {
			align-self: center;
			width: min(100%, 34rem);
			padding: calc(var(--baseline) * 4) calc(var(--baseline) * 4) calc(var(--baseline) * 3);
		}

		/* the exhibit keeps its full 20rem here: nothing competes with it
		   in a one-column viewport */
		.hero__polaroid-slot {
			align-self: center;
			width: min(100%, 20rem);
		}

		.hero__telemetry-slot {
			margin-top: 0;
			align-self: center;
			width: min(100%, 30rem);
		}

		/* Stacked: the slip drops back into flow under the sheet. 32px, not
		   16px — the card's rotation overhang, the note's own, and the
		   slip's padding eat ~13px of any margin, and 16px left only 9.3px
		   of visible cork, the tightest note on the wall. 32px lands it
		   above the ~17px the polaroid's note holds, and still reads as the
		   card's note: the column's gap between artifacts is 40px. */
		.hero__telemetry-note {
			position: static;
			translate: none;
			margin: calc(var(--baseline) * 4) 0 0 calc(var(--baseline) * 2);
		}

		.hero__origin {
			margin-top: 0;
			align-self: center;
			--stamp-size: 5rem;
		}
	}
</style>
