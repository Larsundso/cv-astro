---
import Me from "../../layouts/me.astro";
import Tech from "../../layouts/tech.astro";
import Activity from "../../layouts/activity.svelte";
import History from "../../layouts/history.svelte";
import Education from "../../layouts/education.svelte";
---

<div class="w-full flex flex-col lg:flex-row">
 <div
  id="work"
  class="w-100lvw lg:w-50lvw of-x-hidden"
  transition:animate="slide"
 >
  <Me />
  <Activity />
 </div>

 <div class="w-100lvw lg:w-50lvw of-x-hidden" transition:animate="slide">
  <Tech />
  <History />
  <Education />
 </div>
</div>
