---
import Container from "~/components/container.svelte";
import getTotalTime from "~/components/scripts/getTotalTime";
import BackEnd from "~/components/tech/back-end.astro";
import DevOps from "~/components/tech/dev-ops.astro";
import FrontEnd from "~/components/tech/front-end.astro";
import SkillsShowcase from "~/components/tech/skills-showcase.svelte";

const total = await getTotalTime();
---

<Container>
 <section aria-labelledby="technologies">
  <h2 id="technologies" class="sr-only">Technical Skills</h2>

  <div
   class="backdrop-blur-md bg-secondary/10 rounded-xl p-5 mb-6 border border-accent/20 hover:border-accent/40 transition-all duration-300"
  >
   <SkillsShowcase client:visible {total} />
  </div>

  <div class="flex flex-col gap-5">
   <FrontEnd />
   <BackEnd />
   <DevOps />
  </div>
 </section>
</Container>
