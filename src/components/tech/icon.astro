---
export interface Props {
 href: string;
 title: string;
}

const { href, title } = Astro.props;
---

<a
 href={href}
 class="shadow-[0_4px_6px_-1px_rgba(0,0,0,0.1),0_2px_4px_-1px_rgba(0,0,0,0.06)]
 hover:shadow-[0_10px_15px_-3px_rgba(230,144,101,0.1),0_4px_6px_-2px_rgba(230,144,101,0.05)]
 group relative flex items-center justify-center w-14 h-14 rounded-lg bg-background/40 border border-accent/10 hover:border-accent/40 transition-all duration-300 overflow-hidden"
 title={title}
 target="_blank"
 rel="noopener noreferrer"
>
 <div class="transform group-hover:scale-110 transition-transform duration-300">
  <slot />
 </div>

 <div
  class="absolute bottom-0 left-0 w-full bg-accent text-background text-2.5 py-1 text-center translate-y-full group-hover:translate-y-0 transition-transform duration-300"
 >
  {title}
 </div>
</a>
