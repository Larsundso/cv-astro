---
import { getWall, type Locale } from "~/data/i18n";
import "~/styles/wall.css";

interface Props {
	title?: string;
	description?: string;
	/** Page locale; falls back to Astro.currentLocale, then "en". */
	locale?: Locale;
}

const locale: Locale = Astro.props.locale ?? ((Astro.currentLocale ?? "en") as Locale);
const wall = getWall(locale);
const ui = wall.ui;

const { title = wall.meta.title, description = wall.meta.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, "https://lars-dev.org").toString();
const year = new Date().getFullYear();

const ogLocale = locale === "de" ? "de_DE" : "en_US";
const ogLocaleAlternate = locale === "de" ? "en_US" : "de_DE";
const inLanguage = locale === "de" ? "de-DE" : "en-US";

/* One share card per locale: the German recruiter's preview should not be in
   English, for the same reason the wall itself is not. Both are 1200x630
   crops of their own hero, absolute-URL'd because crawlers do not resolve
   relative paths. The alt text describes what is IN the card and repeats no
   figure the page does not already publish. */
const ogImage = new URL(locale === "de" ? "/og.de.png" : "/og.png", "https://lars-dev.org").toString();
const ogImageAlt =
	locale === "de"
		? "Eine Korkpinnwand: ein roter Faden läuft über sie zu einer Karteikarte — „Lars Böse: Ich betreibe einen Discord-Bot mit über 2,4 Mio. Nutzern auf 8.357 Servern, allein, seit 2019 im Produktivbetrieb“ — daneben eine handgeschriebene Signatur."
		: "A cork pinboard: a red thread runs across it to an index card reading “Lars Böse: I run a Discord bot with 2.4M+ users on 8,357 servers — solo, in production since 2019”, beside a handwritten signature.";

/* ONE IDENTITY RECORD, READ — NOT RE-TYPED.
   This block used to hand-type its own Person: `name: "Lars Boese"` under a
   `<title>` of *Böse*, `alternateName` as a bare handle, and a LinkedIn
   `sameAs` carrying a RAW `ö` in the path — while `meta.person` in the data
   layer already held the correct name and the correctly percent-encoded URL
   (`lars-b%C3%B6se-217272351`). Two records for one man is how the
   machine-readable identity ends up disagreeing with the human-readable one,
   and it is also how a recruiter copying the name out of the page fails to
   find him in a search. The record is now read from the wall module, so both
   locales and every consumer of `meta.person` state the same name.
   The drawn hero signature stays "Lars Boese" on purpose — a signature may
   legitimately be ASCII, and the Lottie swash measures against that exact
   string. `alternateName` is what carries it into the graph. */
const person = wall.meta.person;

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: person.name,
	givenName: person.givenName,
	familyName: person.familyName,
	alternateName: person.alternateName,
	url: "https://lars-dev.org",
	email: `mailto:${person.email}`,
	jobTitle: person.jobTitle,
	description:
		"Builds and operates Ayako, a Discord bot with 2.4M+ users on 8,357 servers (as of 2026-08-03), solo and in production since 2019. Full-stack developer at Raleo Digital GmbH, fully remote.",
	worksFor: {
		"@type": "Organization",
		name: "Raleo Digital GmbH",
		url: "https://raleo.de"
	},
	alumniOf: {
		"@type": "Organization",
		name: "Columbus Interactive GmbH",
		description:
			"Apprenticeship: Fachinformatiker für Anwendungsentwicklung (IHK, German dual system), 2022 to the Sommer 2025 exam cycle."
	},
	homeLocation: {
		"@type": "Place",
		address: {
			"@type": "PostalAddress",
			addressRegion: "Bodensee-Oberschwaben, Baden-Württemberg",
			addressCountry: "DE"
		}
	},
	knowsLanguage: ["de", "en"],
	knowsAbout: [
		"TypeScript",
		"Node.js",
		"Bun",
		"Svelte",
		"Astro",
		"PostgreSQL",
		"Redis",
		"Docker",
		"Discord API",
		"Prometheus"
	],
	sameAs: person.sameAs
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "lars-dev.org",
	url: "https://lars-dev.org",
	description: `Portfolio and CV of ${person.name}. Every figure carries its unit and an as-of date.`,
	author: { "@type": "Person", name: person.name },
	inLanguage
};
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#e1d2bb" />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="author" content={person.name} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={canonical} />

		<!-- language alternates: one page pair, fixed URLs -->
		<link rel="alternate" hreflang="en" href="https://lars-dev.org/" />
		<link rel="alternate" hreflang="de" href="https://lars-dev.org/de/" />
		<link rel="alternate" hreflang="x-default" href="https://lars-dev.org/" />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="lars-dev.org" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		{
			/* THE LINK HAD NO FACE. There was no og:image at all and
			   `twitter:card` was `summary`, the small text-only stub — so on
			   every surface this site actually arrives through (a link pasted
			   into LinkedIn InMail, a Slack channel, an email, an ATS
			   candidate note) the cork wall, the red thread and the drawn
			   signature were invisible, and the whole distinctive-asset
			   inventory travelled as a grey text stub.
			   It survived three review cycles for a structural reason worth
			   recording: twelve disciplines judging SCREENSHOTS cannot see the
			   document head. Nothing in a frame-based review can find this.
			   The image is a real 1440x756 crop of the hero at the standard
			   1.9048 ratio, so it carries the PROPOSITION and not just the
			   pinboard — a distinctive device that carries no message is
			   decoration billed as strategy, and the share card is the last
			   slot on this site where that is affordable.
			   PNG rather than WebP, deliberately and against the discipline's
			   own suggestion: LinkedIn and X have unreliable WebP support for
			   cards, and a share asset that some crawlers cannot decode is
			   the defect this fixes, reintroduced.
			   Its staleness obligation is not new — `og:description` already
			   carries "2.4M+ users on 8,357 servers ... as of 2026-08-03" and
			   is regenerated by the same deploy. */
		}
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />

		<!-- Twitter/X -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonical} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImage} />
		<meta property="twitter:image:alt" content={ogImageAlt} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	</head>
	<body>
		<!--
THESIS: A career pinned to a wall by its owner's hand — one red thread (der rote Faden) from December 2019 to yesterday's commit; refuses the dark-neon developer-dashboard default and the neutral CV alike.
OWN-WORLD: warm cork field under paper artifacts: typed index cards (Courier Prime), flyer headlines (League Gothic), body copy (Atkinson Hyperlegible), handwritten annotations (Shantell Sans) in six rationed pride inks; brass pins, restrained shadows, one crimson thread stitching everything chronologically.
STORY: a German-market recruiter recognizes a human who has shipped continuously since 2019 — every claim a pinned artifact with unit and as-of date — and writes to jobs@lars-dev.org.
FIRST VIEWPORT: hero wall cluster: handwritten pride-ink Lottie greeting center; red thread entering from a 2019 pin; Ayako polaroid (2.4M users, 8,357 servers); hand-annotated telemetry print-out; contact note as the pinned primary action.
FORM: pinboard wall — grounded candidate 3 of 7, human-steered round; seed key 6d79e1c5.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
		<a class="skip-link" href="#main">{ui.skipLink}</a>

		<header>
			<slot name="header" />
		</header>

		<main id="main">
			<slot />
		</main>

		<button class="to-top" id="to-top" aria-label={ui.backToTop} data-visible="false">
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path
					d="M4 12.5 L10 6.5 L16 12.5"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>

		<footer class="wall-footer">
			<slot name="footer">
				{
					ui.footerLine ? (
						<p>{ui.footerLine}</p>
					) : (
						<p>
							{person.name} · <a href={`mailto:${person.email}`}>{person.email}</a> · {year}
						</p>
					)
				}
			</slot>
		</footer>

		<style>
			/* scroll-to-top: a brass pin pressed into the cork */
			.to-top {
				position: fixed;
				right: calc(var(--baseline) * 3);
				bottom: calc(var(--baseline) * 3);
				z-index: 50;
				width: 44px;
				height: 44px;
				border: none;
				border-radius: 50%;
				cursor: pointer;
				display: grid;
				place-items: center;
				color: var(--ink);
				background: radial-gradient(
					circle at 35% 30%,
					color-mix(in oklab, var(--brass) 40%, white),
					var(--brass) 58%,
					color-mix(in oklab, var(--brass) 55%, black)
				);
				box-shadow:
					0 2px 8px oklch(25% 0.015 60 / 0.25),
					inset 0 0 0 1px oklch(25% 0.015 60 / 0.2);
				visibility: hidden;
				opacity: 0;
				transition: visibility 0s 150ms;
			}

			.to-top[data-visible="true"] {
				visibility: visible;
				opacity: 1;
				transition: none;
			}

			@media (prefers-reduced-motion: no-preference) {
				.to-top {
					transition:
						opacity 150ms ease-out,
						translate 150ms ease-out,
						box-shadow 150ms ease-out,
						visibility 0s 150ms;
				}

				.to-top[data-visible="true"] {
					transition:
						opacity 150ms ease-out,
						translate 150ms ease-out,
						box-shadow 150ms ease-out;
				}

				/* the pin settles when hovered, presses in when clicked */
				.to-top:hover {
					translate: 0 1px;
					box-shadow:
						0 1px 4px oklch(25% 0.015 60 / 0.25),
						inset 0 0 0 1px oklch(25% 0.015 60 / 0.2);
				}

				.to-top:active {
					translate: 0 2px;
				}
			}

			.wall-footer {
				padding: calc(var(--baseline) * 4) calc(var(--baseline) * 3) calc(var(--baseline) * 6);
				text-align: center;
				font-family: var(--font-typed);
				font-size: var(--step--1);
				line-height: var(--lh--1);
				color: var(--ink-soft);
			}

			.wall-footer p {
				margin: 0;
			}

			.wall-footer a {
				color: inherit;
				text-underline-offset: 3px;
			}

			.wall-footer a:hover {
				color: var(--ink);
			}
		</style>

		<script>
			const toTop = document.getElementById("to-top");
			if (toTop) {
				const onScroll = () => {
					toTop.dataset.visible = String(window.scrollY > 480);
				};
				window.addEventListener("scroll", onScroll, { passive: true });
				onScroll();
				/* smoothness comes from CSS scroll-behavior, which
				   prefers-reduced-motion already resolves to auto */
				toTop.addEventListener("click", () => window.scrollTo({ top: 0 }));
			}
		</script>
	</body>
</html>
