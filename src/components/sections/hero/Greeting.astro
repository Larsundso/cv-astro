---
/**
 * Greeting — the handwritten centerpiece of the hero cluster, and the
 * wall's single most distinctive artifact: a SIGNATURE.
 *
 * TWO STATES, ONE SENTENCE. The card is a salutation line in the reader's
 * own language, the signed NAME beneath it, and a dateline. The name has
 * two states — hand-set (Shantell Sans in the six pride inks) and drawn
 * (the Lottie, in the same six inks) — and they now say the same word,
 * because the drawn asset was cropped to the name alone. That crop is
 * what makes the artifact bilingual: the English-only "Hi, I'm" strokes
 * are gone from the asset and the salutation is set as text, so the
 * German page no longer watches an English sentence write itself. The
 * `<h1>`'s accessible text is the whole sentence, surname included.
 *
 * MOTION (feel F1). The draw used to run its full 10s inside a
 * `display:none` box and was revealed only once it had STOPPED. It is now
 * LAYERED, not swapped: the `<h1>` and the Lottie share one grid cell.
 * The asset itself was retimed — the salutation frames and 3.1s of dead
 * tail at the end are gone — and the player is sped up to a ~2.5s draw.
 *
 * THE NEVER-BLANK RULE, AND ITS OTHER HALF. Blank was never the only way
 * to fail: HALF-WRITTEN is the other, and the build was failing it. The
 * flag was raised on the first advancing frame (measured: t = 328ms), the
 * hand-set signature was gone by 977ms, and the card then read "Lars B"
 * until roughly 2.6s — with a 600ms window in the middle where both
 * renderings of the surname sat above 0.08 opacity at once. The gate is
 * now the one the design document was reaching for — the player's own
 * completion (the doc's "92 %" lands on "Lars Boes" for this asset). The
 * hand-set signature holds the card for the entire draw and the handover
 * is a 110ms CUT between two states of the same finished word. No JS, a failed fetch, a screenshot bot, a stalled
 * player or prefers-reduced-motion never reach the flag at all, so they
 * keep the designed resolved state permanently. There is no path on which
 * this card is blank, and none on which it shows half a name.
 *
 * Register law for the resolved state: pen, not marker. The salutation is
 * written in soft ink at hand weight; the NAME carries the six pride inks
 * in flag order — magenta, amber, green, teal, blue, violet — as six HARD
 * bands rather than a continuous smear, and is underscored by a
 * hand-drawn swash in the same six inks in the same order. The drawn
 * asset carries the identical six values natively, one solid ink per run
 * of strokes, so no filter is needed to press it into the paper and
 * neither state contains a grey, a pastel, or a second red.
 *
 * Material law: everything on this sheet is hand material (Shantell Sans
 * / the Lottie's handwriting). No other face enters the card.
 */
import LottieAnimation from "astro-integration-lottie/Lottie.astro";
import Hi from "~/assets/Hi.json?url";

interface Props {
	/** The greeting text, e.g. "Hi, I'm Lars" — salutation plus name. */
	greeting: string;
	/** Small handwritten line below the greeting. */
	subline: string;
	/**
	 * The signed name — the part that carries the pride inks and the part
	 * the Lottie draws. Pass the full signature ("Lars Boese"); whatever
	 * shorter form the greeting string ends with is replaced by it, so the
	 * hand-set state, the drawn state and the `<h1>` all say one sentence.
	 */
	name?: string;
	/**
	 * What the `<h1>` SAYS, as opposed to what the signature DRAWS.
	 *
	 * The two are not the same string and must not be. A signature may
	 * legitimately be ASCII — the drawn asset's strokes are authored against
	 * "Lars Boese" and the hand-set state is measured against that exact
	 * word — but the `sr-only` sentence has no visual alibi: it is the ONLY
	 * place on this card that exists solely to be announced, and it was the
	 * one place the wall spelled the surname differently from its `<title>`,
	 * its record card, both stamps and its LinkedIn card, all of which read
	 * *Böse*. A screen-reader user was the only reader given the ASCII
	 * fallback as the name itself. Pass the legal form; the drawn and
	 * hand-set states are untouched by it.
	 */
	spoken?: string;
}

const { greeting, subline, name, spoken } = Astro.props;

const text = greeting.trim();
/* The signed part: the caller's signature when given, otherwise the
   greeting's last word. Everything before it is salutation — and when the
   caller's signature extends the greeting's last word ("Lars" →
   "Lars Boese") that last word is dropped, never printed twice. */
const signature = name?.trim() || text.slice(text.lastIndexOf(" ") + 1);
const before = text.includes(signature)
	? text.slice(0, text.lastIndexOf(signature))
	: text.slice(0, text.lastIndexOf(" ") + 1);
const salutation = before
	.trim()
	.split(/\s+/)
	.filter((word) => word.length > 0);
/** What the h1 actually says, surname included, in the page's language —
    the SPOKEN form of the name, never the drawn one (see `spoken` above). */
const sentence = [...salutation, spoken?.trim() || signature].join(" ");

/** Baseline drift, in the order a hand writes: no word sits dead level. */
const DRIFT = [
	{ dy: "0.5px", rot: "-0.6deg" },
	{ dy: "-1px", rot: "0.5deg" },
	{ dy: "0.5px", rot: "-0.35deg" },
	{ dy: "-1.5px", rot: "0.7deg" }
] as const;
const drift = (i: number) => {
	const d = DRIFT[i % DRIFT.length];
	return `--dy:${d.dy};--rot:${d.rot}`;
};
---

<div class="hero-greeting">
	<p class="hero-greeting__salutation" aria-hidden="true">
		{
			salutation.map((word, i) => (
				<>
					<span class="hero-greeting__word" style={drift(i)}>
						{word}
					</span>{" "}
				</>
			))
		}
	</p>

	{/* One grid cell, two states of the same name: the hand-set signature
	    and the drawn one sit on top of each other and cross-fade. */}
	<div class="hero-greeting__stage">
		<h1 class="hero-greeting__title">
			<span class="sr-only">{sentence}</span>
			<span class="hero-greeting__hand" aria-hidden="true">
				<span class="hero-greeting__sig" style={drift(salutation.length)}>
					<span class="hero-greeting__name">{signature}</span>
					<svg
						class="hero-greeting__swash"
						viewBox="0 0 120 9"
						preserveAspectRatio="none"
						fill="none"
						aria-hidden="true"
						focusable="false"
					>
						<linearGradient id="greeting-swash" x1="0" y1="0" x2="1" y2="0">
							<stop offset="0%" stop-color="var(--ink-magenta)"></stop>
							<stop offset="16.67%" stop-color="var(--ink-magenta)"></stop>
							<stop offset="16.67%" stop-color="var(--ink-amber)"></stop>
							<stop offset="33.33%" stop-color="var(--ink-amber)"></stop>
							<stop offset="33.33%" stop-color="var(--ink-green)"></stop>
							<stop offset="50%" stop-color="var(--ink-green)"></stop>
							<stop offset="50%" stop-color="var(--ink-teal)"></stop>
							<stop offset="66.67%" stop-color="var(--ink-teal)"></stop>
							<stop offset="66.67%" stop-color="var(--ink-blue)"></stop>
							<stop offset="83.33%" stop-color="var(--ink-blue)"></stop>
							<stop offset="83.33%" stop-color="var(--ink-violet)"></stop>
							<stop offset="100%" stop-color="var(--ink-violet)"></stop>
						</linearGradient>
						<path
							d="M2 6 C 22 2.4, 54 1.6, 84 3.2 S 110 6, 118 2.8"
							stroke="url(#greeting-swash)"
							stroke-linecap="round"
							vector-effect="non-scaling-stroke"></path>
					</svg>
				</span>
			</span>
		</h1>
		<div class="hero-greeting__anim" aria-hidden="true">
			<LottieAnimation src={Hi} autoplay={true} loop={false} />
		</div>
	</div>

	<p class="hero-greeting__subline">{subline}</p>
</div>

<script is:inline>
	/* Hand over to the ink only once the ink has FINISHED — the rule the
	   design document already states and the build did not keep.
	   Three jobs, in order of importance:
	   1. Never blank AND NEVER HALF-WRITTEN. `data-anim` used to be set on
	      the first frame past 0, which measured at t = 328 ms against a draw
	      that runs to ~3.2 s: the hand-set signature was gone by 977 ms and
	      the card then read "Lars B" — a truncated surname — for more than a
	      second, in the one window where a stranger decides whose wall this
	      is. Worse, for 600 ms of that both layers sat above 0.08 opacity
	      (peak 0.921 hand-set over 0.892 drawn): two renderings of one
	      surname, superimposed, one of them unfinished.
	      The flag is now gated on the player's own COMPLETION, so the hand-set
	      signature holds the card for the whole draw and the two states only
	      ever show the SAME finished word. A player that never gets there
	      never sets the flag, so no JS, a failed fetch, a screenshot bot, a
	      throttled tab and a dropped chunk all keep the designed resolved
	      state permanently.
	   2. A watchable duration. The asset is authored at 100fps; the player
	      is sped up so the draw lands at ~2.5s whatever the asset's length,
	      derived from the file rather than hard-coded against it.
	   3. Reduced motion means no draw at all: the player is stopped on the
	      first frame it is found, and the CSS gate never opens. */
	(() => {
		const root = document.currentScript?.previousElementSibling?.closest?.(".hero-greeting");
		const host = root ?? document.querySelector(".hero-greeting");
		if (!host) return;
		const frame = host.querySelector(".hero-greeting__anim");
		if (!frame) return;

		const TARGET_SECONDS = 2.5;
		/* DESIGN.md's Never-Blank Rule says "gated on the player reporting
		   >=92 % of its frames drawn, not on the svg merely existing". 92 is
		   the right SHAPE of rule and the wrong number FOR THIS ASSET:
		   captured at exactly 0.92 of 410 frames, the drawn layer reads
		   "Lars Boes" — the surname's last letter is still being written
		   (`scratchpad/fix3/hero/drawn-at-92.png`). So the gate is the
		   player's own completion, which is what 92 % was standing in for:
		   the last frame, or the `complete` event, whichever arrives first.
		   A player that stalls just short never opens it, and the hand-set
		   signature stands — the designed state, not a degraded one. */
		const LAST_FRAME_EPS = 1.5;
		/* give up watching a player that has not advanced for this long; the
		   hand-set signature then stands, which is the designed state */
		const STALL_MS = 15000;

		const quiet = window.matchMedia?.("(prefers-reduced-motion: reduce)");
		let anim = null;
		let tuned = false;
		let done = false;
		let seen = -1;
		let movedAt = 0;
		const startedAt = performance.now();

		const find = () => {
			if (!frame.querySelector("svg")) return null;
			const list = window.lottie?.getRegisteredAnimations?.() ?? [];
			return list.find((a) => a?.wrapper && frame.contains(a.wrapper)) ?? null;
		};

		const tick = (now) => {
			anim = anim || find();

			if (anim && !tuned && anim.totalFrames > 0) {
				tuned = true;
				if (quiet?.matches) {
					anim.goToAndStop(0, true);
					return; /* resolved state stands; nothing to watch */
				}
				const rate = anim.frameRate || 60;
				const speed = anim.totalFrames / rate / TARGET_SECONDS;
				if (speed > 0.1 && speed < 20) anim.setSpeed(speed);
				anim.addEventListener?.("complete", () => {
					done = true;
					host.dataset.anim = "drawn";
				});
			}

			if (anim && !done) {
				const f = anim.currentFrame || 0;
				const total = anim.totalFrames || 0;
				if (f > seen) {
					seen = f;
					movedAt = now;
				}
				/* the one condition that opens the gate: the word is written */
				if (total > 0 && f >= total - LAST_FRAME_EPS) {
					done = true;
					host.dataset.anim = "drawn";
				}
			}

			if (done) return;
			/* Nothing to withdraw any more: the flag is never raised before the
			   draw is finished, so a stall simply leaves the hand-set signature
			   in place. Stop watching once the player has been quiet long
			   enough that it is not coming back. */
			if (now - (movedAt || startedAt) > STALL_MS) return;
			requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	})();
</script>

<style>
	.hero-greeting {
		text-align: center;
		/* THE SIGNATURE IS SIZED BY ITS SHEET, NOT BY THE VIEWPORT. A
		   viewport-driven clamp cannot know how wide this card is: at 1024px
		   the shell is narrow and the card's six columns come to 480px, while
		   at 768px the column has stacked and the same card is 548px — so one
		   `vw` curve either overflows the narrow sheet or under-fills the wide
		   one. Made a container here and the signature is a fixed FRACTION of
		   the paper it is written on at every width, which is what the finding
		   asked for. */
		container-type: inline-size;

		/* 17cqi puts the hand-set name at 95.6 % of this box at every width
		   (measured: Shantell Sans 700 advances 5.622px per px of font-size
		   for "Lars Boese"), leaving 4.4 % against font-metric drift, and the
		   swash's 114 % overhang inside the sheet's padding.
		   The cap is 90px: nothing on this wall is wider than the 78rem shell,
		   so the cap is a guard rail rather than a working value.

		   THE FLOOR WAS A `rem` INSIDE A CONTAINER QUERY, AND THAT IS THE
		   WHOLE BUG. This container exists because "a viewport-driven clamp
		   cannot know how wide this card is" — and then the floor was written
		   in a unit that answers to the ROOT font size, which the reader sets
		   and the card knows nothing about. So a raised root overrode the
		   container the container query was built to respect. Measured before:
		     320w root16 -> overflow  -1px
		     320w root24 -> overflow  81px
		     390w root32 -> overflow 108px
		   with `pageOverflow: 0` in every case, because `overflow-x: clip`
		   suppresses the scrollbar. The name silently truncated to "Lars Boes"
		   at a documented browser setting: the wall's own thesis is this man,
		   named, signed, and it misstated the name with no signal at all.
		   The rule this belongs to: THE UNIT MUST MATCH WHAT THE CONSTRAINT
		   IS ABOUT. Fitting inside a card is a container constraint, so it is
		   expressed in container units and nothing else.

		   THE DECLARATION DID NOT KEEP THAT RULE, and the comment above it
		   claimed it did. `clamp(2.625rem, 17cqi, 5.625rem)` carries a rem
		   FLOOR that rises with the root, and `20cqi` was an outer bound
		   nobody measured — so two non-container terms outranked the one
		   container term that was calibrated. The name stopped truncating
		   and started WRAPPING instead: "Lars" over "Boese", which is not a
		   signature at all. Measured (fit.mjs, both viewports, roots 16-32):
		   the name's natural width is a stable 5.65x its font-size, so the
		   largest size that fits is 100/5.65 = 17.6cqi. At 390 the rem floor
		   took root 20 (52.4px against 46.1 available) and the 20cqi cap took
		   24 and 32; at 320 the cap governs at EVERY root, so the wall's own
		   name wrapped at the DEFAULT text size and no probe had looked.
		   17cqi is the measured bound with ~3 % headroom. The 5.625rem cap
		   stays: it can only ever make the name smaller, so it cannot
		   overflow. Nothing changes at 390/root 16 — that cell was already
		   governed by 17cqi and still renders 47.26px.
		   CALIBRATED TO THIS STRING. 5.65x is a property of "Lars Boese";
		   a longer signature needs the ratio re-measured, not assumed. */
		--sig-size: min(17cqi, 5.625rem);
	}

	/* The salutation is the quiet half of the card: the same pen, a step
	   the reader reads as address rather than as name. It is set as TEXT,
	   never drawn, which is the whole reason the card can be bilingual. */
	.hero-greeting__salutation {
		margin: 0;
		font-family: var(--font-hand);
		font-weight: 400;
		font-size: var(--step-2);
		line-height: var(--lh-2);
		letter-spacing: 0.005em;
		color: var(--ink-soft);
	}

	/* ONE CELL, TWO STATES. Both children are placed at 1/1, so the card's
	   height is the taller of the hand-set name and the drawn one and never
	   changes at handover — no `display` swap, no min-height release, no
	   layout shift. (The old build dropped the title box 56px → 0 in a
	   single frame at exactly the moment the reader was looking at it.) */
	.hero-greeting__stage {
		display: grid;
		align-items: center;
		justify-items: center;
		/* The drawn signature's width, in ems of the hand-set one it
		   replaces — so both states scale together and the em keeps them
		   matched at every width. 4.6em is the value at which the two carry
		   the same LETTER HEIGHT, which is the axis that has to match:
		   matching them on WIDTH instead would make the drawn ink half again
		   as tall as the hand-set letters, because a drawn signature packs
		   more stroke into less width than a face does.
		   RE-MEASURED at 1440 after the name went to 89.08px / weight 700
		   (`scratchpad/fix3/hero/sig.mjs`, `bbox.mjs`): hand-set ink box
		   510 × 107, drawn 392 × 99 — a width relationship of 0.769 against
		   0.788 before and a height relationship of 0.93 against 0.91, so the
		   em holds the tuning through the size and weight change and 4.6
		   stands.
		   The predecessor of this note claimed the two states carry the same
		   INK. They never did and cannot: measured ink is 1.80 : 1 before and
		   2.22 : 1 after, because a Lottie's stroke weight is fixed by the
		   artwork while the hand-set state just went from 500 to 700. That is
		   the correct trade — they are two renderings of one name, not two
		   copies of one image. */
		--sig-width: 4.6em;
	}

	.hero-greeting__title,
	.hero-greeting__anim {
		grid-area: 1 / 1;
	}

	.hero-greeting__title {
		margin: 0;
		font-weight: 400;
	}

	/* ---- the resolved state: a signature, not a headline ------- */
	.hero-greeting__hand {
		display: block;
		max-inline-size: 100%;
		font-family: var(--font-hand);
		/* 400 = pen. A marker with colour in it reads as a logo. This is the
		   weight of the CARD's hand; the signed name overrides it below,
		   because a person signs harder than they write. */
		font-weight: 400;
		font-size: var(--sig-size);
		/* a baseline multiple that tracks the type instead of ignoring it:
		   80px at the desktop 89.5px setting, 40px at the phone's 48px one.
		   The first declaration is the fallback where `round()` is missing. */
		line-height: var(--lh-6);
		line-height: round(0.875em, var(--baseline));
		letter-spacing: 0.005em;
		color: var(--ink-soft);
	}

	.hero-greeting__word,
	.hero-greeting__sig {
		display: inline-block;
		translate: 0 var(--dy, 0);
		rotate: var(--rot, 0deg);
	}

	.hero-greeting__sig {
		position: relative;
	}

	/* The name is the one thing on this sheet the pride inks write — SIX
	   BANDS, not a gradient. The old ramp interpolated between the six
	   stops, so five-sixths of the stroke was a colour no ink on this wall
	   uses (measured: 8.8 % of it sat at pure red, which the One Thread
	   Rule reserves for the thread alone). Hard stops mean every pixel of
	   the name is a declared ink and the flag reads as a flag. */
	/* SIZE AND WEIGHT, NOT INK. The name was measured as the sixth mass in
	   the first frame — below the polaroid, below the flyer, below both
	   cards, on a wall whose whole subject is the person whose name it is.
	   The answer is the two axes a signature actually has: it is written
	   BIGGER and it is written HARDER. 500 was the pen weight of a written
	   word; 700 is the pressure of a signed one, and the face is already
	   subset at 700 (`uno.config.ts`), so it costs no byte.
	   The six inks and the six hard bands below are untouched, deliberately:
	   a name in flat black would be a different, worse object. */
	.hero-greeting__name {
		font-weight: 700;
		color: var(--ink-magenta);
	}

	@supports (background-clip: text) or (-webkit-background-clip: text) {
		.hero-greeting__name {
			background-image: linear-gradient(
				95deg,
				var(--ink-magenta) 0 16.67%,
				var(--ink-amber) 16.67% 33.33%,
				var(--ink-green) 33.33% 50%,
				var(--ink-teal) 50% 66.67%,
				var(--ink-blue) 66.67% 83.33%,
				var(--ink-violet) 83.33% 100%
			);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			-webkit-text-fill-color: transparent;
		}
	}

	/* the signing stroke under the name — same six inks, same six bands */
	.hero-greeting__swash {
		position: absolute;
		left: -7%;
		bottom: -0.3em;
		width: 114%;
		height: 0.26em;
		overflow: visible;
	}

	.hero-greeting__swash path {
		stroke-width: 0.075em;
	}

	/* High-contrast modes drop background images: give the name its ink
	   back rather than letting clipped text disappear. */
	@media (forced-colors: active) {
		.hero-greeting__name {
			background-image: none;
			color: CanvasText;
			-webkit-text-fill-color: CanvasText;
		}
	}

	/* ---- the drawn state --------------------------------------- */
	/* Sized in em against the hand-set name it replaces, so the two states
	   are the same signature at the same scale at every viewport width and
	   the cross-fade is a hand settling, not a jump. Width, not height,
	   because the asset's own aspect ratio then supplies the height and
	   nothing can shift. Hidden by default: it earns its opacity from the
	   script, and only where motion is welcome. */
	.hero-greeting__anim {
		width: var(--sig-width);
		aspect-ratio: 341 / 79;
		font-size: var(--sig-size);
		opacity: 0;
		/* belt and braces with the `20cqi` bound on --sig-size: `--sig-width`
		   is derived, and a derived width has its own drift. Neither half of
		   the signature may be wider than the sheet it is written on. */
		max-inline-size: 100%;
	}

	.hero-greeting__subline {
		margin: calc(var(--baseline) * 2) 0 0;
		font-family: var(--font-hand);
		/* one hand at one setting: identical to every margin note in the
		   first viewport (--step--1 / 500), so the sheet reads as one pen */
		font-weight: 500;
		font-size: var(--step--1);
		line-height: var(--lh--1);
		color: var(--ink-soft);
	}
</style>

<style is:global>
	/* A CUT, NOT A CROSS-FADE. Both states occupy the same cell, and the old
	   600ms dissolve with a 300ms delay on the outgoing layer held BOTH
	   renderings of the surname above 0.08 opacity for 600ms — a doubled
	   word, which no amount of easing makes read as one hand. Two states of
	   one word are not a dissolve subject: they are a cut. 110ms, no delay,
	   both layers on the same clock, so the frames in which anything is
	   superimposed are too few to resolve as a second signature.
	   Nothing runs backwards any more — the flag is latched at >=92 % of the
	   draw and never withdrawn, because by then both layers say the same
	   finished word. */
	.hero-greeting__anim svg {
		display: block;
		width: 100%;
		height: 100%;
		/* No filter. The asset now carries the six declared inks natively;
		   `saturate()` cannot manufacture chroma out of grey, which is what
		   the old `brightness(.62) saturate(1.9)` was being asked to do. */
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-greeting__title,
		.hero-greeting__anim {
			transition: opacity 110ms var(--e-out);
		}

		.hero-greeting[data-anim="drawn"] .hero-greeting__anim {
			opacity: 1;
		}

		.hero-greeting[data-anim="drawn"] .hero-greeting__title {
			opacity: 0;
		}
	}
</style>
