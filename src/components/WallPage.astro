---
/**
 * WallPage — the pinboard wall, assembled once for every locale.
 * Rendered by src/pages/index.astro (en, "/") and src/pages/de/index.astro
 * (de, "/de/"); copy resolves through getWall(Astro.currentLocale).
 *
 * Hero → Werdegang → Projects → Telemetry → Practice → Contact in one
 * column, stitched by the crimson thread: it starts at the hero's 12/2019
 * pin, hands over to the timeline spine, and — from the timeline's last
 * pin to the contact address — runs PIN TO PIN through every artifact on
 * the lower half of the wall, behind the paper, surfacing only on bare
 * cork. It is cut in a knot on the mailto pin.
 *
 * THE LOWER RUN IS MEASURED, NOT DRAWN BY HAND. Until 2026-08-04 this
 * half of the page was `.wall-run__line`: a 2.5px <span> at left: 50%,
 * 6,282px long — 55 % of the document — passing through exactly one of
 * the nineteen brass pins in its range, and that one by 8px of accident.
 * A rule is not a route. The run is now built at runtime from the pins
 * themselves: the script below reads every waypoint pin's centre with
 * getBoundingClientRect, feeds the centres to taut.ts, and emits ONE 1:1
 * SVG per leg. Every direction change lands on a pin head, which is the
 * convention the hero and the timeline already taught.
 *
 * Thread handoffs (fixed by the section contracts):
 * — the hero exits its board's bottom edge at x = 802/1200 of the 78rem
 *   shell (≥64rem) resp. at 50 % of it (stacked column);
 * — the timeline spine sits at `--spine-x`, the ONE place on this wall
 *   that says where the thread stands when it runs straight down: 152px
 *   left of the shell's centre at ≥48rem, 64px in from the wall's text
 *   edge below that. It enters at the section's top edge and exits at
 *   the bottom of its last row;
 * — the lower run picks the timeline's LAST PIN up directly (the
 *   timeline's own exit stub is deleted, not merely hidden), so the one
 *   junction on the wall that was not covered by a pin head is gone.
 *
 * Draw machinery: stretched connector SVGs disable stroke-dasharray and
 * reveal via a scroll-driven clip wipe instead of the dash draw —
 * Chromium does not pathLength-normalize dasharray under
 * vector-effect: non-scaling-stroke, so dash-drawn threads are only safe
 * at 1:1 scale (see Timeline.astro). The lower run's legs are sized in
 * PIXELS from the measurement that produced them, so they are 1:1 by
 * construction and keep the native dash draw; they are re-measured on
 * resize so they never enter the stretched state. Reduced motion and
 * engines without animation-timeline get the fully drawn resolved state.
 */
import Contact from "~/components/sections/Contact.astro";
import Hero from "~/components/sections/Hero.astro";
import Practice from "~/components/sections/Practice.astro";
import Projects from "~/components/sections/Projects.astro";
import Telemetry from "~/components/sections/Telemetry.astro";
import Timeline from "~/components/sections/Timeline.astro";
import LangTab from "~/components/wall/LangTab.astro";
import PinCard from "~/components/wall/PinCard.astro";
import Thread from "~/components/wall/Thread.astro";
import { getWall, type Locale } from "~/data/i18n";
import Layout from "~/layouts/main.astro";

const locale = (Astro.currentLocale ?? "en") as Locale;
const { meta, ui } = getWall(locale);

/* one index, two appearances: the title card's list and the progress
   rail's ticks. Same order, same labels, same destinations — a directory
   that renames itself between the top of the page and the margin is the
   fastest way to lose a reader. */
const NAV = [
	{ href: "#werdegang", label: ui.nav.werdegang, lang: "de" },
	{ href: "#projects", label: ui.nav.projects },
	{ href: "#telemetry", label: ui.nav.telemetry },
	{ href: "#practice", label: ui.nav.practice },
	{ href: "#contact", label: ui.nav.contact }
];

/* hero → timeline connectors, one per breakpoint state (see <style>).
   Both stretch between two responsive anchors: the box's corners ARE the
   endpoints, so any width keeps the junctions registered.
   TAUT: a connector spans two pins with nothing between, so under
   tension it is one dead-straight run — no curvature at all. The
   direction changes at its ends belong to the pins in the neighboring
   sections (the hero's last pin above, the spine's relay pin below).

   THERE USED TO BE THREE OF THESE AND ALL THREE MISSED. Measured under
   `reduce` at eight widths, join-end x minus spine-centre x:
     1440 +76 · 1024 +76 (wide, bottom end in mid-air)
      900 +76 ·  768 +76 (mid, BOTH ends in mid-air: −76 at the top too)
      640 −24 ·  390 −24 (narrow, bottom end in mid-air)
   The wide box was placed at `50% − 76px` against a spine at
   `50% − 152px`: half the offset, written into a code comment that
   claimed it "lands on the first timeline card's pin". The mid box
   repeated the same 76 and, being a plain vertical, missed the hero's
   exit by 76 in the other direction — it split the error rather than
   crossing the gap. The narrow box used a literal 64px measured against
   the viewport while the spine uses 64px INSIDE `.wall-max`, which
   carries 24px of inline padding. Three numbers, none of them the
   build's, and DESIGN.md quoted a fourth (48px).
   The mid box is gone: below 64rem the hero always exits at the shell's
   centre and the spine always stands to its left, so ONE diagonal
   crosses that gap at every narrow width. And the offset is no longer
   written anywhere in this file — it is `--spine-x`, declared once. */
const JOIN_WIDE = {
	width: 202,
	height: 224,
	path: "M 202 0 L 0 224"
};
const JOIN_STACK = {
	width: 200,
	height: 224,
	path: "M 200 0 L 0 224"
};
---

<Layout title={meta.title} description={meta.description} locale={locale}>
	<!-- the wall's title card: flyer poster, top right, doubling as the index;
	     the language tab hangs beside it, pinned with its own mini-pin -->
	<div class="wall-head wall-max" slot="header">
		<div class="wall-head__card">
			<PinCard variant="flyer" rotate={1}>
				<p class="wall-head__title" lang="de">Der Rote Faden</p>
				<svg class="wall-head__rule" viewBox="0 0 150 8" aria-hidden="true">
					<path
						d="M 3 6 C 40 2 70 9 146 4"
						fill="none"
						stroke="var(--thread)"
						stroke-width="2.4"
						stroke-linecap="round"></path>
				</svg>
				<nav aria-label={ui.navAria}>
					<ul role="list">
						{
							NAV.map((item) => (
								<li>
									<a href={item.href} lang={item.lang}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
			</PinCard>
		</div>
		<LangTab
			class="wall-head__tab"
			rotate={-1}
			label={ui.langSwitch.label}
			href={ui.langSwitch.href}
			hreflang={ui.langSwitch.hreflang}
			ariaLabel={ui.langSwitch.aria}
			currentLang={locale}
		/>
	</div>

	<!-- the lower run lives here: one absolutely positioned layer over the
	     whole wall, filled at runtime with one SVG per pin-to-pin leg.
	     z-index -1 inside main's stacking context = behind every sheet,
	     above the cork. -->
	<div class="wall-stitch" aria-hidden="true"></div>

	<!-- and the last stretch of every leg, lifted ABOVE the paper: see
	     `.wall-tips`. Same legs, same boxes, same draw — clipped to a ring
	     around each pin, so the thread climbs onto the sheet, wraps the
	     head and drops back behind. -->
	<div class="wall-tips" aria-hidden="true"></div>

	<Hero />

	<!-- hero board → timeline spine. The inner box exists so these
	     connectors and the timeline's spine share ONE origin: it reproduces
	     `.wall-max`'s content box, which is what `.rf-line` is positioned
	     against, so `--spine-x` means the same x in both places. -->
	<div class="stitch-join" aria-hidden="true">
		<div class="stitch-join__box">
			<div class="stitch-join__wide">
				<Thread
					path={JOIN_WIDE.path}
					width={JOIN_WIDE.width}
					height={JOIN_WIDE.height}
					draw={false}
				/>
			</div>
			<div class="stitch-join__stack">
				<Thread
					path={JOIN_STACK.path}
					width={JOIN_STACK.width}
					height={JOIN_STACK.height}
					draw={false}
				/>
			</div>
		</div>
	</div>

	<Timeline />

	<!-- past HEUTE the thread keeps running pin to pin behind the paper.
	     Each act now opens on a band of bare cork with nothing on it but
	     the thread crossing — the rest between dense zones, and the only
	     emptiness on this wall that is allowed to read as emptiness. -->
	<div class="wall-run">
		<div class="act-break" aria-hidden="true"></div>
		<Projects />
		<div class="act-break" aria-hidden="true"></div>
		<Telemetry />
		<div class="act-break" aria-hidden="true"></div>
		<Practice />
	</div>

	<div class="act-break act-break--final" aria-hidden="true"></div>

	<Contact />

	<!-- the wall's only persistent chrome: the thread itself, with the
	     brass pin riding it at scroll progress and the five sections as
	     ticks. Signage made of the wall's own material. -->
	<nav class="rail" id="rail" aria-label={ui.navAria} data-visible="false">
		<span class="rail__line" aria-hidden="true"></span>
		<ul class="rail__ticks" role="list">
			{
				NAV.map((item) => (
					<li>
						<a class="rail__tick" href={item.href} data-tick>
							<span class="rail__label" lang={item.lang}>
								{item.label}
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<button class="rail__pin" type="button" id="to-top-pin" aria-label={ui.backToTop}>
			<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path
					d="M4 12.5 L10 6.5 L16 12.5"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>
	</nav>

	<!-- the contact section signs the wall (© stamp); keep the footer quiet -->
	<Fragment slot="footer" />
</Layout>

<style is:global>
	/* anchor targets breathe below the viewport edge when navigated to */
	#werdegang,
	#projects,
	#telemetry,
	#practice,
	#contact {
		scroll-margin-top: calc(var(--baseline) * 4);
	}

	#werdegang {
		scroll-margin-top: calc(var(--baseline) * 6);
	}

	/* ---- ONE SPINE, ONE NUMBER ------------------------------------- */
	/* Where the thread stands when it is running straight down the wall.
	   Consumed by `.rf-line` (the timeline's entry line), the timeline's
	   own card-to-card stitches, and both hero→timeline connectors — so
	   the seam between two sections cannot drift again by editing one of
	   them. Every consumer positions against a box whose left edge is
	   `.wall-max`'s CONTENT edge (`.rf-head`, `.rf-row`, and the
	   `.stitch-join__box` built for exactly this reason), which is what
	   makes one declaration legal in all of them.
	   ≥48rem the spine is 152px left of the shell's centre — the pin
	   column of the timeline's LEFT cards. Below that the wall is one
	   column and every pin stands 64px in from the wall's text edge.
	   Mirror value: the timeline's RIGHT card column. */

	:root {
		--spine-x: 64px;
		--spine-x-r: 64px;
		/* the thread's own weight — 4px on a 1,425px plane is 0.28 % of
		   width, where real red twine on a 1m board is 0.3–0.4 %. At 2.5px
		   (0.18 %) the wall's central metaphor was a hairline. */
		--thread-w: 4px;
	}

	@media (min-width: 48rem) {
		:root {
			--spine-x: calc(50% - 152px);
			--spine-x-r: calc(50% + 152px);
		}
	}

	/* ---- the lower run: one measured layer ------------------------ */
	/* main already isolates (wall.css) so that z-index: -1 paints above
	   the cork and below the paper; it needs to be a containing block
	   too, so the layer can span exactly the wall and nothing else. */

	main {
		position: relative;
	}

	/* THE THREAD'S WEIGHT, DECLARED ONCE, FOR EVERY THREAD ON THE WALL.
	   It was 2.5px: 0.18 % of a 1,425px plane, where real red twine on a
	   1m board is 0.3–0.4 %. Every `.thread-path` reads the token — the
	   hero's two runs, this connector, the timeline's card-to-card
	   stitches and the 26 runtime legs — so the wall cannot end up with
	   two thread weights in one frame. It is set in CSS rather than on
	   each <path>, because a custom property inside an SVG PRESENTATION
	   attribute is the one place `var()` is not reliably resolved, and the
	   failure mode there is a 1px hairline. */
	.thread-path {
		stroke-width: var(--thread-w);
	}

	.wall-stitch {
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}

	/* THE TIPS LAYER — the thread's only licence to be on top of paper.
	   Behind every sheet without exception, 63 % of the lower run never
	   reached the eye (measured: 8,352px of 13,309px hidden at 1440), and
	   at every pin the thread simply stopped at the card's edge: 25 brass
	   pins joined to nothing. Lifting the whole layer is not the fix —
	   37 of 68 cards have thread crossing their interior, some diagonally
	   over body copy.
	   So only the LAST STRETCH is lifted, and only in a ring around the
	   pin it is arriving at: same leg, same box, same 1:1 viewBox, same
	   draw timing, clipped to an annulus of r 34px with the 8px pin head
	   punched out of the middle. The thread climbs onto the sheet, runs
	   under the head that is holding it, and drops back behind the paper.
	   That is what a wrapped pin looks like, and it is the only reading
	   under which a thread that vanishes at a card edge is not a cut. */
	.wall-tips {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
	}

	/* Each leg is an HTML box sized in the pixels it was measured in,
	   holding an SVG whose viewBox is in PAGE coordinates — so the
	   mapping is exactly 1:1 and the native dash draw is safe here
	   (unlike the stretched section joins, which must clip-wipe). */
	.wall-stitch .ws-leg,
	.wall-stitch .ws-knot,
	.wall-tips .ws-leg {
		position: absolute;
	}

	.wall-stitch svg,
	.wall-tips svg {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* the loose end hangs along the thread: authored entry-at-top, then
	   rotated about that entry so the cut node lands on the mailto pin */
	.wall-stitch .ws-knot {
		transform-origin: 80px 0;
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			/* THE TIMELINE MUST HANG ON THE HTML BOX, NOT ON THE PATH.
			   Chromium resolves `animation-timeline: view()` for an SVG
			   child against the element's position in the SVG's own
			   coordinate system and ignores where the <svg> sits in the
			   document — measured here: a leg at document y 4,326 reported
			   its view progress as 122 % while the viewport was at y 400,
			   because its path box starts 8 units down its own viewBox.
			   Naming the timeline on the wrapper and referencing it from
			   the path fixes the subject without giving up the dash draw. */
			.wall-stitch .ws-leg,
			.wall-stitch .ws-knot,
			.wall-tips .ws-leg,
			.wall-tips .ws-knot {
				view-timeline-name: --ws;
				view-timeline-axis: block;
			}

			/* THE THREAD HAS TO POINT FORWARD, AND THIS IS THE WHOLE OF IT.
			   The old rule computed a `cover` range per leg from the leg's
			   own height and a lead of 0.45, which finishes a leg when its
			   destination pin stands at 55 % of the viewport. Measured
			   consequence at eleven scroll offsets: the lowest drawn ink sat
			   at a mean of 69.6 % of viewport height at 1440 and 68.4 % at
			   390, and NEVER below 80.3 % — the bottom fifth of every screen
			   had no thread in it, ever. The drawing tip was behind a card
			   at 8 of 11 offsets. A reader does not read that as "not yet
			   drawn"; they read it as "this thread ends here", on a wall
			   whose one idea is that it doesn't.
			   `entry` is the range from the leg's top edge touching the
			   viewport's bottom edge to the leg being contained by it, and
			   its length is min(legHeight, viewportHeight). Finish at 85 %
			   of it and the arithmetic guarantees what the old constant only
			   approximated: at scroll travel s past the leg's appearance the
			   drawn fraction is s/(0.85·min(h,vh)) and the leg's top sits at
			   vh − s, so the tip is at vh + s·(h/(0.85·min(h,vh)) − 1) —
			   never above the fold, for any leg height, at any viewport
			   height. The reveal itself is untouched: what changed is where
			   its edge is, not that it has one.
			   It also drops the last consumer of `window.innerHeight` from
			   the builder below, so the layer stops re-solving every time a
			   mobile URL bar slides. */
			.wall-stitch .thread-path--draw,
			.wall-tips .thread-path--draw {
				animation-timeline: --ws;
				animation-range: entry 0% entry 85%;
			}
		}
	}

	/* the layout's fixed back-to-top pin is re-staged as the rail below.
	   Addressed by id: the layout's own rule is scoped, so a bare class
	   selector loses the specificity contest and the pin stays on screen
	   twice. */
	#to-top {
		display: none;
	}
</style>

<style>
	/* ---- title card + index -------------------------------------- */

	.wall-head {
		display: flex;
		justify-content: flex-end;
		align-items: flex-start;
		flex-wrap: wrap;
		column-gap: calc(var(--baseline) * 2);
		row-gap: var(--baseline);
		padding-block-start: calc(var(--baseline) * 2);
	}

	.wall-head__card {
		width: fit-content;
		max-width: 100%;
	}

	/* the language tab: pinned beside the title card, dropped a step so
	   it reads as its own chit; wraps under the card when the wall is
	   too narrow for the pair — still inside the first viewport */
	.wall-head :global(.wall-head__tab) {
		margin-block-start: var(--baseline);
		/* Typed paper, so it is typed at the TYPED SETTING — the same
		   step the record card below it is struck at. The tab used to run
		   at 0.875rem / 0.04em: a third Courier size and a third Courier
		   tracking in one viewport, on a chit sitting inches from the
		   title, which made a language switcher look like its own
		   typeface. Worse, 0.875rem put it dead level with every
		   handwritten note on the wall.

		   It costs no room: Courier's advance is 0.6em, so the size step
		   adds 0.6px per character and the tracking removal gives back
		   0.56px — the tab is measured 0.5px wider. The control's own
		   signals are untouched (inert language soft and light, the
		   destination bold in thread red under the house link underline,
		   the inked exchange arrow between them); only the face's setting
		   joins the system. */
		font-size: var(--step-0);
		letter-spacing: normal;
	}

	/* THE NAME-PLATE, NOT THE HEADLINE. This sat at clamp(2rem, 4vw,
	   2.75rem) — 44px, the largest type in the first viewport, larger
	   than the signature and larger than the claim. It names the LAYOUT
	   METAPHOR, not the offer: a wall's title card is a name-plate, and a
	   name-plate that outranks everything pinned to the wall tells the
	   reader the filing system is the subject. Demoted to --step-2 it
	   still opens the sheet and still carries the index under it, and the
	   top of the ladder is freed for the man's own signature. */
	.wall-head__title {
		margin: 0;
		font-size: var(--step-2);
		line-height: var(--lh-2);
	}

	.wall-head__rule {
		display: block;
		width: 8.5rem;
		margin-block: calc(var(--baseline) * 0.75) var(--baseline);
	}

	.wall-head nav ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		column-gap: calc(var(--baseline) * 3);
	}

	/* The index, in the flyer's own press at the flyer's own tracking.
	   THIS RULE SETS NO LETTER-SPACING, and that absence is the fix. The
	   sheet declares its tracking once — `.pin-card--flyer` — and it
	   inherits down to every line on the sheet, the title included. This
	   row used to override it at 0.045em, which opened a gap 6.2× the
	   headline's own out of one League Gothic sheet. A reader has no name
	   for that, so they read it as a second face. Now nothing on the
	   sheet overrides the sheet. */
	.wall-head nav a {
		display: inline-block;
		padding-block: calc(var(--baseline) * 1.5);
		font-size: var(--step-1);
		line-height: var(--lh-1);
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-decoration-color: color-mix(in oklab, var(--ink) 30%, transparent);
		text-underline-offset: 4px;
	}

	.wall-head nav a:hover {
		text-decoration-color: var(--thread);
		text-decoration-thickness: 2.5px;
	}

	@media (max-width: 63.9375rem) {
		.wall-head {
			justify-content: center;
		}
	}

	/* ---- hero board → timeline spine ------------------------------ */
	/* Pulled up by the hero's bottom padding (baseline × 10) so the top
	   edge sits exactly on the hero board's bottom edge, where its
	   thread ends. Shares the hero board's shell (78rem, centered) so
	   viewBox fractions and board fractions coincide. */

	.stitch-join {
		width: 100%;
		max-width: 78rem;
		height: 224px;
		margin-top: calc(var(--baseline) * -10);
		margin-inline: auto;
		/* the same inline padding `.wall-max` carries, so the box below
		   reproduces the wall's content box exactly */
		padding-inline: calc(var(--baseline) * 3);
		pointer-events: none;
		/* behind the paper: the taut connector overlaps the hero's bottom
		   edge, and the thread never crosses printed ink */
		z-index: -1;
		position: relative;
	}

	/* THE COORDINATE FRAME, AND IT IS LOAD-BEARING. An absolutely
	   positioned child resolves its offsets against its containing
	   block's PADDING box, so padding on `.stitch-join` alone would not
	   move anything: the frame has to be an element. This one's padding
	   box IS `.wall-max`'s content box — the same box `.rf-line` and the
	   timeline's card stitches are positioned in — which is the whole
	   reason a single `--spine-x` can be read in both files and mean the
	   same pixel. */
	.stitch-join__box {
		position: relative;
		height: 100%;
	}

	.stitch-join__box > div {
		position: absolute;
		top: 0;
		height: 100%;
	}

	.stitch-join :global(svg) {
		width: 100%;
		height: 100%;
	}

	/* ≥64rem: the wall's board is wide, the hero exits at 802/1200 of it
	   and the spine stands at `--spine-x`. The hero's thread spans the
	   board's PADDING box (`inset: 0` on `.hero__board`), so its exit
	   fraction has to be re-expressed in this frame's content box:
	   exit = 0.6683·(W + 48) − 24 = 0.6683·W + 8.08, hence a right offset
	   of (1 − 0.6683)·W − 8.08. The 48 and the 24 are `.wall-max`'s own
	   padding; the 802/1200 is Hero.astro's last station. Both ends of
	   this box are therefore quoted from the contracts they meet, and
	   neither is a number chosen here. */
	.stitch-join__wide {
		display: none;
		left: var(--spine-x);
		right: calc(33.16667% - 8.08px);
	}

	/* <64rem: the hero stacks and exits at the shell's centre, the spine
	   stands to its left — one diagonal, at both narrow widths. */
	.stitch-join__stack {
		left: var(--spine-x);
		right: 50%;
	}

	@media (min-width: 64rem) {
		.stitch-join__stack {
			display: none;
		}

		.stitch-join__wide {
			display: block;
		}
	}

	/* stretched boxes: disable the dash (Chromium dash-normalization bug
	   under non-scaling-stroke) and wipe-reveal instead */
	.stitch-join__wide :global(.thread-path),
	.stitch-join__stack :global(.thread-path) {
		stroke-dasharray: none;
	}

	/* PACING — the hero is the establishing shot, not a scroll beat.
	   Scroll-linking this thread was wrong in both directions. Linked to
	   cover 0 % it was 88 % drawn before the visitor moved, so it led
	   nowhere; pushed out to cover 35 % it left the FIRST VIEWPORT — the
	   one image that decides what this site is — with barely a quarter of
	   its own concept visible, and every static capture of the fold shows
	   that quarter. The hero's six pins are all on screen at once, so
	   there is nothing here to lead anyone toward: the leading is done by
	   the 25 legs below, which are scroll-drawn and arrive just ahead of
	   the reader.
	   So the hero draws itself ONCE, on arrival, in its own time — a
	   signature being written rather than a diagram being revealed — and
	   is complete and legible a second later, in the browser and in any
	   screenshot alike. */
	/* Gated exactly like every other motion on this wall: the fully-drawn
	   thread stays the CSS default, and this only rewinds it for a visitor
	   who welcomes motion. */
	@media (prefers-reduced-motion: no-preference) {
		:global(.hero__thread .thread-path--draw) {
			animation: thread-draw 1100ms cubic-bezier(0.215, 0.61, 0.355, 1) 120ms both;
			animation-timeline: initial;
			animation-range: normal;
		}
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			/* the same reveal law as the lower run and the timeline's own
			   entry line — `entry 0% entry 85%`, so this seam is also drawn
			   BELOW the fold rather than finishing at 55 % of the screen
			   like the old `cover 38% cover 56%` did. Three mechanisms
			   (clip wipe, scale, dash) now share one calibration. */
			.stitch-join__wide,
			.stitch-join__stack {
				clip-path: inset(0 0 100% 0);
				animation: stitch-wipe linear both;
				animation-timeline: view();
				animation-range: entry 0% entry 85%;
			}
		}
	}

	@keyframes stitch-wipe {
		to {
			clip-path: inset(-8px);
		}
	}

	/* ---- the long run --------------------------------------------- */
	/* No line of its own any more: the run is the `.wall-stitch` layer,
	   measured from the pins. `.wall-run` stays as the acts' container
	   and keeps its own stacking context so nothing inside it can slip
	   below the thread. */

	.wall-run {
		position: relative;
		isolation: isolate;
	}

	/* ---- act breaks ------------------------------------------------ */
	/* Hero → Timeline always had a designed scene change (`.stitch-join`,
	   224px). Timeline → Projects, Projects → Telemetry and Telemetry →
	   Practice had none: seven unbroken screens at 46–54 % ink coverage
	   with no rest anywhere in them. This is that scene change, three
	   more times: a band of bare cork with the thread visibly crossing it
	   and nothing else on it. It is the only place on this wall allowed
	   to be empty, which is what makes the emptiness read as design. */

	.act-break {
		height: calc(var(--baseline) * 16);
		pointer-events: none;
	}

	@media (min-width: 48rem) {
		.act-break {
			height: calc(var(--baseline) * 25);
		}
	}

	/* ---- the progress rail ----------------------------------------- */
	/* Navigation used to exist for 1.6 % of the page: the index at
	   y 88–177 and then nothing but a 44px back-to-top pin for 11,000px.
	   The rail is the same pin, in the same corner, hung on the thread:
	   its offset IS scroll progress, and the five section offsets are
	   ticks you can click. The page's only permanent UI is now made of
	   the page's own idea. */

	.rail {
		--rail-line: 38px;
		--rail-h: 180px;
		position: fixed;
		right: calc(var(--baseline) * 2);
		bottom: calc(var(--baseline) * 3);
		z-index: 50;
		width: 52px;
		height: var(--rail-h);
		pointer-events: none;
		visibility: hidden;
		opacity: 0;
		transition: visibility 0s var(--t-settle);
	}

	.rail[data-visible="true"] {
		visibility: visible;
		opacity: 1;
		transition: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.rail {
			transition:
				opacity var(--t-settle) var(--e-out),
				visibility 0s var(--t-settle);
		}

		.rail[data-visible="true"] {
			transition: opacity var(--t-settle) var(--e-out);
		}
	}

	/* NOT `--thread-w`, and deliberately. The wall's thread went to 4px
	   because 2.5 was a hairline at 1:1; this line is the same thread at
	   68:1 — 12,173px of page compressed into 180px — and at that
	   reduction the wall's own weight reads as a bar rather than as a
	   thread. The rail is a scale drawing, so it keeps the scale's stroke.
	   Its ticks are sized against this line, not against the token. */
	.rail__line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: calc(var(--rail-line) - 1.25px);
		width: 2.5px;
		border-radius: 2px;
		background: var(--thread);
	}

	.rail__ticks {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* 24×24 target, 10px of visible mark crossing the thread */
	.rail__tick {
		position: absolute;
		top: calc(var(--at, 0) * 100%);
		left: calc(var(--rail-line) - 24px);
		width: 24px;
		height: 24px;
		margin-top: -12px;
		pointer-events: auto;
		display: grid;
		place-items: center end;
		padding-right: 3px;
	}

	.rail__tick::after {
		content: "";
		display: block;
		width: 10px;
		height: 2.5px;
		border-radius: 2px;
		background: color-mix(in oklab, var(--thread) 55%, transparent);
	}

	/* scale, not width: the current tick changes on every scroll frame
	   that crosses a section boundary, and a width change re-lays out */
	.rail__tick:hover::after,
	.rail__tick[aria-current="true"]::after {
		scale: 1.4 1;
		background: var(--thread);
	}

	.rail__label {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* the brass pin, riding the thread at scroll progress. Moved with
	   `translate`, not `top`: a fixed element that re-lays out on every
	   scroll frame files a layout-shift entry each time, and this page
	   is holding a 0.03 CLS. */
	.rail__pin {
		position: absolute;
		top: 0;
		translate: 0 calc(var(--progress, 0) * (var(--rail-h) - 28px));
		left: calc(var(--rail-line) - 14px);
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		border-radius: 50%;
		cursor: pointer;
		pointer-events: auto;
		display: grid;
		place-items: center;
		color: var(--ink);
		background: radial-gradient(
			circle at 35% 30%,
			color-mix(in oklab, var(--brass) 40%, white),
			var(--brass) 58%,
			color-mix(in oklab, var(--brass) 55%, black)
		);
		box-shadow:
			2px 2px 4px oklch(var(--shade) / 0.34),
			inset 0 0 0 1px oklch(var(--shade) / 0.2);
	}

	.rail__pin svg {
		width: 15px;
		height: 15px;
	}

	/* the press-in law: nothing lifts, nothing glows — the cast shrinks */
	.rail__pin:hover {
		box-shadow:
			1px 1px 3px oklch(var(--shade) / 0.34),
			inset 0 0 0 1px oklch(var(--shade) / 0.2);
	}

	.rail__pin:active {
		box-shadow:
			0 0 2px oklch(var(--shade) / 0.34),
			inset 0 0 0 1px oklch(var(--shade) / 0.2);
	}

	/* narrow walls have no margin to hang a rail in: the pin keeps its
	   old corner and its old 44px target, the thread and ticks stand down */
	@media (max-width: 63.9375rem) {
		.rail {
			--rail-line: 30px;
			--rail-h: 44px;
			width: 44px;
			right: calc(var(--baseline) * 3);
		}

		.rail__line,
		.rail__ticks {
			display: none;
		}

		.rail__pin {
			top: 0;
			left: 0;
			translate: none;
			width: 44px;
			height: 44px;
		}

		.rail__pin svg {
			width: 20px;
			height: 20px;
		}
	}
</style>

<script>
	import { solveKnot, tautLegs, type Pt } from "./wall/taut";

	/* ------------------------------------------------------------------
	   THE LOWER RUN, MEASURED FROM THE PINS
	   ------------------------------------------------------------------
	   The route is not a hand-written list of cards — a hand-written list
	   is how the old rule got away with touching one pin in nineteen, and
	   it rots the moment a section is re-laid. Every brass pin the wall
	   actually lays out between the timeline's last pin and the address
	   IS a waypoint. The order is measured: bands of pins standing at the
	   same height, bands taken top to bottom, and inside a band the order
	   the author wrote them in. That survives any regrid.
	------------------------------------------------------------------- */

	/** the lower run, swept in one pass so a section renaming itself
	    cannot drop its pins off the thread; the ids are the fallback */
	const RUN = ".wall-run";
	const ACTS = ["#projects", "#telemetry", "#practice"];

	/** two pins within this many px of each other stand in the same row */
	const ROW_BAND = 96;

	/* the loose end, authored entry-at-top: entry (80,0), cut node
	   (124,112). Placed by solveKnot so the cut lands on the mailto pin
	   and the entry continues the leg arriving from the ink key. */
	const KNOT = {
		w: 160,
		h: 128,
		tail: [44, 112] as Pt,
		d: "M 80 0 L 80 34 C 80 44 76 50 79 58 C 99 64 104 86 84 90 C 66 93.5 58 76 76 66 C 94 76 110 94 123 111"
	};

	/* a leg may not double back on the reading order, and two pins closer
	   than one pin head apart are one waypoint */
	const BACKTRACK = 140;
	const MIN_STEP = 24;
	const PAD = 8;

	/* the ring of thread lifted above the paper at each pin, and the pin
	   head punched out of the middle of it (7px radius + a hair) */
	const TIP_R = 34;
	const HEAD_R = 8;

	const layer = document.querySelector<HTMLElement>(".wall-stitch");
	const tips = document.querySelector<HTMLElement>(".wall-tips");
	const wall = document.getElementById("main");

	const centre = (el: Element): Pt => {
		const r = el.getBoundingClientRect();
		return [r.left + window.scrollX + r.width / 2, r.top + window.scrollY + r.height / 2];
	};

	/** a pin that is not laid out is not on the wall — never route to it */
	const shown = (el: Element) => {
		const r = el.getBoundingClientRect();
		return r.width > 0 && r.height > 0;
	};

	const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));

	/** the address pin: the run's terminus, wherever Contact puts it */
	const terminus = (): Element | null => {
		const c = document.getElementById("contact");
		if (!c) return null;
		const mail = c.querySelector('a[href^="mailto:"]');
		const holder = mail?.closest(".pinned") ?? mail?.parentElement ?? null;
		return [
			c.querySelector(".pin-btn__pin"),
			holder?.querySelector(".brass-pin") ?? null,
			c.querySelector(".brass-pin")
		].find((el): el is Element => el !== null && shown(el)) ?? null;
	};

	const waypoints = (): Pt[] => {
		const pts: Pt[] = [];
		const push = (p: Pt) => {
			const prev = pts[pts.length - 1];
			if (prev) {
				if (p[1] < prev[1] - BACKTRACK) return;
				if (Math.hypot(p[0] - prev[0], p[1] - prev[1]) < MIN_STEP) return;
			}
			pts.push(p);
		};

		/* hand-over: the timeline's own last pin, so the junction the wall
		   never covered with a pin head does not exist any more */
		const spine = [...document.querySelectorAll(".rf-timeline .brass-pin")].filter(shown);
		const lastSpine = spine[spine.length - 1];
		if (lastSpine) push(centre(lastSpine));

		/* Down the board first, source order second. Pure source order
		   zig-zags backwards wherever a grid stacks two artifacts in one
		   column; pure geometry throws away the order the author wrote.
		   So: bands of pins standing at the same height, bands ordered top
		   to bottom, and inside a band the author's own sequence stands. */
		const sweep = (root: Element) => {
			const pins = [...root.querySelectorAll(".brass-pin")]
				.filter(shown)
				.map((el, i) => ({ p: centre(el), i }))
				.sort((a, b) => a.p[1] - b.p[1]);
			for (let i = 0; i < pins.length; ) {
				let j = i + 1;
				while (j < pins.length && pins[j]!.p[1] - pins[i]!.p[1] <= ROW_BAND) j++;
				for (const entry of pins.slice(i, j).sort((a, b) => a.i - b.i)) push(entry.p);
				i = j;
			}
		};

		const run = document.querySelector(RUN);
		if (run && run.querySelectorAll(".brass-pin").length > 1) sweep(run);
		else
			for (const act of ACTS) {
				const root = document.querySelector(act);
				if (root) sweep(root);
			}
		return pts;
	};

	let signature = "";

	const build = () => {
		if (!layer || !tips || !wall) return;
		const base = layer.getBoundingClientRect();
		const ox = base.left + window.scrollX;
		const oy = base.top + window.scrollY;

		const pts = waypoints();
		const end = terminus();
		if (pts.length < 2 || !end) {
			layer.replaceChildren();
			tips.replaceChildren();
			signature = "";
			return;
		}

		const pin = centre(end);
		const knot = solveKnot(pts[pts.length - 1]!, pin, KNOT.tail);
		pts.push(knot.entry);

		/* the viewport's HEIGHT is deliberately not in this signature. It
		   used to be, because the reveal range was computed from it; the
		   range is now `entry 0% entry 85%` and needs no measurement, so a
		   mobile URL bar sliding up and down no longer rebuilds 26 SVGs. */
		const sig = pts.map((p) => `${Math.round(p[0])},${Math.round(p[1])}`).join(";");
		if (sig === signature) return;
		signature = sig;

		const legs = tautLegs(pts);
		const svg: string[] = [];
		const tip: string[] = [];

		const stroke = (d: string) =>
			`<path class="thread-path thread-path--draw" d="${d}" pathLength="1" vector-effect="non-scaling-stroke" stroke="var(--thread)" stroke-linecap="round"/>`;

		/* an annulus, as one evenodd subpath pair: outer ring minus the pin
		   head. Two of them per leg — one at each end — as separate <path>
		   children, because a clipPath UNIONS its children while `evenodd`
		   only ever applies within one of them: two rings that happen to
		   overlap therefore merge, instead of punching each other out. */
		const ring = (c: Pt, r: number) =>
			`M ${c[0] - r} ${c[1]} a ${r} ${r} 0 1 0 ${r * 2} 0 a ${r} ${r} 0 1 0 ${-r * 2} 0`;
		const annulus = (c: Pt) =>
			`<path clip-rule="evenodd" d="${ring(c, TIP_R)} ${ring(c, HEAD_R)}"/>`;

		legs.forEach((leg, i) => {
			const x = leg.x - PAD;
			const y = leg.y - PAD;
			const w = leg.w + PAD * 2;
			const h = leg.h + PAD * 2;
			const box = `left:${x - ox}px;top:${y - oy}px;width:${w}px;height:${h}px`;
			const view = `viewBox="${x} ${y} ${w} ${h}" preserveAspectRatio="none"`;
			svg.push(
				`<div class="ws-leg" style="${box}">` +
					`<svg ${view} fill="none" aria-hidden="true">${stroke(leg.d)}</svg>` +
					`</div>`
			);
			const id = `ws-tip-${i}`;
			/* the run's last vertex is the KNOT's entry, not a pin — there
			   is no head there to wrap, and the knot is already on bare
			   cork, so that end keeps its place behind the paper */
			const ends = i === legs.length - 1 ? [pts[i]!] : [pts[i]!, pts[i + 1]!];
			tip.push(
				`<div class="ws-leg" style="${box}">` +
					`<svg ${view} fill="none" aria-hidden="true">` +
					`<clipPath id="${id}" clipPathUnits="userSpaceOnUse">${ends.map(annulus).join("")}</clipPath>` +
					`<g clip-path="url(#${id})">${stroke(leg.d)}</g>` +
					`</svg></div>`
			);
		});

		svg.push(
			`<div class="ws-knot" style="left:${knot.entry[0] - 80 - ox}px;top:${knot.entry[1] - oy}px;width:${KNOT.w}px;height:${KNOT.h}px;rotate:${Math.round(knot.angle * 100) / 100}deg">` +
				`<svg viewBox="0 0 ${KNOT.w} ${KNOT.h}" fill="none" aria-hidden="true">${stroke(KNOT.d)}<circle cx="124" cy="112" r="3.5" fill="var(--thread)"/></svg>` +
				`</div>`
		);

		layer.innerHTML = svg.join("");
		tips.innerHTML = tip.join("");
	};

	let queued = 0;
	const schedule = () => {
		if (queued) return;
		queued = requestAnimationFrame(() => {
			queued = 0;
			build();
		});
	};

	if (layer && tips && wall) {
		build();
		new ResizeObserver(schedule).observe(wall);
		window.addEventListener("resize", schedule);
		window.addEventListener("load", schedule);
		document.fonts?.ready.then(schedule).catch(() => {});
	}

	/* ------------------------------------------------------------------
	   THE RAIL
	------------------------------------------------------------------- */

	const rail = document.getElementById("rail");

	if (rail) {
		const ticks = [...rail.querySelectorAll<HTMLAnchorElement>("[data-tick]")];

		const scrollable = () =>
			Math.max(1, document.documentElement.scrollHeight - window.innerHeight);

		const placeTicks = () => {
			const max = scrollable();
			for (const tick of ticks) {
				const id = decodeURIComponent((tick.getAttribute("href") ?? "#").slice(1));
				const target = id ? document.getElementById(id) : null;
				if (!target) {
					tick.hidden = true;
					continue;
				}
				tick.hidden = false;
				const top = target.getBoundingClientRect().top + window.scrollY;
				tick.style.setProperty("--at", String(clamp(top / max, 0, 1)));
			}
		};

		const placePin = () => {
			const p = clamp(window.scrollY / scrollable(), 0, 1);
			rail.style.setProperty("--progress", String(p));
			rail.dataset.visible = String(window.scrollY > 480);

			let current: HTMLAnchorElement | null = null;
			for (const tick of ticks) {
				if (tick.hidden) continue;
				const at = Number(tick.style.getPropertyValue("--at") || 0);
				if (at <= p + 0.001) current = tick;
			}
			for (const tick of ticks) {
				if (tick === current) tick.setAttribute("aria-current", "true");
				else tick.removeAttribute("aria-current");
			}
		};

		placeTicks();
		placePin();
		window.addEventListener("scroll", placePin, { passive: true });
		window.addEventListener(
			"resize",
			() => {
				placeTicks();
				placePin();
			},
			{ passive: true }
		);
		new ResizeObserver(() => {
			placeTicks();
			placePin();
		}).observe(document.documentElement);
	}

	/* ------------------------------------------------------------------
	   JUMP DISTANCE DECIDES THE BEHAVIOUR
	   ------------------------------------------------------------------
	   `html { scroll-behavior: smooth }` sent a nav click to #contact
	   10,554px in 1,491ms — 7,078 px/s, about 7.9 viewport heights per
	   second. That is past the one-second flow-of-thought limit AND it is
	   full-field optic flow at exactly the rate the reduced-motion
	   literature names as a vestibular trigger. Short hops keep their
	   continuity; anything past two screens becomes an honest cut.
	------------------------------------------------------------------- */

	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

	const jump = (top: number) => {
		const far = Math.abs(top - window.scrollY) > 2 * window.innerHeight;
		window.scrollTo({ top, behavior: far || reduce.matches ? "instant" : "smooth" });
	};

	document.addEventListener("click", (event) => {
		if (event.defaultPrevented || event.button !== 0) return;
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		const from = event.target;
		const link =
			from instanceof Element ? from.closest<HTMLAnchorElement>('a[href^="#"]') : null;
		if (!link) return;
		const href = link.getAttribute("href") ?? "";
		if (href.length < 2) return;
		const target = document.getElementById(decodeURIComponent(href.slice(1)));
		if (!target) return;

		event.preventDefault();
		const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
		jump(target.getBoundingClientRect().top + window.scrollY - margin);
		history.pushState(null, "", href);
		if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
		target.focus({ preventScroll: true });
	});

	window.addEventListener("popstate", () => {
		const id = decodeURIComponent(location.hash.slice(1));
		const target = id ? document.getElementById(id) : null;
		if (!target) {
			window.scrollTo({ top: 0, behavior: "instant" });
			return;
		}
		const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
		window.scrollTo({
			top: target.getBoundingClientRect().top + window.scrollY - margin,
			behavior: "instant"
		});
	});

	document.getElementById("to-top-pin")?.addEventListener("click", () => jump(0));
</script>
