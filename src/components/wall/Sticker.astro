---
/**
 * Sticker — a small piece of Ayako artwork stuck to the cork.
 *
 * The wall's own artefacts are paper; these are the things a person
 * actually sticks between them — a die-cut sticker of the character the
 * owner has drawn, published and shipped for six years. They are
 * decoration in the honest sense: they carry no claim, sit in the cork
 * gaps rather than over any sheet, and never occupy a slot where
 * evidence belongs.
 *
 * Material rules: no paper frame (a sticker has none), no pin (it is
 * stuck, not pinned), a slightly stronger tilt than the sheets, and the
 * same soft contact shadow so it belongs to the same light. Decorative
 * by definition — always aria-hidden.
 *
 * Artwork: github.com/ayakobot/Website-CDN (the owner's own repository),
 * trimmed to its ink and re-encoded at sticker scale.
 */
export type StickerName = "note" | "peek" | "wave" | "sip" | "love" | "pixel";

interface Props {
	name: StickerName;
	/** rendered width in rem; keep small — these are marginalia */
	size?: number;
	/** free rotation in degrees; stickers are pressed on by hand */
	rotate?: number;
	class?: string;
}

const { name, size = 4, rotate = -6, class: className } = Astro.props;
---

<img
	class:list={["sticker", className]}
	style={`--sticker-size:${size}rem; --sticker-rot:${rotate}deg;`}
	src={`/ayako/${name}.webp`}
	alt=""
	aria-hidden="true"
	width="160"
	height="160"
	loading="lazy"
	decoding="async"
/>

<style>
	.sticker {
		display: block;
		width: var(--sticker-size);
		height: auto;
		rotate: var(--sticker-rot);
		/* Stuck to the cork: a tight contact shadow, no paper, no pin.
		   Vinyl is the flattest thing on the wall, so it gets the shortest
		   throw of anything here — but it still falls down-and-right with
		   the same lamp as every sheet. */
		filter: drop-shadow(1px 1.5px 2px oklch(var(--shade) / 0.3));
		user-select: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		.sticker {
			transition:
				rotate 200ms cubic-bezier(0.215, 0.61, 0.355, 1),
				scale 200ms cubic-bezier(0.215, 0.61, 0.355, 1);
		}

		/* The one place on the wall permitted to be purely charming. A
		   sticker has no shadow to grow, so a slight peel toward level is
		   the only lift the "nothing lifts" law allows — and these live in
		   the cork margins where they cannot compete with evidence.
		   (This transition was declared before but could never fire:
		   pointer-events was none and the element rotates via
		   --sticker-rot, which .pinned:hover never touches.) */
		.sticker:hover {
			rotate: calc(var(--sticker-rot) * 0.35);
			scale: 1.04;
		}
	}
</style>
