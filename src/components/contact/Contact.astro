---
import { Icon } from "astro-icon/components";
---

<div id="contact" class="w-full max-w-4xl mx-auto mt-8 px-4">
 <div
  class="bg-secondary/30 backdrop-blur-md rounded-xl p-6 border border-accent/20 hover:border-accent/40 transition-all duration-300 shadow-lg"
 >
  <h2 class="text-2xl font-bold mb-4 text-accent">Let's Connect</h2>
  <p class="mb-6 text-text/90">
   Interested in working together? Reach out through any of the channels below.
  </p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
   <a
    href="mailto:jobs@lars-dev.org"
    class="no-hover-effect group flex flex-col items-center p-4 bg-background/30 rounded-lg hover:bg-background/50 transition-all duration-300"
   >
    <div
     class="w-12 h-12 flex items-center justify-center bg-accent/20 rounded-full mb-3 group-hover:scale-110 transition-transform duration-300"
    >
     <Icon name="tabler:mail" class="w-10 h-10 color-accent" />
    </div>
    <span class="text-text font-medium">Email</span>
   </a>

   <a
    href="https://github.com/Larsundso"
    target="_blank"
    rel="noopener"
    class="no-hover-effect group flex flex-col items-center p-4 bg-background/30 rounded-lg hover:bg-background/50 transition-all duration-300"
   >
    <div
     class="w-12 h-12 flex items-center justify-center bg-accent/20 rounded-full mb-3 group-hover:scale-110 transition-transform duration-300"
    >
     <Icon name="tabler:brand-github" class="w-10 h-10 color-accent" />
    </div>
    <span class="text-text font-medium">GitHub</span>
   </a>

   <a
    href="https://www.linkedin.com/in/lars-b%C3%B6se-217272351"
    target="_blank"
    rel="noopener"
    class="no-hover-effect group flex flex-col items-center p-4 bg-background/30 rounded-lg hover:bg-background/50 transition-all duration-300"
   >
    <div
     class="w-12 h-12 flex items-center justify-center bg-accent/20 rounded-full mb-3 group-hover:scale-110 transition-transform duration-300"
    >
     <Icon name="tabler:brand-linkedin" class="w-10 h-10 color-accent" />
    </div>
    <span class="text-text font-medium">LinkedIn</span>
   </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
   <a
    href="https://www.xing.com/profile/Lars_Boese"
    target="_blank"
    rel="noopener"
    class="no-hover-effect group flex flex-col items-center p-4 bg-background/30 rounded-lg hover:bg-background/50 transition-all duration-300"
   >
    <div
     class="w-12 h-12 flex items-center justify-center bg-accent/20 rounded-full mb-3 group-hover:scale-110 transition-transform duration-300"
    >
     <Icon name="tabler:brand-xing" class="w-10 h-10 color-accent" />
    </div>
    <span class="text-text font-medium">XING</span>
   </a>

   <a
    href="https://profile.indeed.com/p/larsb-2hf1h8b"
    target="_blank"
    rel="noopener"
    class="no-hover-effect group flex flex-col items-center p-4 bg-background/30 rounded-lg hover:bg-background/50 transition-all duration-300"
   >
    <div
     class="w-12 h-12 flex items-center justify-center bg-accent/20 rounded-full mb-3 group-hover:scale-110 transition-transform duration-300"
    >
     <svg
      xmlns="http://www.w3.org/2000/svg"
      width="60"
      height="85"
      viewBox="0 0 60 85"
      fill="none"
      class="w-10 h-10 text-accent"
      aria-hidden="true"
     >
      <path
       d="M29 77.5C29.0511 77.5746 29.1021 77.6481 29.1532 77.7204M29.1532 77.7204C34.1727 84.8276 39.2543 80.8507 41.3427 77.7415C41.448 77.5846 41.5 77.3997 41.5 77.2107V45.3685C41.5 44.5698 40.5993 44.0817 39.8885 44.4458C36.3882 46.2392 32.8882 46.4375 30.7463 46.2103C30.1038 46.1421 29.4932 46.6203 29.4862 47.2664L29.1532 77.7204ZM3 42.5C9.5 20.5 28.5 -11.5 56.5 12.5"
       stroke="currentColor"
       stroke-width="6"
       stroke-linecap="round"
       stroke-linejoin="round"></path>
      <circle cx="35" cy="28" r="8" stroke="currentColor" stroke-width="6"
      ></circle>
     </svg>
    </div>
    <span class="text-text font-medium">Indeed</span>
   </a>
  </div>
 </div>
</div>
