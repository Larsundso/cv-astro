---
interface Props {
 href: string;
 title: string;
}

const { href, title } = Astro.props;
---

<a
 href={href}
 target="_blank"
 class="flex flex-col items-center justify-center transition-all duration-150
 hover:scale-105 hover:light:drop-shadow-[0_0_1px_#e5530b] hover:dark:drop-shadow-[0_0_1px_#f4651c]"
>
 <slot />
 <div class="color-secondary">{title}</div>
</a>
